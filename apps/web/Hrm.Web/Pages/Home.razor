@page "/"
@inject NavigationManager Navigation
@inject BrowserSessionStore SessionStore

<PageTitle>Saigon Retail HRM</PageTitle>

<div class="d-flex align-items-center justify-content-center" style="min-height: 50vh;">
    <div class="spinner-border text-success" role="status">
        <span class="visually-hidden">Đang chuyển hướng...</span>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var session = await SessionStore.GetAsync();
        if (session is null)
        {
            Navigation.NavigateTo("employee-login", true);
            return;
        }

        var isAdmin = session.User.Roles.Any(r => r.Equals("ADMIN", StringComparison.OrdinalIgnoreCase));
        if (isAdmin)
        {
            Navigation.NavigateTo("admin/dashboard", true);
        }
        else
        {
            Navigation.NavigateTo("employee/attendance", true);
        }
    }
}

