@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = Uri.EscapeDataString(relativePath);

        if (!string.IsNullOrWhiteSpace(relativePath) && relativePath.StartsWith("admin", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo($"login?returnUrl={returnUrl}");
        }
        else
        {
            var target = string.IsNullOrWhiteSpace(relativePath) || relativePath == "/"
                ? "employee-login"
                : $"employee-login?returnUrl={returnUrl}";

            Navigation.NavigateTo(target);
        }
    }
}
