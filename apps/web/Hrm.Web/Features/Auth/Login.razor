@page "/login"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject IAuthApiClient AuthApiClient
@inject BrowserSessionStore SessionStore
@inject NavigationManager Navigation

<PageTitle>Đăng nhập</PageTitle>

<section class="login-card">
    <div class="login-card-body">
        <div class="login-mobile-brand"><span class="auth-brand-mark">SR</span><strong>Saigon Retail</strong></div>
        <span class="eyebrow text-primary">WELCOME BACK</span>
        <h1>Đăng nhập</h1>
        <p class="login-subtitle">Nhập tài khoản nội bộ để tiếp tục vào hệ thống quản trị.</p>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <EditForm Model="model" OnValidSubmit="LoginAsync" FormName="login">
            <DataAnnotationsValidator />
            <div class="mb-3 login-field">
                <label class="form-label" for="username">Tên đăng nhập</label>
                <InputText id="username" class="form-control form-control-lg" @bind-Value="model.UserName" autocomplete="username" placeholder="Ví dụ: admin" autofocus />
                <ValidationMessage For="@(() => model.UserName)" />
            </div>
            <div class="mb-4 login-field">
                <label class="form-label" for="password">Mật khẩu</label>
                <InputText id="password" type="password" class="form-control form-control-lg" @bind-Value="model.Password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                <ValidationMessage For="@(() => model.Password)" />
            </div>
            <button class="btn btn-primary btn-lg w-100 login-submit" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Đang xác thực..." : "Đăng nhập")
            </button>
        </EditForm>
        <div class="login-security-note">
            <span class="security-dot"></span>
            Phiên đăng nhập được bảo vệ bằng JWT và refresh-token rotation.
        </div>
    </div>
</section>

@code {
    private readonly LoginModel model = new();
    private string? errorMessage;
    private bool isSubmitting;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task LoginAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        try
        {
            var error = await AuthApiClient.LoginAsync(new LoginRequest(model.UserName, model.Password));
            if (error is not null)
            {
                errorMessage = error.Message;
                return;
            }

            var session = await SessionStore.GetAsync();
            var isAdmin = session?.User.Roles.Any(r => r.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) == true;
            string target;
            if (isAdmin)
            {
                target = !string.IsNullOrWhiteSpace(ReturnUrl) && !ReturnUrl.Contains("login")
                    ? ReturnUrl
                    : "admin/dashboard";
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(ReturnUrl) && !ReturnUrl.StartsWith("admin", StringComparison.OrdinalIgnoreCase) && !ReturnUrl.Contains("login"))
                {
                    target = ReturnUrl;
                }
                else
                {
                    target = "attendance";
                }
            }

            Navigation.NavigateTo(target, forceLoad: true);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Không thể kết nối API. Hãy kiểm tra backend đang chạy.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Vui lòng nhập tên đăng nhập.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        public string Password { get; set; } = string.Empty;
    }
}
