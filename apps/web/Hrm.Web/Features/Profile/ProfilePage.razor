@page "/employee/profile"
@layout EmployeeLayout
@attribute [Authorize]
@inject IAuthApiClient AuthApiClient
@inject BrowserSessionStore SessionStore

<PageTitle>Hồ sơ nhân viên toàn diện - Saigon Retail</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Hero Banner -->
    <div class="emp-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="emp-page-header-subtitle d-flex align-items-center gap-2">
                <i class="bi bi-person-lines-fill text-primary"></i>
                <span>HỒ SƠ NHÂN SỰ TOÀN DIỆN</span>
            </div>
            <h1 class="emp-page-header-title">Hồ sơ cá nhân &amp; Thông tin nhân viên</h1>
            <p class="emp-page-header-desc">Xem đầy đủ thông tin lưu trữ trong hệ thống, cập nhật thông tin liên lạc và quản lý mật khẩu.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn emp-btn-secondary" @onclick="LoadProfileAsync" title="Làm mới dữ liệu">
                <i class="bi bi-arrow-clockwise me-1"></i> Tải lại
            </button>
            <a class="btn emp-btn-primary" href="employee/attendance">
                <i class="bi bi-arrow-left me-1"></i> Về Chấm công
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(globalSuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46;">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div class="fw-medium">@globalSuccessMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => globalSuccessMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(globalErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div class="fw-medium">@globalErrorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => globalErrorMessage = null"></button>
        </div>
    }

    @if (isLoadingProfile)
    {
        <div class="card emp-card p-5 text-center my-4">
            <div class="spinner-border text-primary mx-auto mb-3" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Đang tải hồ sơ...</span>
            </div>
            <h5 class="text-secondary fw-semibold">Đang tải đầy đủ hồ sơ nhân viên...</h5>
            <p class="text-muted small">Hệ thống đang truy xuất tất cả các trường dữ liệu từ cơ sở dữ liệu.</p>
        </div>
    }
    else if (profile is null)
    {
        <div class="card emp-card p-5 text-center text-muted">
            <i class="bi bi-person-x fs-1 text-muted d-block mb-3"></i>
            <p class="mb-3 fs-5">Không tìm thấy thông tin hồ sơ nhân viên.</p>
            <button class="btn emp-btn-primary mx-auto px-4" @onclick="LoadProfileAsync">
                <i class="bi bi-arrow-clockwise me-1"></i> Thử tải lại
            </button>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cột trái: Thẻ định danh & Tóm tắt nhân sự -->
            <div class="col-12 col-xl-4">
                <div class="card emp-card text-center p-4 mb-4">
                    <div class="card-body p-2 d-flex flex-column align-items-center">
                        <div class="mb-3 d-grid place-items-center rounded-circle text-white fw-bold shadow-sm position-relative"
                             style="width: 5.5rem; height: 5.5rem; font-size: 2.2rem; background: linear-gradient(135deg, var(--emp-primary) 0%, var(--emp-primary-hover) 100%);">
                            @GetInitial(profile.FullName)
                            <span class="position-absolute bottom-0 end-0 p-2 bg-success border border-white rounded-circle" title="Tài khoản đang hoạt động">
                                <span class="visually-hidden">Online</span>
                            </span>
                        </div>

                        <h4 class="fw-bold text-dark mb-1">@profile.FullName</h4>
                        <div class="text-muted font-monospace small mb-2">@profile.EmployeeCode</div>

                        <div class="d-flex flex-wrap gap-2 justify-content-center mb-3">
                            <span class="emp-badge emp-badge-neutral">
                                <i class="bi bi-building me-1"></i> @profile.DepartmentName
                            </span>
                            @if (!string.IsNullOrWhiteSpace(profile.PositionName))
                            {
                                <span class="emp-badge emp-badge-neutral">
                                    <i class="bi bi-briefcase me-1"></i> @profile.PositionName
                                </span>
                            }
                        </div>

                        @if (string.Equals(profile.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="emp-badge emp-badge-success mb-4">
                                ● Đang làm việc (Active)
                            </span>
                        }
                        else if (string.Equals(profile.Status, "RESIGNED", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="emp-badge emp-badge-danger mb-4">
                                ● Đã thôi việc (Resigned)
                            </span>
                        }
                        else
                        {
                            <span class="emp-badge emp-badge-neutral mb-4">
                                ● @profile.Status
                            </span>
                        }

                        <div class="w-100 text-start border-top pt-3">
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted small">Tên đăng nhập:</span>
                                <strong class="text-dark font-monospace">@profile.UserName</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted small">Mã ID nhân viên:</span>
                                <strong class="text-dark font-monospace">#@profile.EmployeeId</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted small">Vai trò hệ thống:</span>
                                <span class="emp-badge emp-badge-neutral font-monospace">@profile.RoleName</span>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted small">Thâm niên công tác:</span>
                                <strong class="text-dark">@CalculateTenure(profile.HireDate)</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2">
                                <span class="text-muted small">Ngày lập hồ sơ:</span>
                                <span class="text-secondary small tabular-nums">@profile.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Thẻ lương & Đãi ngộ -->
                <div class="card emp-kpi-card p-4 mb-4" style="border-left: 4px solid var(--emp-primary) !important;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="emp-kpi-label d-flex align-items-center gap-2">
                            <i class="bi bi-cash-stack text-primary"></i> CHẾ ĐỘ ĐÃI NGỘ
                        </span>
                        <span class="emp-badge emp-badge-success">Chính thức</span>
                    </div>
                    <div class="fs-4 fw-bold text-dark mb-1 tabular-nums">
                        @profile.BaseSalary.ToString("#,##0 VNĐ")
                    </div>
                    <small class="text-muted d-block">Mức lương cơ bản thỏa thuận theo hợp đồng lao động.</small>
                </div>
            </div>

            <!-- Cột phải: Toàn bộ chi tiết hồ sơ & Biểu mẫu chỉnh sửa -->
            <div class="col-12 col-xl-8">
                <div class="d-flex flex-column gap-4">

                    <!-- Khối 1: Hiển thị toàn bộ các trường thông tin trong bảng employee -->
                    <div class="card emp-card">
                        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-person text-primary fs-5"></i>
                                <div>
                                    <strong class="text-dark fs-6 text-uppercase fw-bold" style="letter-spacing: 0.5px;">Chi Tiết Hồ Sơ Nhân Sự Toàn Diện</strong>
                                    <div class="text-muted small">Toàn bộ các trường thông tin được lưu trữ trong bảng dữ liệu nhân viên</div>
                                </div>
                            </div>
                            <span class="emp-badge emp-badge-neutral">
                                16 Trường dữ liệu
                            </span>
                        </div>
                        <div class="card-body p-4">
                            <!-- Nhóm A: Thông tin công việc & Tổ chức -->
                            <div class="mb-4">
                                <h6 class="fw-bold text-primary text-uppercase mb-3 d-flex align-items-center gap-2" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                                    <i class="bi bi-buildings"></i> THÔNG TIN CÔNG VIỆC &amp; TỔ CHỨC
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-6 col-lg-4">
                                        <div class="p-3 bg-light rounded-3 h-100 border">
                                            <div class="text-muted small mb-1">Mã nhân viên (emp_code)</div>
                                            <div class="fw-bold text-dark font-monospace">@profile.EmployeeCode</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="p-3 bg-light rounded-3 h-100 border">
                                            <div class="text-muted small mb-1">Họ và tên (full_name)</div>
                                            <div class="fw-bold text-dark">@profile.FullName</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="p-3 bg-light rounded-3 h-100 border">
                                            <div class="text-muted small mb-1">Phòng ban (department)</div>
                                            <div class="fw-bold text-dark">@profile.DepartmentName <span class="badge bg-secondary-subtle text-secondary small">@profile.DepartmentCode</span></div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="p-3 bg-light rounded-3 h-100 border">
                                            <div class="text-muted small mb-1">Vị trí / Chức danh (position)</div>
                                            <div class="fw-bold text-dark">@(profile.PositionName ?? "Chưa thiết lập")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="p-3 bg-light rounded-3 h-100 border">
                                            <div class="text-muted small mb-1">Ngày tuyển dụng / Bắt đầu (hire_date)</div>
                                            <div class="fw-bold text-dark tabular-nums">@(profile.HireDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr class="text-light my-4" />

                            <!-- Nhóm B: Thông tin cá nhân & Nhân thân -->
                            <div class="mb-4">
                                <h6 class="fw-bold text-primary text-uppercase mb-3 d-flex align-items-center gap-2" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                                    <i class="bi bi-person-vcard"></i> THÔNG TIN CÁ NHÂN &amp; NHÂN THÂN
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-6 col-lg-4">
                                        <div class="p-3 bg-light rounded-3 h-100 border">
                                            <div class="text-muted small mb-1">Ngày sinh (dob)</div>
                                            <div class="fw-bold text-dark tabular-nums">@(profile.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="p-3 bg-light rounded-3 h-100 border">
                                            <div class="text-muted small mb-1">Giới tính (gender)</div>
                                            <div class="fw-bold text-dark">@(TranslateGender(profile.Gender))</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="p-3 bg-light rounded-3 h-100 border">
                                            <div class="text-muted small mb-1">Trình độ học vấn (education_level)</div>
                                            <div class="fw-bold text-dark">@(EducationLevelCatalog.ToDisplayName(profile.EducationLevel))</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr class="text-light my-4" />

                            <!-- Nhóm C: Thông tin liên hệ -->
                            <div>
                                <h6 class="fw-bold text-primary text-uppercase mb-3 d-flex align-items-center gap-2" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                                    <i class="bi bi-telephone"></i> THÔNG TIN LIÊN HỆ
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="p-3 bg-light rounded-3 h-100 border">
                                            <div class="text-muted small mb-1">Số điện thoại (phone)</div>
                                            <div class="fw-bold text-dark tabular-nums">@(profile.Phone ?? "Chưa cập nhật")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-3 bg-light rounded-3 h-100 border">
                                            <div class="text-muted small mb-1">Email liên hệ (email)</div>
                                            <div class="fw-bold text-dark">@(profile.Email ?? "Chưa cập nhật")</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="p-3 bg-light rounded-3 border">
                                            <div class="text-muted small mb-1">Địa chỉ thường trú / liên hệ (address)</div>
                                            <div class="fw-bold text-dark">@(profile.Address ?? "Chưa cập nhật địa chỉ")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Khối 2: Form cập nhật thông tin cá nhân -->
                    <div class="card emp-card">
                        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex align-items-center gap-2">
                            <i class="bi bi-pencil-square text-primary fs-5"></i>
                            <strong class="text-dark fs-6 text-uppercase fw-bold" style="letter-spacing: 0.5px;">Chỉnh Sửa &amp; Cập Nhật Thông Tin Liên Hệ</strong>
                        </div>
                        <div class="card-body p-4">
                            <EditForm Model="profileModel" OnValidSubmit="HandleUpdateProfileAsync">
                                <div class="row g-3 mb-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label fw-semibold text-secondary" for="fullNameInput">Họ và tên đầy đủ</label>
                                        <InputText id="fullNameInput" class="form-control" @bind-Value="profileModel.FullName" placeholder="Nhập họ và tên..." />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label fw-semibold text-secondary" for="phoneInput">Số điện thoại liên hệ</label>
                                        <InputText id="phoneInput" class="form-control" @bind-Value="profileModel.Phone" placeholder="Ví dụ: 0912345678" />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label fw-semibold text-secondary" for="emailInput">Địa chỉ Email</label>
                                        <InputText id="emailInput" type="email" class="form-control" @bind-Value="profileModel.Email" placeholder="Ví dụ: nv@saigonretail.vn" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label fw-semibold text-secondary" for="genderInput">Giới tính</label>
                                        <InputSelect id="genderInput" class="form-select" @bind-Value="profileModel.Gender">
                                            <option value="">-- Chọn --</option>
                                            <option value="Male">Nam</option>
                                            <option value="Female">Nữ</option>
                                            <option value="Other">Khác</option>
                                        </InputSelect>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label fw-semibold text-secondary" for="dobInput">Ngày sinh</label>
                                        <InputDate id="dobInput" class="form-control" @bind-Value="profileModel.DateOfBirth" />
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold text-secondary" for="addressInput">Địa chỉ liên lạc / thường trú</label>
                                    <InputTextArea id="addressInput" class="form-control" rows="2" @bind-Value="profileModel.Address" placeholder="Nhập số nhà, tên đường, phường/xã, quận/huyện..." />
                                </div>

                                <button type="submit" class="btn emp-btn-primary px-4 py-2"
                                        disabled="@isUpdatingProfile">
                                    @if (isUpdatingProfile)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Đang lưu thông tin...</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-floppy me-2"></i> Lưu thay đổi thông tin cá nhân</span>
                                    }
                                </button>
                            </EditForm>
                        </div>
                    </div>

                    <!-- Khối 3: Đổi mật khẩu bảo mật -->
                    <div class="card emp-card">
                        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock text-primary fs-5"></i>
                            <strong class="text-dark fs-6 text-uppercase fw-bold" style="letter-spacing: 0.5px;">Bảo Mật &amp; Đổi Mật Khẩu Đăng Nhập</strong>
                        </div>
                        <div class="card-body p-4">
                            <EditForm Model="passwordModel" OnValidSubmit="HandleChangePasswordAsync">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-secondary" for="currentPasswordInput">Mật khẩu hiện tại</label>
                                    <InputText id="currentPasswordInput" type="password" class="form-control" @bind-Value="passwordModel.CurrentPassword" placeholder="Nhập mật khẩu đang sử dụng..." />
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label fw-semibold text-secondary" for="newPasswordInput">Mật khẩu mới</label>
                                        <InputText id="newPasswordInput" type="password" class="form-control" @bind-Value="passwordModel.NewPassword" placeholder="Tối thiểu 3 ký tự..." />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label fw-semibold text-secondary" for="confirmPasswordInput">Xác nhận mật khẩu mới</label>
                                        <InputText id="confirmPasswordInput" type="password" class="form-control" @bind-Value="passwordModel.ConfirmPassword" placeholder="Nhập lại mật khẩu mới..." />
                                    </div>
                                </div>

                                <button type="submit" class="btn emp-btn-primary px-4 py-2"
                                        disabled="@isChangingPassword">
                                    @if (isChangingPassword)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Đang cập nhật...</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-key me-2"></i> Cập nhật mật khẩu mới</span>
                                    }
                                </button>
                            </EditForm>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

@code {
    private EmployeeProfileDto? profile;
    private bool isLoadingProfile = true;
    private bool isUpdatingProfile = false;
    private bool isChangingPassword = false;

    private ProfileFormModel profileModel = new();
    private PasswordFormModel passwordModel = new();

    private string? globalSuccessMessage;
    private string? globalErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        isLoadingProfile = true;
        globalErrorMessage = null;

        try
        {
            var response = await AuthApiClient.GetProfileAsync();
            if (response is not null && response.Success && response.Data is not null)
            {
                profile = response.Data;
                profileModel = new ProfileFormModel
                {
                    FullName = profile.FullName,
                    Phone = profile.Phone,
                    Email = profile.Email,
                    Address = profile.Address,
                    Gender = profile.Gender,
                    DateOfBirth = profile.DateOfBirth
                };
            }
            else
            {
                globalErrorMessage = response?.Error?.Message ?? "Không thể tải dữ liệu hồ sơ nhân sự.";
            }
        }
        catch (Exception ex)
        {
            globalErrorMessage = "Lỗi khi tải hồ sơ: " + ex.Message;
        }
        finally
        {
            isLoadingProfile = false;
        }
    }

    private async Task HandleUpdateProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(profileModel.FullName))
        {
            globalErrorMessage = "Vui lòng nhập họ và tên đầy đủ.";
            return;
        }

        isUpdatingProfile = true;
        globalSuccessMessage = null;
        globalErrorMessage = null;

        try
        {
            var request = new UpdateProfileRequest(
                FullName: profileModel.FullName.Trim(),
                Phone: profileModel.Phone?.Trim(),
                Email: profileModel.Email?.Trim(),
                Address: profileModel.Address?.Trim(),
                DateOfBirth: profileModel.DateOfBirth,
                Gender: profileModel.Gender);

            var err = await AuthApiClient.UpdateProfileAsync(request);
            if (err is not null)
            {
                globalErrorMessage = err.Message;
            }
            else
            {
                globalSuccessMessage = "Cập nhật thông tin hồ sơ nhân viên thành công!";
                await LoadProfileAsync();
            }
        }
        catch (Exception ex)
        {
            globalErrorMessage = "Lỗi khi cập nhật hồ sơ: " + ex.Message;
        }
        finally
        {
            isUpdatingProfile = false;
        }
    }

    private async Task HandleChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(passwordModel.CurrentPassword))
        {
            globalErrorMessage = "Vui lòng nhập mật khẩu hiện tại.";
            return;
        }

        if (string.IsNullOrWhiteSpace(passwordModel.NewPassword))
        {
            globalErrorMessage = "Vui lòng nhập mật khẩu mới.";
            return;
        }

        if (passwordModel.NewPassword != passwordModel.ConfirmPassword)
        {
            globalErrorMessage = "Xác nhận mật khẩu mới không trùng khớp.";
            return;
        }

        isChangingPassword = true;
        globalSuccessMessage = null;
        globalErrorMessage = null;

        try
        {
            var err = await AuthApiClient.ChangePasswordAsync(new ChangePasswordRequest(
                passwordModel.CurrentPassword, passwordModel.NewPassword));

            if (err is not null)
            {
                globalErrorMessage = err.Message;
            }
            else
            {
                globalSuccessMessage = "Đổi mật khẩu thành công!";
                passwordModel = new PasswordFormModel();
            }
        }
        catch (Exception ex)
        {
            globalErrorMessage = "Lỗi khi đổi mật khẩu: " + ex.Message;
        }
        finally
        {
            isChangingPassword = false;
        }
    }

    private static string GetInitial(string? fullName) =>
        string.IsNullOrWhiteSpace(fullName) ? "N" : fullName.Trim()[0].ToString().ToUpperInvariant();

    private static string TranslateGender(string? gender) => gender switch
    {
        "Male" => "Nam",
        "Female" => "Nữ",
        "Other" => "Khác",
        _ => gender ?? "Chưa xác định"
    };

    private static string CalculateTenure(DateOnly? hireDate)
    {
        if (hireDate is null) return "Chưa cập nhật";
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (today < hireDate.Value) return "Mới gia nhập";

        var months = (today.Year - hireDate.Value.Year) * 12 + today.Month - hireDate.Value.Month;
        if (months < 1) return "Dưới 1 tháng";
        if (months < 12) return $"{months} tháng";

        var years = months / 12;
        var remMonths = months % 12;
        return remMonths == 0 ? $"{years} năm" : $"{years} năm {remMonths} tháng";
    }

