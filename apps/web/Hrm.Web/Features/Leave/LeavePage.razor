@page "/employee/leave"
@page "/leave"
@layout EmployeeLayout
@attribute [Authorize]
@inject ILeaveApiClient LeaveApiClient

<PageTitle>Đơn xin nghỉ phép - Saigon Retail</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Hero Banner -->
    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #052e22 0%, #065f46 50%, #047857 100%); color: white; border-radius: 18px; box-shadow: 0 12px 30px rgba(5, 46, 34, 0.25) !important;">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge text-white mb-2 px-3 py-1" style="background-color: #10b981; font-size: 0.85rem; border-radius: 20px; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);">
                    ● NGHỈ PHÉP &amp; NGHỈ BÙ
                </span>
                <h1 class="h3 fw-bold mb-1 text-white">Quản lý Đơn xin nghỉ phép</h1>
                <p class="mb-0 text-white-50">Tạo mới và theo dõi trạng thái phê duyệt các đơn xin nghỉ phép của bạn.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-light rounded-pill px-4 py-2" @onclick="LoadDataAsync" disabled="@isLoading">
                    ↻ Làm mới
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46;">
            <span style="font-size: 1.25rem;">✓</span>
            <div>@successMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px;">
            <span style="font-size: 1.25rem;">⚠</span>
            <div>@errorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Leave Balance KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; border-top: 4px solid #10b981 !important;">
                <div class="card-body p-3 text-center">
                    <small class="text-muted text-uppercase fw-semibold d-block mb-1">Tổng phép năm</small>
                    <span class="fs-2 fw-bold text-dark">@(balance?.TotalAnnualEntitlement.ToString("0.#") ?? "12")</span>
                    <span class="text-muted small d-block">ngày/năm</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; border-top: 4px solid #f43f5e !important;">
                <div class="card-body p-3 text-center">
                    <small class="text-muted text-uppercase fw-semibold d-block mb-1">Đã sử dụng</small>
                    <span class="fs-2 fw-bold text-danger">@(balance?.UsedAnnualDays.ToString("0.#") ?? "0")</span>
                    <span class="text-muted small d-block">ngày đã duyệt</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; border-top: 4px solid #059669 !important; background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);">
                <div class="card-body p-3 text-center">
                    <small class="text-uppercase fw-bold d-block mb-1" style="color: #059669;">Số ngày còn lại</small>
                    <span class="fs-2 fw-bold" style="color: #059669;">@(balance?.RemainingAnnualDays.ToString("0.#") ?? "12")</span>
                    <span class="text-muted small d-block">ngày khả dụng</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; border-top: 4px solid #f59e0b !important;">
                <div class="card-body p-3 text-center">
                    <small class="text-muted text-uppercase fw-semibold d-block mb-1">Đang chờ duyệt</small>
                    <span class="fs-2 fw-bold text-warning">@(balance?.PendingRequestsCount.ToString() ?? "0")</span>
                    <span class="text-muted small d-block">đơn đang chờ</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Create Request Form & Guidelines -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-header bg-white border-bottom border-light py-3 px-4">
                    <strong class="text-dark">TẠO ĐƠN XIN NGHỈ PHÉP</strong>
                </div>
                <div class="card-body p-4">
                    <EditForm Model="formModel" OnValidSubmit="HandleSubmitAsync">
                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold text-secondary">Từ ngày <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" @bind="formModel.StartDate" @bind:after="RecalculateDays" min="@DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd")" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold text-secondary">Đến ngày <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" @bind="formModel.EndDate" @bind:after="RecalculateDays" min="@formModel.StartDate.ToString("yyyy-MM-dd")" />
                            </div>

                            @if (estimatedDays > 0)
                            {
                                <div class="col-12">
                                    <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between border" style="border-color: #d1fae5 !important;">
                                        <span class="small text-muted">Số ngày nghỉ dự tính (không tính Chủ Nhật):</span>
                                        <span class="badge bg-success fs-6 px-3 py-1" style="background-color: #059669 !important;">@estimatedDays ngày</span>
                                    </div>
                                </div>
                            }

                            <div class="col-12">
                                <label class="form-label small fw-semibold text-secondary">Lý do xin nghỉ <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="3" placeholder="Nhập chi tiết lý do xin nghỉ phép..." @bind="formModel.Reason"></textarea>
                            </div>

                            <div class="col-12 text-end">
                                <button type="submit" class="btn text-white px-4 py-2 fw-semibold rounded-pill shadow-sm"
                                        style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; box-shadow: 0 6px 18px rgba(16, 185, 129, 0.35) !important;"
                                        disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Đang gửi đơn...</span>
                                    }
                                    else
                                    {
                                        <span>Gửi đơn xin nghỉ phép</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="card-header bg-white border-bottom border-light py-3 px-4">
                    <strong class="text-dark">QUY ĐỊNH NGHỈ PHÉP</strong>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-3 small text-secondary">
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-success fw-bold">✓</span>
                            <div><strong>Phép năm:</strong> 12 ngày phép tiêu chuẩn mỗi năm, tính công hưởng 100% lương theo quy định hiện hành.</div>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-success fw-bold">✓</span>
                            <div><strong>Thời gian gửi đơn:</strong> Vui lòng nộp trước ít nhất 2 ngày đối với phép năm và báo sớm nhất có thể khi nghỉ đột xuất.</div>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-success fw-bold">✓</span>
                            <div><strong>Hủy đơn:</strong> Bạn có thể chủ động hủy đơn khi đơn vẫn còn ở trạng thái <em>Chờ duyệt</em>.</div>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-success fw-bold">✓</span>
                            <div><strong>Chế độ nghỉ ốm:</strong> Cần nộp giấy ra viện hoặc giấy chứng nhận nghỉ việc hưởng BHXH cho phòng Nhân sự.</div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Leave Requests History Table -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
            <strong class="text-dark">LỊCH SỬ ĐƠN NGHỈ PHÉP CỦA BẠN</strong>
            <span class="badge bg-success-subtle text-success border border-success-subtle">@(requests.Count) đơn</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small">
                        <tr>
                            <th class="ps-4">KHOẢNG THỜI GIAN</th>
                            <th>SỐ NGÀY</th>
                            <th>LÝ DO</th>
                            <th>TRẠNG THÁI</th>
                            <th>NGÀY TẠO</th>
                            <th class="pe-4 text-end">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (requests.Count == 0 && !isLoading)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Bạn chưa có đơn xin nghỉ phép nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in requests)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="small">
                                            <strong>@r.StartDate.ToString("dd/MM/yyyy")</strong>
                                            <span class="text-muted">đến</span>
                                            <strong>@r.EndDate.ToString("dd/MM/yyyy")</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary font-monospace">@r.DaysCount.ToString("0.#") ngày</span>
                                    </td>
                                    <td class="small text-muted" style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@r.Reason">
                                        @r.Reason
                                    </td>
                                    <td>
                                        @if (r.Status == LeaveStatuses.Pending)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1 rounded-pill">
                                                ● Chờ duyệt
                                            </span>
                                        }
                                        else if (r.Status == LeaveStatuses.Approved)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill">
                                                ✓ Đã duyệt
                                            </span>
                                        }
                                        else if (r.Status == LeaveStatuses.Rejected)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1 rounded-pill" title="@r.RejectionReason">
                                                ✕ Từ chối
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill">
                                                Đã hủy
                                            </span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        @r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="pe-4 text-end">
                                        @if (r.Status == LeaveStatuses.Pending)
                                        {
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                    @onclick="() => CancelRequestAsync(r.Id)"
                                                    disabled="@isCancelling">
                                                Hủy đơn
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">--</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private LeaveBalanceSummaryDto? balance;
    private IReadOnlyList<LeaveRequestDto> requests = [];
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isCancelling = false;
    private string? successMessage;
    private string? errorMessage;
    private decimal estimatedDays = 1;

    private FormModel formModel = new();

    protected override async Task OnInitializedAsync()
    {
        formModel.StartDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        formModel.EndDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        RecalculateDays();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            balance = await LeaveApiClient.GetBalanceAsync();
            requests = await LeaveApiClient.GetMyRequestsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Không thể tải thông tin nghỉ phép: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RecalculateDays()
    {
        if (formModel.EndDate < formModel.StartDate)
        {
            formModel.EndDate = formModel.StartDate;
        }

        decimal count = 0;
        for (var d = formModel.StartDate; d <= formModel.EndDate; d = d.AddDays(1))
        {
            if (d.DayOfWeek != DayOfWeek.Sunday)
            {
                count += 1;
            }
        }
        estimatedDays = Math.Max(1, count);
    }

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(formModel.Reason))
        {
            errorMessage = "Vui lòng nhập lý do xin nghỉ phép.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var dto = new CreateLeaveRequestDto(
                formModel.StartDate,
                formModel.EndDate,
                formModel.Reason.Trim()
            );

            await LeaveApiClient.CreateRequestAsync(dto);
            successMessage = "Gửi đơn xin nghỉ phép thành công! Đơn của bạn đang chờ phê duyệt.";

            // Reset form
            formModel.Reason = string.Empty;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task CancelRequestAsync(Guid id)
    {
        isCancelling = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            await LeaveApiClient.CancelRequestAsync(id);
            successMessage = "Đã hủy đơn xin nghỉ phép thành công.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isCancelling = false;
        }
    }

    private sealed class FormModel
    {
        public DateOnly StartDate { get; set; }
        public DateOnly EndDate { get; set; }
        public string Reason { get; set; } = string.Empty;
    }
}
