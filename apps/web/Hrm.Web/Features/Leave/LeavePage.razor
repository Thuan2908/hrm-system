@page "/employee/leave"
@page "/leave"
@layout EmployeeLayout
@attribute [Authorize]
@inject ILeaveApiClient LeaveApiClient
@inject IFileApiClient FileApiClient

<PageTitle>Đơn xin nghỉ phép - Saigon Retail</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Hero Banner -->
    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #052e22 0%, #065f46 50%, #047857 100%); color: white; border-radius: 18px; box-shadow: 0 12px 30px rgba(5, 46, 34, 0.25) !important;">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge text-white mb-2 px-3 py-1" style="background-color: #10b981; font-size: 0.85rem; border-radius: 20px; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);">
                    ● NGHỈ PHÉP &amp; NGHỈ BÙ
                </span>
                <h1 class="h3 fw-bold mb-1 text-white">Quản lý Đơn xin nghỉ phép</h1>
                <p class="mb-0 text-white-50">Tạo mới và theo dõi trạng thái phê duyệt các đơn xin nghỉ phép của bạn.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-light rounded-pill px-4 py-2" @onclick="LoadDataAsync" disabled="@isLoading">
                    ↻ Làm mới
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46;">
            <span style="font-size: 1.25rem;">✓</span>
            <div>@successMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px;">
            <span style="font-size: 1.25rem;">⚠</span>
            <div>@errorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Leave Balance KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; border-top: 4px solid #10b981 !important;">
                <div class="card-body p-3 text-center">
                    <small class="text-muted text-uppercase fw-semibold d-block mb-1">Tổng phép năm</small>
                    <span class="fs-2 fw-bold text-dark">@(balance?.TotalAnnualEntitlement.ToString("0.#") ?? "12")</span>
                    <span class="text-muted small d-block">ngày/năm</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; border-top: 4px solid #f43f5e !important;">
                <div class="card-body p-3 text-center">
                    <small class="text-muted text-uppercase fw-semibold d-block mb-1">Đã sử dụng</small>
                    <span class="fs-2 fw-bold text-danger">@(balance?.UsedAnnualDays.ToString("0.#") ?? "0")</span>
                    <span class="text-muted small d-block">ngày đã duyệt</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; border-top: 4px solid #059669 !important; background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);">
                <div class="card-body p-3 text-center">
                    <small class="text-uppercase fw-bold d-block mb-1" style="color: #059669;">Số ngày còn lại</small>
                    <span class="fs-2 fw-bold" style="color: #059669;">@(balance?.RemainingAnnualDays.ToString("0.#") ?? "12")</span>
                    <span class="text-muted small d-block">ngày khả dụng</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; border-top: 4px solid #f59e0b !important;">
                <div class="card-body p-3 text-center">
                    <small class="text-muted text-uppercase fw-semibold d-block mb-1">Đang chờ duyệt</small>
                    <span class="fs-2 fw-bold text-warning">@(balance?.PendingRequestsCount.ToString() ?? "0")</span>
                    <span class="text-muted small d-block">đơn đang chờ</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Create Request Form & Guidelines -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-header bg-white border-bottom border-light py-3 px-4">
                    <strong class="text-dark">TẠO ĐƠN XIN NGHỈ PHÉP</strong>
                </div>
                <div class="card-body p-4">
                    <EditForm Model="formModel" OnValidSubmit="HandleSubmitAsync">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-secondary">Loại đơn <span class="text-danger">*</span></label>
                                <select class="form-select fw-medium" @bind="formModel.LeaveType" @bind:after="RecalculateDays">
                                    <option value="@LeaveTypes.Annual">🏖️ Nghỉ phép năm (Hưởng 100% lương, trừ vào 12 ngày phép)</option>
                                    <option value="@LeaveTypes.Sick">🩺 Nghỉ ốm đau (Hưởng chế độ BHXH 75%, không trừ phép năm)</option>
                                    <option value="@LeaveTypes.Maternity">👶 Nghỉ thai sản (Chế độ thai sản theo luật BHXH)</option>
                                    <option value="@LeaveTypes.Resignation">🚪 Nghỉ việc / Đơn xin thôi việc (Thông báo thôi việc)</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold text-secondary">
                                    @(formModel.LeaveType == LeaveTypes.Resignation ? "Ngày bắt đầu thông báo" : "Từ ngày") <span class="text-danger">*</span>
                                </label>
                                <input type="date" class="form-control" @bind="formModel.StartDate" @bind:after="RecalculateDays" min="@DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd")" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold text-secondary">
                                    @(formModel.LeaveType == LeaveTypes.Resignation ? "Ngày làm việc cuối cùng" : "Đến ngày") <span class="text-danger">*</span>
                                </label>
                                <input type="date" class="form-control" @bind="formModel.EndDate" @bind:after="RecalculateDays" min="@formModel.StartDate.ToString("yyyy-MM-dd")" />
                            </div>

                            @if (estimatedDays > 0 && formModel.LeaveType != LeaveTypes.Resignation)
                            {
                                <div class="col-12">
                                    <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between border" style="border-color: #d1fae5 !important;">
                                        <span class="small text-muted">Số ngày nghỉ dự tính (không tính Chủ Nhật):</span>
                                        <span class="badge bg-success fs-6 px-3 py-1" style="background-color: #059669 !important;">@estimatedDays ngày</span>
                                    </div>
                                </div>
                            }

                            <div class="col-12">
                                <label class="form-label small fw-semibold text-secondary">Lý do xin nghỉ / Nội dung <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="3" placeholder="Nhập chi tiết lý do..." @bind="formModel.Reason"></textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold text-secondary">
                                    📎 Tệp đính kèm / Giấy tờ minh chứng @(formModel.LeaveType == LeaveTypes.Sick || formModel.LeaveType == LeaveTypes.Maternity ? "(Giấy ra viện / Khám bệnh)" : "(Tùy chọn)")
                                </label>
                                <div class="input-group">
                                    <InputFile class="form-control" OnChange="HandleFileUpload" disabled="@isUploadingFile" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" />
                                </div>
                                @if (isUploadingFile)
                                {
                                    <div class="small text-muted mt-1">
                                        <span class="spinner-border spinner-border-sm me-1"></span> Đang tải tệp lên máy chủ...
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(uploadFileMessage))
                                {
                                    <div class="small text-success fw-semibold mt-1">@uploadFileMessage</div>
                                }
                            </div>

                            <div class="col-12 text-end">
                                <button type="submit" class="btn text-white px-4 py-2 fw-semibold rounded-pill shadow-sm"
                                        style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; box-shadow: 0 6px 18px rgba(16, 185, 129, 0.35) !important;"
                                        disabled="@(isSubmitting || isUploadingFile)">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Đang gửi đơn...</span>
                                    }
                                    else
                                    {
                                        <span>Gửi đơn @(LeaveTypes.GetDisplayName(formModel.LeaveType))</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="card-header bg-white border-bottom border-light py-3 px-4">
                    <strong class="text-dark">QUY ĐỊNH NGHỈ PHÉP</strong>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-3 small text-secondary">
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-success fw-bold">✓</span>
                            <div><strong>Phép năm:</strong> 12 ngày phép tiêu chuẩn mỗi năm, tính công hưởng 100% lương theo quy định hiện hành.</div>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-success fw-bold">✓</span>
                            <div><strong>Thời gian gửi đơn:</strong> Vui lòng nộp trước ít nhất 2 ngày đối với phép năm và báo sớm nhất có thể khi nghỉ đột xuất.</div>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-success fw-bold">✓</span>
                            <div><strong>Hủy đơn:</strong> Bạn có thể chủ động hủy đơn khi đơn vẫn còn ở trạng thái <em>Chờ duyệt</em>.</div>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-success fw-bold">✓</span>
                            <div><strong>Chế độ nghỉ ốm:</strong> Cần nộp giấy ra viện hoặc giấy chứng nhận nghỉ việc hưởng BHXH cho phòng Nhân sự.</div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Leave Requests History Table -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
            <strong class="text-dark">LỊCH SỬ ĐƠN NGHỈ PHÉP CỦA BẠN</strong>
            <span class="badge bg-success-subtle text-success border border-success-subtle">@(requests.Count) đơn</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small">
                        <tr>
                            <th class="ps-4">LOẠI ĐƠN</th>
                            <th>KHOẢNG THỜI GIAN</th>
                            <th>SỐ NGÀY</th>
                            <th>LÝ DO &amp; TỆP ĐÍNH KÈM</th>
                            <th>TRẠNG THÁI</th>
                            <th>NGÀY TẠO</th>
                            <th class="pe-4 text-end">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (requests.Count == 0 && !isLoading)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <div class="fs-3 mb-2">📁</div>
                                    <div>Bạn chưa có đơn xin nghỉ phép nào.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in pagedRequests)
                            {
                                <tr>
                                    <td class="ps-4">
                                        @if (r.LeaveType == LeaveTypes.Sick)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info">🩺 @r.LeaveTypeName</span>
                                        }
                                        else if (r.LeaveType == LeaveTypes.Maternity)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary">👶 @r.LeaveTypeName</span>
                                        }
                                        else if (r.LeaveType == LeaveTypes.Resignation)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger">🚪 @r.LeaveTypeName</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">🏖️ @r.LeaveTypeName</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="small">
                                            <strong>@r.StartDate.ToString("dd/MM/yyyy")</strong>
                                            <span class="text-muted">đến</span>
                                            <strong>@r.EndDate.ToString("dd/MM/yyyy")</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary font-monospace">@r.DaysCount.ToString("0.#") ngày</span>
                                    </td>
                                    <td class="small" style="max-width: 250px;">
                                        <div class="text-muted" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@r.Reason">
                                            @r.Reason
                                        </div>
                                        @if (r.AttachmentFileId.HasValue)
                                        {
                                            <a href="api/v1/files/@r.AttachmentFileId/download" target="_blank"
                                               class="badge bg-light text-primary border text-decoration-none mt-1 d-inline-flex align-items-center gap-1"
                                               title="Bấm để tải tệp minh chứng">
                                                <span>📎</span> @(r.AttachmentFileName ?? "Tệp minh chứng")
                                            </a>
                                        }
                                    </td>
                                    <td>
                                        @if (r.Status == LeaveStatuses.Pending)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2.5 py-1 rounded-pill">
                                                ● Chờ duyệt
                                            </span>
                                        }
                                        else if (r.Status == LeaveStatuses.Approved)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-2.5 py-1 rounded-pill">
                                                ✓ Đã duyệt
                                            </span>
                                        }
                                        else if (r.Status == LeaveStatuses.Rejected)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-2.5 py-1 rounded-pill" title="@r.RejectionReason">
                                                ✕ Từ chối
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1 rounded-pill">
                                                Đã hủy
                                            </span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        @r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="pe-4 text-end">
                                        @if (r.Status == LeaveStatuses.Pending)
                                        {
                                            <div class="d-inline-flex align-items-center gap-1">
                                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold shadow-sm"
                                                        @onclick="() => OpenEditModal(r)"
                                                        title="Chỉnh sửa thông tin đơn này">
                                                    ✏️ Sửa
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1"
                                                        @onclick="() => CancelRequestAsync(r.Id)"
                                                        disabled="@isCancelling"
                                                        title="Hủy đơn xin nghỉ này">
                                                    Hủy đơn
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">--</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer for Leave Requests Table -->
        @if (requests.Count > 0)
        {
            <div class="card-footer bg-white border-top border-light py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Hiển thị <strong class="text-dark">@(((leaveCurrentPage - 1) * leavePageSize) + 1)</strong>
                    đến <strong class="text-dark">@(Math.Min(leaveCurrentPage * leavePageSize, requests.Count))</strong>
                    trong tổng số <strong class="text-dark">@requests.Count</strong> đơn
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted me-1">Số dòng:</span>
                    <select class="form-select form-select-sm" style="width: auto; border-radius: 8px;" value="@leavePageSize" @onchange="OnLeavePageSizeChanged">
                        <option value="5">5 / trang</option>
                        <option value="10">10 / trang</option>
                        <option value="15">15 / trang</option>
                        <option value="25">25 / trang</option>
                    </select>

                    <ul class="pagination pagination-sm mb-0 ms-2 pagination-custom">
                        <li class="page-item @(leaveCurrentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetLeavePage(1)" title="Trang đầu">«</button>
                        </li>
                        <li class="page-item @(leaveCurrentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetLeavePage(leaveCurrentPage - 1)" title="Trang trước">‹</button>
                        </li>

                        @for (int i = 1; i <= leaveTotalPages; i++)
                        {
                            var pageNum = i;
                            if (pageNum == 1 || pageNum == leaveTotalPages || (pageNum >= leaveCurrentPage - 1 && pageNum <= leaveCurrentPage + 1))
                            {
                                <li class="page-item @(leaveCurrentPage == pageNum ? "active" : "")">
                                    <button class="page-link" @onclick="() => SetLeavePage(pageNum)">@pageNum</button>
                                </li>
                            }
                            else if (pageNum == leaveCurrentPage - 2 || pageNum == leaveCurrentPage + 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        <li class="page-item @(leaveCurrentPage >= leaveTotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetLeavePage(leaveCurrentPage + 1)" title="Trang kế">›</button>
                        </li>
                        <li class="page-item @(leaveCurrentPage >= leaveTotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetLeavePage(leaveTotalPages)" title="Trang cuối">»</button>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>

</div>

<style>
    .pagination-custom .page-link {
        border-radius: 8px;
        margin: 0 2px;
        border: 1px solid #e2e8f0;
        color: #334155;
        font-size: 0.85rem;
        padding: 5px 12px;
    }
    .pagination-custom .page-item.active .page-link {
        background-color: #059669;
        border-color: #059669;
        color: white;
        font-weight: 600;
        box-shadow: 0 2px 6px rgba(5, 150, 105, 0.35);
    }
</style>

@code {
    private LeaveBalanceSummaryDto? balance;
    private IReadOnlyList<LeaveRequestDto> requests = [];
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isCancelling = false;
    private bool isUploadingFile = false;
    private string? uploadFileMessage;
    private string? successMessage;
    private string? errorMessage;
    private decimal estimatedDays = 1;

    private int leaveCurrentPage = 1;
    private int leavePageSize = 5;
    private int leaveTotalPages => Math.Max(1, (int)Math.Ceiling((double)requests.Count / leavePageSize));
    private IEnumerable<LeaveRequestDto> pagedRequests => requests.Skip((leaveCurrentPage - 1) * leavePageSize).Take(leavePageSize);

    private int approvalCurrentPage = 1;
    private int approvalPageSize = 5;
    private int approvalTotalPages => Math.Max(1, (int)Math.Ceiling((double)pendingApprovals.Count / approvalPageSize));
    private IEnumerable<PendingLeaveApprovalDto> pagedApprovals => pendingApprovals.Skip((approvalCurrentPage - 1) * approvalPageSize).Take(approvalPageSize);

    private void SetLeavePage(int page)
    {
        if (page >= 1 && page <= leaveTotalPages)
        {
            leaveCurrentPage = page;
        }
    }

    private void OnLeavePageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            leavePageSize = size;
            leaveCurrentPage = 1;
        }
    }

    private void SetApprovalPage(int page)
    {
        if (page >= 1 && page <= approvalTotalPages)
        {
            approvalCurrentPage = page;
        }
    }

    private void OnApprovalPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            approvalPageSize = size;
            approvalCurrentPage = 1;
        }
    }

    private LeaveRequestDto? editingRequest;
    private FormModel editModel = new();
    private decimal editDaysCount = 1m;
    private bool isSavingEdit = false;
    private bool isUploadingEditFile = false;
    private string? editErrorMessage;
    private string? editFileUploadMessage;

    private FormModel formModel = new();

    protected override async Task OnInitializedAsync()
    {
        formModel.StartDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        formModel.EndDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        RecalculateDays();
        await LoadDataAsync();
    }



    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            balance = await LeaveApiClient.GetBalanceAsync();
            requests = await LeaveApiClient.GetMyRequestsAsync();
            if (leaveCurrentPage > leaveTotalPages)
            {
                leaveCurrentPage = 1;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Không thể tải thông tin nghỉ phép: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RecalculateDays()
    {
        if (formModel.EndDate < formModel.StartDate)
        {
            formModel.EndDate = formModel.StartDate;
        }

        if (formModel.LeaveType == LeaveTypes.Resignation)
        {
            estimatedDays = 1;
            return;
        }

        decimal count = 0;
        for (var d = formModel.StartDate; d <= formModel.EndDate; d = d.AddDays(1))
        {
            if (d.DayOfWeek != DayOfWeek.Sunday)
            {
                count += 1;
            }
        }
        estimatedDays = Math.Max(1, count);
    }

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(formModel.Reason))
        {
            errorMessage = "Vui lòng nhập lý do xin nghỉ / nội dung.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var dto = new CreateLeaveRequestDto(
                LeaveType: formModel.LeaveType,
                StartDate: formModel.StartDate,
                EndDate: formModel.EndDate,
                Reason: formModel.Reason.Trim(),
                AttachmentFileId: formModel.AttachmentFileId,
                AttachmentFileName: formModel.AttachmentFileName
            );

            await LeaveApiClient.CreateRequestAsync(dto);
            successMessage = $"Gửi đơn {LeaveTypes.GetDisplayName(formModel.LeaveType)} thành công! Đơn của bạn đang chờ phê duyệt.";

            // Reset form
            formModel.Reason = string.Empty;
            formModel.AttachmentFileId = null;
            formModel.AttachmentFileName = null;
            uploadFileMessage = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task CancelRequestAsync(Guid id)
    {
        isCancelling = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            await LeaveApiClient.CancelRequestAsync(id);
            successMessage = "Đã hủy đơn thành công.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isCancelling = false;
        }
    }

    private void OpenEditModal(LeaveRequestDto item)
    {
        editingRequest = item;
        editModel = new FormModel
        {
            LeaveType = item.LeaveType,
            StartDate = item.StartDate,
            EndDate = item.EndDate,
            Reason = item.Reason,
            AttachmentFileId = item.AttachmentFileId,
            AttachmentFileName = item.AttachmentFileName
        };
        editErrorMessage = null;
        editFileUploadMessage = null;
        RecalculateEditDays();
    }

    private void CloseEditModal()
    {
        editingRequest = null;
        editErrorMessage = null;
    }

    private void RecalculateEditDays()
    {
        if (editModel.LeaveType == LeaveTypes.Resignation)
        {
            editModel.EndDate = editModel.StartDate;
            editDaysCount = 0m;
            return;
        }

        if (editModel.EndDate < editModel.StartDate)
        {
            editDaysCount = 0m;
            return;
        }

        decimal count = 0m;
        var cur = editModel.StartDate;
        while (cur <= editModel.EndDate)
        {
            if (cur.DayOfWeek != DayOfWeek.Sunday) count += 1m;
            cur = cur.AddDays(1);
        }
        editDaysCount = count;
    }

    private void RemoveEditFile()
    {
        editModel.AttachmentFileId = null;
        editModel.AttachmentFileName = null;
        editFileUploadMessage = null;
    }

    private async Task HandleEditFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        if (file.Size > 15 * 1024 * 1024)
        {
            editErrorMessage = "Dung lượng tệp không được vượt quá 15MB.";
            return;
        }

        isUploadingEditFile = true;
        editErrorMessage = null;
        editFileUploadMessage = null;

        try
        {
            var result = await FileApiClient.UploadFileAsync(file, "Leave");
            if (result is not null)
            {
                editModel.AttachmentFileId = result.Id;
                editModel.AttachmentFileName = result.FileName;
                editFileUploadMessage = $"✓ Đã tải lên: {result.FileName}";
            }
        }
        catch (Exception ex)
        {
            editErrorMessage = "Lỗi khi tải tệp: " + ex.Message;
        }
        finally
        {
            isUploadingEditFile = false;
        }
    }

    private async Task SaveEditRequestAsync()
    {
        if (editingRequest is null) return;

        if (editModel.EndDate < editModel.StartDate)
        {
            editErrorMessage = "Ngày kết thúc không được trước ngày bắt đầu nghỉ.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editModel.Reason))
        {
            editErrorMessage = "Vui lòng nhập lý do xin nghỉ.";
            return;
        }

        isSavingEdit = true;
        editErrorMessage = null;

        try
        {
            var dto = new UpdateLeaveRequestDto(
                LeaveType: editModel.LeaveType,
                StartDate: editModel.StartDate,
                EndDate: editModel.EndDate,
                Reason: editModel.Reason.Trim(),
                AttachmentFileId: editModel.AttachmentFileId,
                AttachmentFileName: editModel.AttachmentFileName
            );

            await LeaveApiClient.UpdateRequestAsync(editingRequest.Id, dto);
            successMessage = "Đã cập nhật đơn xin nghỉ phép thành công!";
            CloseEditModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            editErrorMessage = ex.Message;
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private sealed class FormModel
    {
        public string LeaveType { get; set; } = LeaveTypes.Annual;
        public DateOnly StartDate { get; set; }
        public DateOnly EndDate { get; set; }
        public string Reason { get; set; } = string.Empty;
        public Guid? AttachmentFileId { get; set; }
        public string? AttachmentFileName { get; set; }
    }
}
