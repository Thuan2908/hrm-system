@page "/employee/leave/approvals"
@layout EmployeeLayout
@attribute [Authorize]
@inject ILeaveApiClient LeaveApiClient
@inject IFileApiClient FileApiClient

<PageTitle>Duyệt đơn nghỉ phép - Saigon Retail</PageTitle>

<div class="container-fluid px-0">
    <div class="emp-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="emp-page-header-subtitle d-flex align-items-center gap-2">
                <i class="bi bi-clipboard2-check text-primary"></i>
                <span>QUẢN LÝ &amp; DUYỆT ĐƠN</span>
            </div>
            <h1 class="emp-page-header-title">Duyệt Đơn Xin Nghỉ Phép</h1>
            <p class="emp-page-header-desc">@(approvalOptions?.CanApproveAll == true ? "Duyệt đơn của nhân sự toàn hệ thống." : "Duyệt đơn của nhân sự do bạn quản lý trực tiếp.")</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn emp-btn-secondary" @onclick="LoadPendingApprovalsAsync" disabled="@isLoadingApprovals">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46;">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@successMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <AuthorizeView>
        <Authorized Context="authCtx">
            @if (isLoadingApprovals)
            {
                <div class="d-flex align-items-center gap-2 py-4 text-muted" role="status" aria-live="polite">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Đang tải danh sách đơn chờ duyệt...</span>
                </div>
            }
            else if (approvalOptions is not null)
            {
                @if (approvalOptions.CanApproveAll)
                {
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label" for="approval-department">Phòng ban</label>
                            <select id="approval-department" class="form-select" @bind="selectedDepartmentId" @bind:after="LoadPendingApprovalsAsync" disabled="@isLoadingApprovals">
                                <option value="0">Tất cả phòng ban</option>
                                @foreach (var department in approvalOptions.Departments)
                                {
                                    <option value="@department.Id">@department.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="approval-sort">Sắp xếp theo</label>
                            <select id="approval-sort" class="form-select" @bind="sortBy" @bind:after="LoadPendingApprovalsAsync" disabled="@isLoadingApprovals">
                                <option value="createdAt">Thời gian gửi</option>
                                <option value="employeeName">Họ tên nhân viên</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="approval-direction">Thứ tự</label>
                            <select id="approval-direction" class="form-select" @bind="sortDirection" @bind:after="LoadPendingApprovalsAsync" disabled="@isLoadingApprovals">
                                <option value="desc">@(sortBy == "employeeName" ? "Z → A" : "Mới nhất trước")</option>
                                <option value="asc">@(sortBy == "employeeName" ? "A → Z" : "Cũ nhất trước")</option>
                            </select>
                        </div>
                    </div>
                }
                <div class="card emp-card">
                    <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-list-check text-primary fs-5"></i>
                            <strong class="text-dark fs-6 text-uppercase fw-bold" style="letter-spacing: 0.5px;">Danh Sách Đơn Nghỉ Phép Chờ Duyệt</strong>
                        </div>
                        <span class="emp-badge emp-badge-warning">@(pendingApprovals.Count) đơn chờ duyệt</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table emp-table align-middle mb-0">
                                <thead class="table-light text-secondary small">
                                    <tr>
                                        <th class="ps-4">NHÂN VIÊN</th>
                                        <th>PHÒNG BAN</th>
                                        <th>KHOẢNG THỜI GIAN</th>
                                        <th>SỐ NGÀY</th>
                                        <th>LÝ DO</th>
                                        <th>NGÀY GỬI</th>
                                        <th class="pe-4 text-end">HÀNH ĐỘNG</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (pendingApprovals.Count == 0 && !isLoadingApprovals)
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-5 text-muted">
                                                <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
                                                Hiện tại không có đơn xin nghỉ phép nào đang chờ duyệt.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var p in pendingApprovals)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <strong class="text-dark">@p.EmployeeName</strong>
                                                    <div class="small text-muted font-monospace">@p.EmployeeCode</div>
                                                </td>
                                                <td><span class="emp-badge emp-badge-neutral">@p.DepartmentName</span></td>
                                                <td>
                                                    <div class="small font-monospace tabular-nums">
                                                        @p.StartDate.ToString("dd/MM/yyyy") - @p.EndDate.ToString("dd/MM/yyyy")
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="emp-badge emp-badge-success tabular-nums">@p.DaysCount.ToString("0.#") ngày</span>
                                                </td>
                                                <td class="small text-muted" style="max-width: 250px;">
                                                    <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@p.Reason">
                                                        @p.Reason
                                                    </div>
                                                    @if (p.AttachmentFileId.HasValue)
                                                    {
                                                        <button type="button"
                                                                class="badge bg-light text-primary border text-decoration-none mt-1 d-inline-flex align-items-center gap-1"
                                                                title="Bấm để tải tệp minh chứng"
                                                                @onclick="() => DownloadAttachmentAsync(p.AttachmentFileId.Value, p.AttachmentFileName)">
                                                            <span>📎</span> @(p.AttachmentFileName ?? "Tệp minh chứng")
                                                        </button>
                                                    }
                                                </td>
                                                <td class="small text-muted tabular-nums">
                                                    @p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                </td>
                                                <td class="pe-4 text-end">
                                                    <div class="emp-actions-group justify-content-end">
                                                        <button class="emp-action-btn emp-action-btn-primary"
                                                                disabled="@isProcessingApproval"
                                                                @onclick="() => ApproveLeaveAsync(p.Id)">
                                                            <i class="bi bi-check-lg"></i> Duyệt
                                                        </button>
                                                        <button class="emp-action-btn emp-action-btn-danger"
                                                                disabled="@isProcessingApproval"
                                                                @onclick="() => RejectLeaveAsync(p.Id)">
                                                            <i class="bi bi-x-lg"></i> Từ chối
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-warning border-0 shadow-sm" style="border-radius: 12px;">
                    Bạn không có quyền truy cập chức năng này. Vui lòng liên hệ Admin.
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private IReadOnlyList<PendingLeaveApprovalDto> pendingApprovals = [];
    private LeaveApprovalOptionsDto? approvalOptions;
    private long selectedDepartmentId;
    private string sortBy = "createdAt";
    private string sortDirection = "desc";
    private bool isLoadingApprovals = true;
    private bool isProcessingApproval = false;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingApprovalsAsync();
    }

    private async Task LoadPendingApprovalsAsync()
    {
        isLoadingApprovals = true;
        errorMessage = null;
        try
        {
            approvalOptions = await LeaveApiClient.GetApprovalOptionsAsync();
            if (approvalOptions?.CanApproveAll != true)
            {
                selectedDepartmentId = 0;
                sortBy = "createdAt";
                sortDirection = "desc";
            }
            pendingApprovals = await LeaveApiClient.GetPendingRequestsAsync(
                departmentId: selectedDepartmentId > 0 ? selectedDepartmentId : null, sortBy: sortBy, descending: sortDirection == "desc");
        }
        catch (Exception ex)
        {
            errorMessage = "Không thể tải danh sách đơn chờ duyệt: " + ex.Message;
            approvalOptions = null;
            pendingApprovals = [];
        }
        finally
        {
            isLoadingApprovals = false;
        }
    }

    private async Task ApproveLeaveAsync(Guid id)
    {
        isProcessingApproval = true;
        errorMessage = null;
        try
        {
            await LeaveApiClient.ApproveRequestAsync(id);
            successMessage = "Đã phê duyệt đơn xin nghỉ phép thành công!";
            await LoadPendingApprovalsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isProcessingApproval = false;
        }
    }

    private async Task RejectLeaveAsync(Guid id)
    {
        isProcessingApproval = true;
        errorMessage = null;
        try
        {
            await LeaveApiClient.RejectRequestAsync(id, "Cán bộ quản lý/HR từ chối đơn");
            successMessage = "Đã từ chối đơn xin nghỉ phép.";
            await LoadPendingApprovalsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isProcessingApproval = false;
        }
    }

    private async Task DownloadAttachmentAsync(Guid fileId, string? fileName)
    {
        try
        {
            await FileApiClient.DownloadToBrowserAsync(fileId, fileName);
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi tải tệp minh chứng: " + ex.Message;
        }
    }
}
