@page "/employee/reports"
@page "/reports"
@layout EmployeeLayout
@attribute [Authorize]
@inject NavigationManager Navigation
@inject AdminApiClient AdminApiClient
@inject IReportApiClient ReportApiClient

<PageTitle>@moduleTitle - HRM System</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Hero Banner -->
    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #052e22 0%, #065f46 50%, #047857 100%); color: white; border-radius: 18px; box-shadow: 0 12px 30px rgba(5, 46, 34, 0.25) !important;">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge text-white mb-2 px-3 py-1" style="background-color: #10b981; font-size: 0.85rem; border-radius: 20px; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);">
                    @moduleIcon PHÂN HỆ ĐÃ ĐƯỢC CẤP QUYỀN
                </span>
                <h1 class="h3 fw-bold mb-1 text-white">@moduleTitle</h1>
                <p class="mb-0 text-white-50">@moduleDescription</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-outline-light rounded-pill px-4 py-2" href="employee/attendance">
                    ← Về trang Chấm công
                </a>
            </div>
        </div>
    </div>

    @if (moduleType == ModuleType.Employees)
    {
        <!-- Danh bạ nhân viên -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <strong class="text-dark fs-5">DANH BẠ NHÂN SỰ NỘI BỘ</strong>
                    <div class="text-muted small">Tra cứu thông tin nhân viên theo phân quyền truy cập</div>
                </div>
                <div class="w-auto">
                    <input type="text" class="form-control form-control-sm rounded-pill px-3" placeholder="🔍 Tìm tên hoặc mã nhân viên..."
                           @bind="searchKeyword" @bind:event="oninput" style="min-width: 250px;" />
                </div>
            </div>
            <div class="card-body p-0">
                @if (isLoadingEmployees)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-success" role="status"></div>
                        <div class="text-muted small mt-2">Đang tải danh sách nhân sự...</div>
                    </div>
                }
                else if (filteredEmployees.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <p class="mb-0">Không tìm thấy nhân viên nào phù hợp.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small text-uppercase">
                                <tr>
                                    <th class="ps-4">Mã NV</th>
                                    <th>Họ và tên</th>
                                    <th>Phòng ban</th>
                                    <th>Trạng thái tài khoản</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var emp in filteredEmployees)
                                {
                                    <tr>
                                        <td class="ps-4 font-monospace fw-semibold text-dark">@emp.Code</td>
                                        <td>
                                            <div class="fw-bold text-dark">@emp.FullName</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@emp.Department</span>
                                        </td>
                                        <td>
                                            @if (emp.HasAccount)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Đã có tài khoản</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">Chưa kích hoạt</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else if (moduleType == ModuleType.Reports)
    {
        <!-- Báo cáo & Thống kê Nhân sự -->
        @if (isLoadingReports)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-success" role="status"></div>
                <div class="text-muted small mt-2">Đang tổng hợp dữ liệu báo cáo nhân sự...</div>
            </div>
        }
        else
        {
            <!-- KPI Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px; border-left: 4px solid #10b981 !important;">
                        <div class="text-muted small fw-semibold">TỔNG NHÂN SỰ</div>
                        <div class="d-flex align-items-baseline gap-2 mt-1">
                            <span class="fs-2 fw-bold text-dark">@(summary?.TotalEmployees ?? 0)</span>
                            <span class="text-success small fw-semibold">(@(summary?.ActiveEmployees ?? 0) đang làm)</span>
                        </div>
                        <div class="text-muted small mt-1">@(summary?.ResignedEmployees ?? 0) đã thôi việc</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px; border-left: 4px solid #3b82f6 !important;">
                        <div class="text-muted small fw-semibold">PHÒNG BAN &amp; TỔ CHỨC</div>
                        <div class="d-flex align-items-baseline gap-2 mt-1">
                            <span class="fs-2 fw-bold text-dark">@(summary?.TotalDepartments ?? 0)</span>
                            <span class="text-muted small">phòng ban</span>
                        </div>
                        <div class="text-muted small mt-1">Thâm niên TB: @(tenureReport?.AverageTenureYears ?? 0) năm</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px; border-left: 4px solid #f59e0b !important;">
                        <div class="text-muted small fw-semibold">QUỸ LƯƠNG THÁNG NÀY</div>
                        <div class="d-flex align-items-baseline gap-2 mt-1">
                            <span class="fs-4 fw-bold text-dark">@((summary?.TotalMonthlyPayroll ?? 0).ToString("N0"))</span>
                            <span class="text-muted small">VNĐ</span>
                        </div>
                        <div class="text-muted small mt-1">Theo dữ liệu bảng lương</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px; border-left: 4px solid #8b5cf6 !important;">
                        <div class="text-muted small fw-semibold">CHẤM CÔNG &amp; PHÉP</div>
                        <div class="d-flex align-items-baseline gap-2 mt-1">
                            <span class="fs-2 fw-bold text-dark">@(summary?.TodayAttendanceCount ?? 0)</span>
                            <span class="text-muted small">lượt công hôm nay</span>
                        </div>
                        <div class="text-muted small mt-1">@(summary?.PendingLeaveRequests ?? 0) đơn phép chờ duyệt</div>
                    </div>
                </div>
            </div>

            <!-- Detailed Report Sections -->
            <div class="row g-4">
                <!-- Cơ cấu theo phòng ban -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                        <div class="card-header bg-white border-bottom border-light py-3 px-4">
                            <strong class="text-dark">CƠ CẤU NHÂN SỰ THEO PHÒNG BAN</strong>
                        </div>
                        <div class="card-body p-4">
                            @if (headcountReport?.Departments.Count > 0)
                            {
                                @foreach (var dept in headcountReport.Departments)
                                {
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span class="fw-semibold text-dark">@dept.DepartmentName</span>
                                            <span class="text-muted">@dept.EmployeeCount nhân sự (@dept.Percentage%)</span>
                                        </div>
                                        <div class="progress" style="height: 8px; border-radius: 4px; background-color: #f1f5f9;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @dept.Percentage%;"></div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Chưa có dữ liệu phòng ban.</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Thống kê thâm niên -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                        <div class="card-header bg-white border-bottom border-light py-3 px-4">
                            <strong class="text-dark">PHÂN BỐ THÂM NIÊN CỐNG HIẾN</strong>
                        </div>
                        <div class="card-body p-4">
                            @if (tenureReport?.Groups.Count > 0)
                            {
                                @foreach (var group in tenureReport.Groups)
                                {
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span class="fw-semibold text-dark">@group.GroupLabel</span>
                                            <span class="text-muted">@group.Count nhân sự (@group.Percentage%)</span>
                                        </div>
                                        <div class="progress" style="height: 8px; border-radius: 4px; background-color: #f1f5f9;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @group.Percentage%;"></div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Chưa có dữ liệu thâm niên.</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Phân bổ dải lương -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                        <div class="card-header bg-white border-bottom border-light py-3 px-4">
                            <strong class="text-dark">PHÂN BỐ DẢI LƯƠNG NHÂN VIÊN</strong>
                        </div>
                        <div class="card-body p-4">
                            @if (payrollReport?.SalaryRanges.Count > 0)
                            {
                                @foreach (var range in payrollReport.SalaryRanges)
                                {
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span class="fw-semibold text-dark">@range.RangeLabel</span>
                                            <span class="text-muted">@range.EmployeeCount người (@range.Percentage%)</span>
                                        </div>
                                        <div class="progress" style="height: 8px; border-radius: 4px; background-color: #f1f5f9;">
                                            <div class="progress-bar bg-warning" role="progressbar" style="width: @range.Percentage%;"></div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Chưa có dữ liệu dải lương.</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Trình độ học vấn -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                        <div class="card-header bg-white border-bottom border-light py-3 px-4">
                            <strong class="text-dark">TRÌNH ĐỘ HỌC VẤN &amp; BẰNG CẤP</strong>
                        </div>
                        <div class="card-body p-4">
                            @if (headcountReport?.EducationLevels.Count > 0)
                            {
                                @foreach (var edu in headcountReport.EducationLevels)
                                {
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span class="fw-semibold text-dark">@edu.EducationLevel</span>
                                            <span class="text-muted">@edu.Count nhân sự (@edu.Percentage%)</span>
                                        </div>
                                        <div class="progress" style="height: 8px; border-radius: 4px; background-color: #f1f5f9;">
                                            <div class="progress-bar bg-info" role="progressbar" style="width: @edu.Percentage%;"></div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Chưa có dữ liệu học vấn.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private enum ModuleType { Employees, Reports, Generic }
    private ModuleType moduleType = ModuleType.Generic;
    private string moduleTitle = "Phân hệ Nhân sự";
    private string moduleDescription = "Tính năng được kích hoạt theo phân quyền của Quản trị viên.";
    private string moduleIcon = "👥";

    private IReadOnlyCollection<EmployeeAccountOptionDto> employees = [];
    private bool isLoadingEmployees = false;
    private string searchKeyword = string.Empty;

    // Reports data
    private bool isLoadingReports = false;
    private HrDashboardSummaryDto? summary;
    private HeadcountReportDto? headcountReport;
    private TenureReportDto? tenureReport;
    private PayrollReportDto? payrollReport;

    private IReadOnlyList<EmployeeAccountOptionDto> filteredEmployees =>
        string.IsNullOrWhiteSpace(searchKeyword)
            ? employees.ToList()
            : employees.Where(e => (e.FullName?.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) == true)
                                || (e.Code?.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) == true)
                                || (e.Department?.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) == true)).ToList();

    protected override async Task OnInitializedAsync()
    {
        ResolveModuleFromUri();
        if (moduleType == ModuleType.Employees)
        {
            await LoadEmployeesAsync();
        }
        else if (moduleType == ModuleType.Reports)
        {
            await LoadReportsAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        ResolveModuleFromUri();
        if (moduleType == ModuleType.Employees && employees.Count == 0)
        {
            await LoadEmployeesAsync();
        }
        else if (moduleType == ModuleType.Reports && summary is null)
        {
            await LoadReportsAsync();
        }
    }

    private void ResolveModuleFromUri()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();

        if (path.Contains("employee/directory") || path.Contains("employees"))
        {
            moduleType = ModuleType.Employees;
            moduleTitle = "Tra cứu & Quản lý Danh bạ Nhân sự";
            moduleDescription = "Danh sách nhân viên, phòng ban và trạng thái tài khoản trong hệ thống HRM.";
            moduleIcon = "👥";
        }
        else if (path.Contains("reports"))
        {
            moduleType = ModuleType.Reports;
            moduleTitle = "Trung tâm Báo cáo & Thống kê Nhân sự";
            moduleDescription = "Báo cáo biến động nhân sự, cơ cấu phòng ban, thâm niên và tổng quan quỹ lương.";
            moduleIcon = "📊";
        }
    }

    private async Task LoadEmployeesAsync()
    {
        isLoadingEmployees = true;
        try
        {
            var res = await AdminApiClient.GetEmployeesAsync();
            employees = res?.Data ?? [];
        }
        catch
        {
            employees = [];
        }
        finally
        {
            isLoadingEmployees = false;
        }
    }

    private async Task LoadReportsAsync()
    {
        isLoadingReports = true;
        try
        {
            var summaryTask = ReportApiClient.GetSummaryAsync();
            var headcountTask = ReportApiClient.GetHeadcountReportAsync();
            var tenureTask = ReportApiClient.GetTenureReportAsync();
            var payrollTask = ReportApiClient.GetPayrollReportAsync();

            await Task.WhenAll(summaryTask, headcountTask, tenureTask, payrollTask);

            summary = await summaryTask;
            headcountReport = await headcountTask;
            tenureReport = await tenureTask;
            payrollReport = await payrollTask;
        }
        catch
        {
            // Report API handles errors gracefully
        }
        finally
        {
            isLoadingReports = false;
        }
    }
}
