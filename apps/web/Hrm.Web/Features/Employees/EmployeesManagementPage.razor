    private async Task ExecuteTransferAsync()
    {
        if (transferringEmployee == null) return;

        if (transferTargetDepartmentId <= 0)
        {
            errorMessage = "Vui lòng chọn phòng ban tiếp nhận mới.";
            return;
        }

        if (transferTargetDepartmentId == transferringEmployee.DepartmentId)
        {
            errorMessage = "Phòng ban tiếp nhận mới phải khác phòng ban hiện tại.";
            return;
        }

        if (transferTargetPositionId <= 0)
        {
            errorMessage = "Vui lòng chọn chức danh / vị trí phù hợp tại phòng ban mới.";
            return;
        }

        isSubmittingTransfer = true;
        errorMessage = null;
        try
        {
            var req = new TransferDepartmentRequest(
                TargetDepartmentId: transferTargetDepartmentId,
                TargetPositionId: transferTargetPositionId > 0 ? transferTargetPositionId : null,
                Reason: string.IsNullOrWhiteSpace(transferReason) ? null : transferReason.Trim(),
                EffectiveDate: transferEffectiveDate);

            var res = await EmployeeApiClient.TransferEmployeeAsync(transferringEmployee.Id, req);
            if (res?.Success == true)
            {
                var targetDeptName = departments.FirstOrDefault(d => d.Id == transferTargetDepartmentId)?.Name ?? "mới";
                successMessage = $"Điều chuyển nhân sự '{transferringEmployee.FullName}' sang phòng ban '{targetDeptName}' thành công!";
                CloseTransferModal();
                await LoadDataAsync();
            }
            else
            {
                errorMessage = res?.Error?.Message ?? "Không thể thực hiện điều chuyển phòng ban.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi điều chuyển: " + ex.Message;
        }
        finally
        {
            isSubmittingTransfer = false;
        }
    }

    private void OpenPromoteModal(EmployeeDto emp)
    {
        promotingEmployee = emp;
        promoteTargetPositionId = 0;
        promoteBaseSalary = emp.BaseSalary;
        promoteBaseSalaryDisplay = FormatSalaryNumber(emp.BaseSalary);
        promotePositionAllowance = 0m;
        promoteEffectiveDate = DateOnly.FromDateTime(DateTime.Today);
        promoteReason = string.Empty;
        promoteErrorMessage = null;
        isSubmittingPromote = false;

        var currentRank = PositionHierarchyPolicy.GetPositionRank(emp.PositionName);
        var targetDept = departments.FirstOrDefault(d => d.Id == emp.DepartmentId);
        var eligible = positions
            .Where(p => DepartmentPositionPolicy.IsCompatible(emp.DepartmentId, p.DepartmentId, targetDept?.Code, targetDept?.Name, p.Name, p.Code))
            .Where(p => PositionHierarchyPolicy.GetPositionRank(p.Name, p.Code) > currentRank)
            .OrderBy(p => PositionHierarchyPolicy.GetPositionRank(p.Name, p.Code))
            .FirstOrDefault();

        if (eligible != null)
        {
            promoteTargetPositionId = eligible.Id;
            promotePositionAllowance = eligible.DefaultPositionAllowance;
            promoteNewRoleName = PositionHierarchyPolicy.SuggestRoleForPosition(eligible.Name, targetDept?.Code);
        }

        showPromoteModal = true;
    }

    private void ClosePromoteModal()
    {
        showPromoteModal = false;
        promotingEmployee = null;
        promoteErrorMessage = null;
    }

    private void OnPromotePositionChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var posId))
        {
            promoteTargetPositionId = posId;
            var pos = positions.FirstOrDefault(p => p.Id == posId);
            if (pos != null)
            {
                promotePositionAllowance = pos.DefaultPositionAllowance;
                var targetDept = departments.FirstOrDefault(d => d.Id == promotingEmployee?.DepartmentId);
                promoteNewRoleName = PositionHierarchyPolicy.SuggestRoleForPosition(pos.Name, targetDept?.Code);
            }
        }
    }

    private void OnPromoteBaseSalaryInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var digits = new string(raw.Where(char.IsDigit).ToArray());

        if (string.IsNullOrWhiteSpace(digits))
        {
            promoteBaseSalary = 0m;
            promoteBaseSalaryDisplay = string.Empty;
            return;
        }

        if (decimal.TryParse(digits, out var val))
        {
            if (val > 999_999_999_999m) val = 999_999_999_999m;
            promoteBaseSalary = val;
            promoteBaseSalaryDisplay = FormatSalaryNumber(val);
        }
    }

    private void OnPromoteBaseSalaryBlur()
    {
        if (string.IsNullOrWhiteSpace(promoteBaseSalaryDisplay) || promoteBaseSalary <= 0)
        {
            promoteBaseSalary = 0m;
            promoteBaseSalaryDisplay = "0";
        }
        else
        {
            promoteBaseSalaryDisplay = FormatSalaryNumber(promoteBaseSalary);
        }
    }

    private void AdjustPromoteBaseSalary(decimal delta)
    {
        var newVal = Math.Max(0, promoteBaseSalary + delta);
        if (newVal > 999_999_999_999m) newVal = 999_999_999_999m;
        promoteBaseSalary = newVal;
        promoteBaseSalaryDisplay = FormatSalaryNumber(newVal);
    }

    private async Task ExecutePromoteAsync()
    {
        if (promotingEmployee == null || promoteTargetPositionId <= 0) return;

        if (string.IsNullOrWhiteSpace(promoteReason))
        {
            promoteErrorMessage = "Vui lòng nhập căn cứ hoặc số quyết định bổ nhiệm.";
            return;
        }

        isSubmittingPromote = true;
        promoteErrorMessage = null;
        try
        {
            var req = new PromoteEmployeeRequest(
                TargetPositionId: promoteTargetPositionId,
                NewBaseSalary: promoteBaseSalary,
                NewPositionAllowance: promotePositionAllowance,
                NewRoleName: promotingEmployee.HasAccount ? promoteNewRoleName : null,
                Reason: promoteReason.Trim(),
                EffectiveDate: promoteEffectiveDate);

            var result = await EmployeeApiClient.PromoteEmployeeAsync(promotingEmployee.Id, req);
            if (result?.Success == true)
            {
                var targetPos = positions.FirstOrDefault(p => p.Id == promoteTargetPositionId);
                successMessage = $"Quyết định bổ nhiệm nhân sự '{promotingEmployee.FullName}' lên vị trí '{targetPos?.Name ?? "mới"}' thành công!";
                ClosePromoteModal();
                await LoadDataAsync();
            }
            else
            {
                promoteErrorMessage = result?.Error?.Message ?? "Không thể thực hiện bổ nhiệm nhân sự.";
            }
        }
        catch (Exception ex)
        {
            promoteErrorMessage = "Lỗi khi bổ nhiệm: " + ex.Message;
        }
        finally
        {
            isSubmittingPromote = false;
        }
    }

    private void OpenOffboardModal(EmployeeDto emp)
    {
        offboardingEmployee = emp;
        showOffboardModal = true;
