@page "/employees"
@page "/employee/directory"
@page "/admin/employees"
@layout EmployeeLayout
@attribute [Authorize]
@inject IEmployeeApiClient EmployeeApiClient
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(canWrite ? "Quản trị & Tiếp nhận Nhân sự" : (canManageAny ? "Điều hành & Vận hành Nhân sự" : "Tra cứu Danh bạ Nhân sự")) - HRM System</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Hero Banner -->
    <div class="emp-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="emp-page-header-subtitle d-flex align-items-center gap-2">
                <i class="bi @(canWrite ? "bi-people-fill" : (canManageAny ? "bi-person-gear" : "bi-journal-text")) text-primary"></i>
                <span>@(canWrite 
                    ? "PHÂN HỆ QUẢN TRỊ & TIẾP NHẬN NHÂN SỰ" 
                    : (canManageAny ? "ĐIỀU HÀNH & VẬN HÀNH NHÂN SỰ" : "DANH BẠ LIÊN LẠC NỘI BỘ"))</span>
            </div>
            <h1 class="emp-page-header-title">
                @(canWrite 
                    ? "Quản trị & Tiếp nhận Nhân sự" 
                    : (canManageAny ? "Điều hành & Vận hành Nhân sự" : "Tra cứu Danh bạ Nhân viên"))
            </h1>
            <p class="emp-page-header-desc">
                @(canWrite 
                    ? "Tiếp nhận nhân sự mới (Onboarding), cập nhật hồ sơ cá nhân và quản lý thông tin nhân sự." 
                    : (canManageAny 
                        ? "Thực hiện điều chuyển công tác phòng ban và quy trình thôi việc (Offboarding) kèm thu hồi quyền truy cập." 
                        : "Tra cứu danh sách nhân sự, thông tin liên hệ và phòng ban công tác trong toàn công ty."))
            </p>
        </div>
        @if (canWrite)
        {
            <div class="d-flex align-items-center gap-2">
                <button class="btn emp-btn-primary" @onclick="OpenCreateModal">
                    <i class="bi bi-person-plus-fill me-1"></i> Thêm nhân sự mới
                </button>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46;">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@successMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- KPI Metric Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="@(canWrite ? "col-12 col-sm-6 col-xl-3" : "col-12 col-sm-6")">
            <div class="card emp-kpi-card p-3 h-100">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="emp-kpi-label">Tổng số nhân sự</span>
                    <span class="emp-badge emp-badge-neutral">Toàn công ty</span>
                </div>
                <div class="emp-kpi-value mt-1 tabular-nums">@employees.Count</div>
                <div class="small text-muted mt-1">Nhân sự trong danh bạ công ty</div>
            </div>
        </div>

        <div class="@(canWrite ? "col-12 col-sm-6 col-xl-3" : "col-12 col-sm-6")">
            <div class="card emp-kpi-card p-3 h-100" style="border-left: 4px solid var(--emp-primary) !important;">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="emp-kpi-label text-success fw-bold">Đang làm việc (Active)</span>
                    <span class="emp-badge emp-badge-success">Vận hành</span>
                </div>
                <div class="emp-kpi-value text-success mt-1 tabular-nums">@employees.Count(e => string.Equals(e.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase))</div>
                <div class="small text-muted mt-1">Nhân sự đang công tác thực tế</div>
            </div>
        </div>

        @if (canWrite)
        {
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card emp-kpi-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="emp-kpi-label">Đã thôi việc (Resigned)</span>
                        <span class="emp-badge emp-badge-danger">Offboard</span>
                    </div>
                    <div class="fs-3 fw-bold text-danger font-monospace mt-1 tabular-nums">@employees.Count(e => string.Equals(e.Status, "RESIGNED", StringComparison.OrdinalIgnoreCase))</div>
                    <div class="small text-muted mt-1">Đã khóa tài khoản &amp; thu hồi truy cập</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card emp-kpi-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="emp-kpi-label">Đã cấp tài khoản</span>
                        <span class="emp-badge emp-badge-neutral">Đăng nhập</span>
                    </div>
                    <div class="emp-kpi-value mt-1 tabular-nums">@employees.Count(e => e.HasAccount)</div>
                    <div class="small text-muted mt-1">Có tài khoản User trên hệ thống</div>
                </div>
            </div>
        }
    </div>

    <!-- Toolbar: Search & Filters -->
    <div class="card emp-card mb-4">
        <div class="card-body p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex flex-wrap align-items-center gap-3 flex-grow-1">
                <div style="min-width: 260px;" class="flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0 shadow-none"
                               placeholder="Tìm tên, mã NV, email hoặc SĐT..."
                               @bind="searchKeyword" @bind:event="oninput" />
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <select class="form-select form-select-sm fw-medium" @bind="selectedDepartmentId" style="width: auto; border-radius: 8px;">
                        <option value="0">Tất cả phòng ban</option>
                        @foreach (var dept in departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>

                    <select class="form-select form-select-sm fw-medium" @bind="selectedStatus" style="width: auto; border-radius: 8px;">
                        <option value="">Tất cả trạng thái</option>
                        <option value="ACTIVE">Đang làm việc (ACTIVE)</option>
                        <option value="RESIGNED">Đã thôi việc (RESIGNED)</option>
                    </select>

                    <button class="btn btn-sm emp-btn-secondary" @onclick="LoadDataAsync" disabled="@isLoading">
                        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Onboarding / Create / Edit Modal -->
    @if (showFormModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(3px);">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="modal-header border-bottom py-3 px-4" style="background: linear-gradient(135deg, #065f46 0%, #047857 100%); color: white; border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <h5 class="modal-title fw-bold">
                            @(isEditMode ? "✏️ Chỉnh sửa hồ sơ nhân sự" : "➕ Tiếp nhận nhân sự mới (Onboarding)")
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseFormModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12"><h6 class="fw-bold text-success border-bottom pb-2">1. Thông tin cá nhân</h6></div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" @bind="formFullName" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Mã nhân viên (bỏ trống để tự sinh)</label>
                                <input type="text" class="form-control font-monospace" placeholder="Tự sinh: NV0001..." @bind="formCode" disabled="@isEditMode" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Giới tính</label>
                                <select class="form-select" @bind="formGender">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Ngày sinh</label>
                                <input type="date" class="form-control" @bind="formDateOfBirth" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Số điện thoại</label>
                                <input type="tel" class="form-control" placeholder="090..." @bind="formPhone" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Email liên hệ</label>
                                <input type="email" class="form-control" placeholder="email@company.vn" @bind="formEmail" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Trình độ học vấn</label>
                                <select class="form-select" @bind="formEducationLevel">
                                    <option value="@EducationLevelCatalog.Bachelor">Đại học</option>
                                    <option value="@EducationLevelCatalog.Master">Thạc sĩ</option>
                                    <option value="@EducationLevelCatalog.College">Cao đẳng</option>
                                    <option value="@EducationLevelCatalog.Intermediate">Trung cấp</option>
                                    <option value="@EducationLevelCatalog.Other">Khác</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold">Địa chỉ thường trú / tạm trú</label>
                                <input type="text" class="form-control" placeholder="Số nhà, đường, phường, quận/huyện, tỉnh/thành phố..." @bind="formAddress" />
                            </div>

                            <div class="col-12 mt-4"><h6 class="fw-bold text-success border-bottom pb-2">2. Vị trí công tác &amp; Chế độ đãi ngộ</h6></div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Phòng ban công tác <span class="text-danger">*</span></label>
                                @if (!isEditMode || canTransfer)
                                {
                                    <select class="form-select" value="@formDepartmentId" @onchange="OnFormDepartmentChanged">
                                        <option value="0">-- Chọn phòng ban --</option>
                                        @foreach (var d in departments)
                                        {
                                            <option value="@d.Id">@d.Name (@d.Code)</option>
                                        }
                                    </select>
                                    @if (isEditMode && canTransfer)
                                    {
                                        <div class="form-text small text-success">✓ Bạn có quyền điều chuyển phòng ban.</div>
                                    }
                                }
                                else
                                {
                                    <select class="form-select bg-light text-muted" disabled value="@formDepartmentId">
                                        @foreach (var d in departments)
                                        {
                                            <option value="@d.Id">@d.Name (@d.Code)</option>
                                        }
                                    </select>
                                    <div class="form-text small text-muted">
                                        🔒 Khóa: Cần quyền <strong>"Điều chuyển phòng ban"</strong> để thay đổi đơn vị công tác.
                                    </div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Chức danh / Vị trí</label>
                                @{
                                    var currentDept = departments.FirstOrDefault(d => d.Id == formDepartmentId);
                                    var formPositions = formDepartmentId > 0
                                        ? positions.Where(p => DepartmentPositionPolicy.IsCompatible(currentDept?.Code, currentDept?.Name, p.Name, p.Code)).ToList()
                                        : positions;
                                }
                                <select class="form-select" @bind="formPositionId">
                                    <option value="0">-- Chưa chọn chức vụ --</option>
                                    @foreach (var p in formPositions)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Lương cơ bản (Gross) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted">
                                        <i class="bi bi-cash-stack text-success"></i>
                                    </span>
                                    <input type="text"
                                           class="form-control text-end fw-bold font-monospace"
                                           value="@formBaseSalaryDisplay"
                                           @oninput="OnBaseSalaryInput"
                                           @onblur="OnBaseSalaryBlur"
                                           placeholder="0" />
                                    <span class="input-group-text bg-light text-muted fw-semibold font-monospace">VNĐ</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <div class="small text-muted font-monospace">
                                        @if (formBaseSalary > 0)
                                        {
                                            <span>Quy đổi: <strong class="text-success">@FormatSalaryNumber(formBaseSalary) đ</strong></span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">Vui lòng nhập mức lương &gt; 0</span>
                                        }
                                    </div>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 font-monospace" @onclick="() => AdjustBaseSalary(-500000)" title="Giảm 500.000 VNĐ">-500k</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 font-monospace" @onclick="() => AdjustBaseSalary(500000)" title="Tăng 500.000 VNĐ">+500k</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 font-monospace" @onclick="() => AdjustBaseSalary(1000000)" title="Tăng 1.000.000 VNĐ">+1M</button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Ngày tuyển dụng / Vào làm (hire_date) <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" @bind="formHireDate" />
                            </div>

                            @if (isEditMode)
                            {
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Trạng thái hồ sơ</label>
                                    <div class="p-2 border rounded bg-light d-flex align-items-center justify-content-between">
                                        @if (string.Equals(formStatus, "ACTIVE", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                                ● Đang làm việc (ACTIVE)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1">
                                                ✕ Đã thôi việc (RESIGNED)
                                            </span>
                                        }
                                        <small class="text-muted fst-italic">Muốn thôi việc, dùng nút "Thôi việc" ngoài danh sách</small>
                                    </div>
                                </div>
                            }

                            @if (!isEditMode)
                            {
                                <div class="col-12 mt-4">
                                    <div class="card p-3 border-light bg-light" style="border-radius: 14px;">
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" id="createAccountSwitch" @bind="formCreateAccount">
                                            <label class="form-check-label fw-bold text-dark" for="createAccountSwitch">
                                                Cấp ngay tài khoản đăng nhập hệ thống cho nhân sự này
                                            </label>
                                        </div>

                                        @if (formCreateAccount)
                                        {
                                            <div class="row g-2 mt-2">
                                                <div class="col-md-4">
                                                    <label class="form-label small fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control form-control-sm" placeholder="username" @bind="formUserName" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label small fw-semibold">Mật khẩu tạm <span class="text-danger">*</span></label>
                                                    <input type="password" class="form-control form-control-sm" placeholder="Tối thiểu 6 ký tự" @bind="formPassword" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label small fw-semibold">Vai trò hệ thống</label>
                                                    <select class="form-select form-select-sm" @bind="formRole">
                                                        <option value="EMPLOYEE">EMPLOYEE (Nhân viên)</option>
                                                        <option value="HR_STAFF">HR_STAFF (Nhân sự)</option>
                                                        <option value="MANAGER">MANAGER (Quản lý)</option>
                                                        <option value="ADMIN">ADMIN (Quản trị viên)</option>
                                                    </select>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseFormModal">
                            Hủy bỏ
                        </button>
                        <button type="button" class="btn btn-success rounded-pill px-4 fw-semibold" disabled="@isSubmitting" @onclick="SaveEmployeeAsync">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <span>@(isEditMode ? "Cập nhật hồ sơ" : "Lưu nhân sự")</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal Điều chuyển công tác / Phòng ban -->
    @if (showTransferModal && transferringEmployee != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="modal-header border-bottom px-4 py-3 bg-light" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4">🔄</span>
                            <h5 class="modal-title fw-bold text-dark mb-0">Điều chuyển công tác / Phòng ban</h5>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseTransferModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="card bg-light border-0 p-3 mb-3" style="border-radius: 14px;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                     style="width: 44px; height: 44px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); font-size: 1.1rem; flex-shrink: 0;">
                                    @GetInitial(transferringEmployee.FullName)
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">@transferringEmployee.FullName</h6>
                                    <div class="small text-muted font-monospace">@transferringEmployee.Code · Hiện tại: <strong>@transferringEmployee.DepartmentName</strong></div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Phòng ban tiếp nhận mới <span class="text-danger">*</span></label>
                                <select class="form-select" value="@transferTargetDepartmentId" @onchange="OnTransferTargetDepartmentChanged">
                                    <option value="0">-- Chọn phòng ban tiếp nhận --</option>
                                    @foreach (var d in departments)
                                    {
                                        if (d.Id != transferringEmployee.DepartmentId)
                                        {
                                            <option value="@d.Id">@d.Name (@d.Code)</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold">Chức danh / Vị trí mới tại phòng ban đích <span class="text-danger">*</span></label>
                                @if (transferTargetDepartmentId <= 0)
                                {
                                    <select class="form-select bg-light text-muted" disabled>
                                        <option value="0">-- Vui lòng chọn phòng ban tiếp nhận trước --</option>
                                    </select>
                                    <div class="form-text small text-muted">Chức danh chuyên môn sẽ được lọc tự động theo phòng ban tiếp nhận.</div>
                                }
                                else
                                {
                                    var targetDept = departments.FirstOrDefault(d => d.Id == transferTargetDepartmentId);
                                    var filteredPositions = positions.Where(p => DepartmentPositionPolicy.IsCompatible(targetDept?.Code, targetDept?.Name, p.Name, p.Code)).ToList();

                                    <select class="form-select" @bind="transferTargetPositionId">
                                        <option value="0">-- Chọn chức vụ phù hợp tại phòng ban mới (*) --</option>
                                        @foreach (var p in filteredPositions)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                    @if (filteredPositions.Count == 0)
                                    {
                                        <div class="form-text small text-warning">⚠️ Chưa có chức danh tương thích riêng cho phòng ban này trong hệ thống.</div>
                                    }
                                    else
                                    {
                                        <div class="form-text small text-success">✓ Hệ thống tự động lọc danh mục chức vụ phù hợp với @targetDept?.Name.</div>
                                    }
                                }
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold">Ngày có hiệu lực</label>
                                <input type="date" class="form-control" @bind="transferEffectiveDate" />
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold">Căn cứ / Lý do điều chuyển (Số quyết định...)</label>
                                <textarea class="form-control" rows="2" placeholder="Ví dụ: Theo Quyết định số 28/QĐ-NS điều động nhân sự dự án..." @bind="transferReason"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseTransferModal">
                            Hủy bỏ
                        </button>
                        <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" disabled="@isSubmittingTransfer" @onclick="ExecuteTransferAsync">
                            @if (isSubmittingTransfer)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Đang xử lý...</span>
                            }
                            else
                            {
                                <span>Xác nhận điều chuyển</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal Xác nhận Thôi việc (Offboarding) -->
    @if (showOffboardModal && offboardingEmployee != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="modal-header border-bottom px-4 py-3 bg-danger-subtle text-danger" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4">⚠️</span>
                            <h5 class="modal-title fw-bold mb-0">Xác nhận Thôi việc & Thu hồi Quyền</h5>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseOffboardModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        <p class="text-secondary mb-3">
                            Bạn đang chuẩn bị thực hiện quyết định thôi việc cho nhân sự sau:
                        </p>

                        <div class="card bg-light border-0 p-3 mb-3" style="border-radius: 14px;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                     style="width: 44px; height: 44px; background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); font-size: 1.1rem; flex-shrink: 0;">
                                    @GetInitial(offboardingEmployee.FullName)
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">@offboardingEmployee.FullName</h6>
                                    <div class="small text-muted font-monospace">@offboardingEmployee.Code · Phòng: @offboardingEmployee.DepartmentName</div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning border-0 d-flex align-items-start gap-2 mb-0" style="border-radius: 12px; font-size: 0.9rem;">
                            <span class="fs-5">🔒</span>
                            <div>
                                <strong>Cảnh báo an ninh nhân sự:</strong><br />
                                Hành động này sẽ chuyển trạng thái của nhân sự sang <strong>RESIGNED</strong>, đồng thời <strong>lập tức vô hiệu hóa tài khoản và thu hồi toàn bộ phiên đăng nhập (Refresh Token)</strong> của nhân sự này trên toàn hệ thống.
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseOffboardModal">
                            Hủy bỏ
                        </button>
                        <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm" disabled="@isSubmittingOffboard" @onclick="ExecuteOffboardAsync">
                            @if (isSubmittingOffboard)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Đang xử lý...</span>
                            }
                            else
                            {
                                <span>✕ Xác nhận thôi việc</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Employee Table -->
    <div class="card emp-card">
        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center justify-content-center rounded-3 shadow-2xs" 
                     style="width: 40px; height: 40px; background: rgba(15, 118, 110, 0.1); color: var(--emp-primary); flex-shrink: 0;">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
                <div>
                    <strong class="text-dark fs-6 text-uppercase fw-bold" style="letter-spacing: 0.5px;">@(canWrite ? "Danh Sách Quản Trị Hồ Sơ Nhân Sự" : "Danh Bạ Liên Lạc Cán Bộ Nhân Viên")</strong>
                    <div class="text-muted small mt-0.5">
                        @(canWrite 
                            ? $"Hiển thị {pagedEmployees.Count} / {filteredEmployees.Count} hồ sơ nhân sự toàn công ty" 
                            : $"Hiển thị {pagedEmployees.Count} / {filteredEmployees.Count} nhân sự · Tra cứu nhanh số điện thoại và email nội bộ")
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="text-muted small mt-2">Đang tải hồ sơ nhân sự...</div>
                </div>
            }
            else if (filteredEmployees.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-person-x fs-1 text-muted d-block mb-2"></i>
                    <p class="mb-0">Không tìm thấy nhân viên nào phù hợp tiêu chí lọc.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table emp-table align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase">
                            <tr>
                                <th class="ps-4">Nhân sự</th>
                                <th>Chức vụ &amp; Phòng ban</th>
                                <th>Thông tin liên hệ</th>
                                <th>Trạng thái &amp; Tài khoản</th>
                                @if (canWrite)
                                {
                                    <th>Lương Gross</th>
                                }
                                @if (canManageAny)
                                {
                                    <th class="pe-4 text-end">Thao tác</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < pagedEmployees.Count; i++)
                            {
                                var emp = pagedEmployees[i];
                                var isBottomRow = i >= pagedEmployees.Count - 2 && pagedEmployees.Count > 3;
                                <tr class="emp-table-row">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-2xs @(canWrite ? "cursor-pointer" : "")"
                                                 style="width: 38px; height: 38px; background: linear-gradient(135deg, var(--emp-primary) 0%, var(--emp-primary-hover) 100%); font-size: 0.9rem; flex-shrink: 0;"
                                                 @onclick="() => { if (canWrite) OpenEditModal(emp); }"
                                                 title="@(canWrite ? "Bấm để xem và chỉnh sửa hồ sơ" : "")">
                                                @GetInitial(emp.FullName)
                                            </div>
                                            <div>
                                                @if (canWrite)
                                                {
                                                    <a href="javascript:void(0)" class="fw-bold text-dark text-decoration-none hover-primary text-nowrap d-inline-block"
                                                       @onclick="() => OpenEditModal(emp)"
                                                       title="Bấm để xem và chỉnh sửa hồ sơ">
                                                        @emp.FullName
                                                    </a>
                                                }
                                                else
                                                {
                                                    <div class="fw-bold text-dark text-nowrap">@emp.FullName</div>
                                                }
                                                <div class="small text-muted font-monospace text-nowrap mt-0.5">@emp.Code</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark text-nowrap" style="font-size: 0.88rem;">
                                            @(emp.PositionName ?? "Chưa phân chức vụ")
                                        </div>
                                        <div class="mt-1">
                                            <span class="emp-badge emp-badge-neutral py-0.5" style="font-size: 0.72rem;">
                                                @emp.DepartmentName
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-dark text-nowrap d-flex align-items-center gap-1.5">
                                            <i class="bi bi-envelope text-muted"></i>
                                            <span>@(emp.Email ?? "Chưa có")</span>
                                        </div>
                                        <div class="small text-muted font-monospace tabular-nums text-nowrap d-flex align-items-center gap-1.5 mt-0.5">
                                            <i class="bi bi-telephone text-muted"></i>
                                            <span>@(emp.Phone ?? "Chưa có")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            @if (string.Equals(emp.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="emp-badge emp-badge-success py-0.5">
                                                    <span class="emp-status-dot"></span> Đang làm việc
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="emp-badge emp-badge-danger py-0.5">
                                                    <span class="emp-status-dot"></span> Đã thôi việc
                                                </span>
                                            }
                                        </div>
                                        <div class="mt-1">
                                            @if (emp.HasAccount)
                                            {
                                                <span class="small text-muted text-nowrap d-inline-flex align-items-center gap-1" style="font-size: 0.73rem;">
                                                    <i class="bi bi-person-check-fill text-success"></i> Đã có tài khoản
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="small text-secondary text-nowrap d-inline-flex align-items-center gap-1" style="font-size: 0.73rem;">
                                                    <i class="bi bi-person-dash text-muted"></i> Chưa cấp User
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    @if (canWrite)
                                    {
                                        <td>
                                            <div class="font-monospace fw-bold tabular-nums text-nowrap" style="color: var(--emp-primary); font-size: 0.92rem;">
                                                @FormatVnd(emp.BaseSalary)
                                            </div>
                                            <div class="small text-muted" style="font-size: 0.72rem;">Lương cơ bản</div>
                                        </td>
                                    }
                                    @if (canManageAny)
                                    {
                                        <td class="pe-4 text-end">
                                            <div class="emp-actions-group justify-content-end position-relative">
                                                @if (canWrite)
                                                {
                                                    <button class="emp-action-btn emp-action-btn-edit"
                                                            title="Xem và chỉnh sửa hồ sơ"
                                                            @onclick="() => { CloseActionMenu(); OpenEditModal(emp); }">
                                                        <i class="bi bi-pencil-square"></i> Sửa
                                                    </button>
                                                }

                                                @if ((canTransfer || canOffboard) && string.Equals(emp.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="position-relative d-inline-block">
                                                        <button class="emp-action-btn emp-action-btn-more @(activeActionMenuId == emp.Id ? "active" : "")"
                                                                title="Thao tác khác"
                                                                @onclick="() => ToggleActionMenu(emp.Id)">
                                                            <i class="bi bi-three-dots"></i>
                                                        </button>

                                                        @if (activeActionMenuId == emp.Id)
                                                        {
                                                            <div class="emp-action-dropdown-backdrop" @onclick="CloseActionMenu"></div>
                                                            <div class="emp-action-dropdown-menu @(isBottomRow ? "dropup" : "dropdown") shadow-lg">
                                                                @if (canTransfer)
                                                                {
                                                                    <button type="button" class="emp-action-dropdown-item"
                                                                            @onclick="() => { CloseActionMenu(); OpenTransferModal(emp); }">
                                                                        <i class="bi bi-arrow-left-right text-info"></i>
                                                                        <span>Điều chuyển phòng ban</span>
                                                                    </button>
                                                                }
                                                                @if (canOffboard)
                                                                {
                                                                    @if (canTransfer)
                                                                    {
                                                                        <div class="emp-action-dropdown-divider"></div>
                                                                    }
                                                                    <button type="button" class="emp-action-dropdown-item emp-action-dropdown-item-danger"
                                                                            @onclick="() => { CloseActionMenu(); OpenOffboardModal(emp); }">
                                                                        <i class="bi bi-person-x text-danger"></i>
                                                                        <span>Thực hiện thôi việc</span>
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="small text-muted">
                            Trang <strong>@currentPage</strong> / <strong>@totalPages</strong> (Tổng số <strong>@filteredEmployees.Count</strong> nhân sự)
                        </div>

                        <nav aria-label="Employee list pagination">
                            <ul class="pagination pagination-sm mb-0 pagination-custom">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(1)">« Đầu</button>
                                </li>
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">‹ Trước</button>
                                </li>

                                @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                                {
                                    var pageNumber = p;
                                    <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                                    </li>
                                }

                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Sau ›</button>
                                </li>
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(totalPages)">Cuối »</button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<EmployeeDto> employees = [];
    private IReadOnlyList<DepartmentDto> departments = [];
    private IReadOnlyList<PositionDto> positions = [];

    private string searchKeyword = string.Empty;
    private long selectedDepartmentId = 0;
    private string selectedStatus = string.Empty;

    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? successMessage;
    private string? errorMessage;

    // Pagination
    private int currentPage = 1;
    private const int pageSize = 10;

    // Form Modal state
    private bool showFormModal = false;
    private bool isEditMode = false;
    private long editingEmployeeId = 0;

    private string formFullName = string.Empty;
    private string formCode = string.Empty;
    private string formGender = "Nam";
    private DateOnly? formDateOfBirth = new DateOnly(1995, 1, 1);
    private string formPhone = string.Empty;
    private string formEmail = string.Empty;
    private string formAddress = string.Empty;
    private string formEducationLevel = "Đại học";
    private long formDepartmentId = 0;
    private long formPositionId = 0;
    private decimal formBaseSalary = 10000000m;
    private string formBaseSalaryDisplay = "10.000.000";
    private DateOnly? formHireDate = DateOnly.FromDateTime(DateTime.Today);
    private string formStatus = "ACTIVE";

    // Account creation fields
    private bool formCreateAccount = false;
    private string formUserName = string.Empty;
    private string formPassword = string.Empty;
    private string formRole = "EMPLOYEE";

    private bool canWrite = false;
    private bool canTransfer = false;
    private bool canOffboard = false;
    private bool canManageAny => canWrite || canTransfer || canOffboard;

    // Transfer Modal state
    private bool showTransferModal = false;
    private EmployeeDto? transferringEmployee = null;
    private long transferTargetDepartmentId = 0;
    private long transferTargetPositionId = 0;
    private DateOnly? transferEffectiveDate = DateOnly.FromDateTime(DateTime.Today);
    private string transferReason = string.Empty;
    private bool isSubmittingTransfer = false;

    // Offboard Modal state
    private bool showOffboardModal = false;
    private EmployeeDto? offboardingEmployee = null;
    private bool isSubmittingOffboard = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var isAdmin = user.IsInRole("ADMIN");
        canWrite = isAdmin
            || user.HasClaim("permission", PermissionCodes.EmployeeWrite)
            || user.HasClaim("permission", "EMP_EDIT");
        canTransfer = isAdmin
            || user.HasClaim("permission", PermissionCodes.EmployeeTransfer)
            || user.HasClaim("permission", "EMP_TRANSFER");
        canOffboard = isAdmin
            || user.HasClaim("permission", PermissionCodes.EmployeeOffboard)
            || user.HasClaim("permission", "EMP_OFFBOARD");

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            departments = await EmployeeApiClient.GetDepartmentsAsync();
            positions = await EmployeeApiClient.GetPositionsAsync();
            employees = await EmployeeApiClient.GetEmployeesAsync(
                departmentId: selectedDepartmentId > 0 ? selectedDepartmentId : null,
                status: !string.IsNullOrWhiteSpace(selectedStatus) ? selectedStatus : null);
            currentPage = 1;
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi tải danh sách nhân sự: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private IReadOnlyList<EmployeeDto> filteredEmployees =>
        employees.Where(e =>
            (string.IsNullOrWhiteSpace(searchKeyword) ||
             (e.FullName?.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) == true) ||
             (e.Code?.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) == true) ||
             (e.Email?.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) == true) ||
             (e.Phone?.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) == true))
            && (selectedDepartmentId <= 0 || e.DepartmentId == selectedDepartmentId)
            && (string.IsNullOrWhiteSpace(selectedStatus) || string.Equals(e.Status, selectedStatus, StringComparison.OrdinalIgnoreCase))
        ).ToList();

    private int totalPages => Math.Max(1, (int)Math.Ceiling(filteredEmployees.Count / (double)pageSize));

    private IReadOnlyList<EmployeeDto> pagedEmployees =>
        filteredEmployees.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        editingEmployeeId = 0;
        formFullName = string.Empty;
        formCode = string.Empty;
        formGender = "Nam";
        formDateOfBirth = new DateOnly(1995, 1, 1);
        formPhone = string.Empty;
        formEmail = string.Empty;
        formAddress = string.Empty;
        formEducationLevel = EducationLevelCatalog.Bachelor;
        formDepartmentId = departments.FirstOrDefault()?.Id ?? 0;
        formPositionId = positions.FirstOrDefault()?.Id ?? 0;
        formBaseSalary = 10000000m;
        formBaseSalaryDisplay = FormatSalaryNumber(formBaseSalary);
        formHireDate = DateOnly.FromDateTime(DateTime.Today);
        formStatus = "ACTIVE";
        formCreateAccount = false;
        formUserName = string.Empty;
        formPassword = string.Empty;
        formRole = "EMPLOYEE";
        showFormModal = true;
    }

    private void OpenEditModal(EmployeeDto emp)
    {
        isEditMode = true;
        editingEmployeeId = emp.Id;
        formFullName = emp.FullName;
        formCode = emp.Code;
        formGender = emp.Gender ?? "Nam";
        formDateOfBirth = emp.DateOfBirth;
        formPhone = emp.Phone ?? string.Empty;
        formEmail = emp.Email ?? string.Empty;
        formAddress = emp.Address ?? string.Empty;
        formEducationLevel = EducationLevelCatalog.Normalize(emp.EducationLevel);
        formDepartmentId = emp.DepartmentId;
        formPositionId = emp.PositionId ?? 0;
        formBaseSalary = emp.BaseSalary;
        formBaseSalaryDisplay = FormatSalaryNumber(formBaseSalary);
        formHireDate = emp.HireDate;
        formStatus = emp.Status;
        formCreateAccount = false;
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        showFormModal = false;
    }

    private async Task SaveEmployeeAsync()
    {
        if (string.IsNullOrWhiteSpace(formFullName))
        {
            errorMessage = "Vui lòng nhập Họ và tên nhân viên.";
            return;
        }

        if (formDepartmentId <= 0)
        {
            errorMessage = "Vui lòng chọn phòng ban cho nhân sự.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(formBaseSalaryDisplay))
        {
            var digits = new string(formBaseSalaryDisplay.Where(char.IsDigit).ToArray());
            if (decimal.TryParse(digits, out var parsed))
            {
                formBaseSalary = parsed;
            }
        }

        if (formBaseSalary < 0)
        {
            errorMessage = "Mức lương cơ bản không thể âm.";
            return;
        }

        if (!isEditMode && formCreateAccount)
        {
            if (string.IsNullOrWhiteSpace(formUserName))
            {
                errorMessage = "Vui lòng nhập tên đăng nhập.";
                return;
            }
            if (string.IsNullOrWhiteSpace(formPassword) || formPassword.Length < 6)
            {
                errorMessage = "Mật khẩu tạm phải có ít nhất 6 ký tự.";
                return;
            }
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (isEditMode)
            {
                var req = new UpdateEmployeeRequest(
                    FullName: formFullName,
                    DepartmentId: formDepartmentId,
                    PositionId: formPositionId > 0 ? formPositionId : null,
                    DateOfBirth: formDateOfBirth,
                    Gender: formGender,
                    Phone: formPhone,
                    Email: formEmail,
                    Address: formAddress,
                    EducationLevel: formEducationLevel,
                    BaseSalary: formBaseSalary,
                    HireDate: formHireDate,
                    Status: formStatus);

                var res = await EmployeeApiClient.UpdateEmployeeAsync(editingEmployeeId, req);
                if (res?.Success == true)
                {
                    successMessage = $"Cập nhật hồ sơ nhân sự '{formFullName}' thành công!";
                    showFormModal = false;
                    await LoadDataAsync();
                }
                else
                {
                    errorMessage = res?.Error?.Message ?? "Không thể cập nhật hồ sơ.";
                }
            }
            else
            {
                var req = new CreateEmployeeRequest(
                    FullName: formFullName,
                    Code: string.IsNullOrWhiteSpace(formCode) ? null : formCode.Trim(),
                    DepartmentId: formDepartmentId,
                    PositionId: formPositionId > 0 ? formPositionId : null,
                    DateOfBirth: formDateOfBirth,
                    Gender: formGender,
                    Phone: formPhone,
                    Email: formEmail,
                    Address: formAddress,
                    EducationLevel: formEducationLevel,
                    BaseSalary: formBaseSalary,
                    HireDate: formHireDate,
                    CreateAccount: formCreateAccount,
                    UserName: formCreateAccount ? formUserName : null,
                    Password: formCreateAccount ? formPassword : null,
                    Role: formCreateAccount ? formRole : null);

                var res = await EmployeeApiClient.CreateEmployeeAsync(req);
                if (res?.Success == true)
                {
                    successMessage = $"Tiếp nhận nhân sự mới '{res.Data?.FullName}' (Mã: {res.Data?.Code}) thành công!";
                    showFormModal = false;
                    await LoadDataAsync();
                }
                else
                {
                    errorMessage = res?.Error?.Message ?? "Không thể tiếp nhận nhân sự mới.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Đã xảy ra lỗi: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OnFormDepartmentChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var deptId))
        {
            formDepartmentId = deptId;
            var dept = departments.FirstOrDefault(d => d.Id == deptId);
            var validPositions = positions.Where(p => DepartmentPositionPolicy.IsCompatible(dept?.Code, dept?.Name, p.Name, p.Code)).ToList();
            if (!validPositions.Any(p => p.Id == formPositionId))
            {
                formPositionId = validPositions.FirstOrDefault()?.Id ?? 0;
            }
        }
    }

    private void OnTransferTargetDepartmentChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var deptId))
        {
            transferTargetDepartmentId = deptId;
            transferTargetPositionId = 0; // RESET BẮT BUỘC KHI ĐỔI PHÒNG BAN!
        }
        else
        {
            transferTargetDepartmentId = 0;
            transferTargetPositionId = 0;
        }
    }

    private void OpenTransferModal(EmployeeDto emp)
    {
        transferringEmployee = emp;
        transferTargetDepartmentId = 0;
        transferTargetPositionId = 0; // Không giữ nguyên chức vụ cũ của phòng cũ!
        transferEffectiveDate = DateOnly.FromDateTime(DateTime.Today);
        transferReason = string.Empty;
        showTransferModal = true;
    }

    private void CloseTransferModal()
    {
        showTransferModal = false;
        transferringEmployee = null;
    }

    private async Task ExecuteTransferAsync()
    {
        if (transferringEmployee == null) return;

        if (transferTargetDepartmentId <= 0)
        {
            errorMessage = "Vui lòng chọn phòng ban tiếp nhận mới.";
            return;
        }

        if (transferTargetDepartmentId == transferringEmployee.DepartmentId)
        {
            errorMessage = "Phòng ban tiếp nhận mới phải khác phòng ban hiện tại.";
            return;
        }

        if (transferTargetPositionId <= 0)
        {
            errorMessage = "Vui lòng chọn chức danh / vị trí phù hợp tại phòng ban mới.";
            return;
        }

        isSubmittingTransfer = true;
        errorMessage = null;
        try
        {
            var req = new TransferDepartmentRequest(
                TargetDepartmentId: transferTargetDepartmentId,
                TargetPositionId: transferTargetPositionId > 0 ? transferTargetPositionId : null,
                Reason: string.IsNullOrWhiteSpace(transferReason) ? null : transferReason.Trim(),
                EffectiveDate: transferEffectiveDate);

            var res = await EmployeeApiClient.TransferEmployeeAsync(transferringEmployee.Id, req);
            if (res?.Success == true)
            {
                var targetDeptName = departments.FirstOrDefault(d => d.Id == transferTargetDepartmentId)?.Name ?? "mới";
                successMessage = $"Điều chuyển nhân sự '{transferringEmployee.FullName}' sang phòng ban '{targetDeptName}' thành công!";
                CloseTransferModal();
                await LoadDataAsync();
            }
            else
            {
                errorMessage = res?.Error?.Message ?? "Không thể thực hiện điều chuyển phòng ban.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi điều chuyển: " + ex.Message;
        }
        finally
        {
            isSubmittingTransfer = false;
        }
    }

    private void OpenOffboardModal(EmployeeDto emp)
    {
        offboardingEmployee = emp;
        showOffboardModal = true;
    }

    private void CloseOffboardModal()
    {
        showOffboardModal = false;
        offboardingEmployee = null;
    }

    private async Task ExecuteOffboardAsync()
    {
        if (offboardingEmployee == null) return;

        isSubmittingOffboard = true;
        errorMessage = null;
        try
        {
            var ok = await EmployeeApiClient.OffboardEmployeeAsync(offboardingEmployee.Id);
            if (ok)
            {
                successMessage = $"Đã hoàn tất thôi việc (Offboard) cho nhân sự '{offboardingEmployee.FullName}'. Toàn bộ tài khoản và quyền truy cập đã được thu hồi.";
                CloseOffboardModal();
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi thực hiện thôi việc: " + ex.Message;
        }
        finally
        {
            isSubmittingOffboard = false;
        }
    }

    private static readonly System.Globalization.CultureInfo viCulture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");

    private static string FormatSalaryNumber(decimal value) => value.ToString("#,##0", viCulture);

    private void OnBaseSalaryInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var digits = new string(raw.Where(char.IsDigit).ToArray());

        if (string.IsNullOrWhiteSpace(digits))
        {
            formBaseSalary = 0m;
            formBaseSalaryDisplay = string.Empty;
            return;
        }

        if (decimal.TryParse(digits, out var val))
        {
            if (val > 999_999_999_999m) val = 999_999_999_999m;
            formBaseSalary = val;
            formBaseSalaryDisplay = FormatSalaryNumber(val);
        }
    }

    private void OnBaseSalaryBlur()
    {
        if (string.IsNullOrWhiteSpace(formBaseSalaryDisplay) || formBaseSalary <= 0)
        {
            formBaseSalary = 0m;
            formBaseSalaryDisplay = "0";
        }
        else
        {
            formBaseSalaryDisplay = FormatSalaryNumber(formBaseSalary);
        }
    }

    private void AdjustBaseSalary(decimal delta)
    {
        var newVal = Math.Max(0, formBaseSalary + delta);
        if (newVal > 999_999_999_999m) newVal = 999_999_999_999m;
        formBaseSalary = newVal;
        formBaseSalaryDisplay = FormatSalaryNumber(newVal);
    }

    private static string FormatVnd(decimal amount) => amount.ToString("#,##0", viCulture) + " ₫";

    private long? activeActionMenuId = null;

    private void ToggleActionMenu(long empId)
    {
        activeActionMenuId = activeActionMenuId == empId ? null : empId;
    }

    private void CloseActionMenu()
    {
        activeActionMenuId = null;
    }

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts[^1][0].ToString().ToUpperInvariant();
    }
}
