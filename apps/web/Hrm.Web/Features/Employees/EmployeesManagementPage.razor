    private async Task SaveEmployeeAsync()
    {
        if (string.IsNullOrWhiteSpace(formFullName))
        {
            errorMessage = "Vui lòng nhập Họ và tên nhân viên.";
            return;
        }

        if (formDepartmentId <= 0)
        {
            errorMessage = "Vui lòng chọn phòng ban cho nhân sự.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(formBaseSalaryDisplay))
        {
            var digits = new string(formBaseSalaryDisplay.Where(char.IsDigit).ToArray());
            if (decimal.TryParse(digits, out var parsed))
            {
                formBaseSalary = parsed;
            }
        }

        if (formBaseSalary < 0)
        {
            errorMessage = "Mức lương cơ bản không thể âm.";
            return;
        }

        if (formPositionId > 0)
        {
            var dept = departments.FirstOrDefault(d => d.Id == formDepartmentId);
            var pos = positions.FirstOrDefault(p => p.Id == formPositionId);
            if (dept != null && pos != null && !DepartmentPositionPolicy.IsCompatible(formDepartmentId, pos.DepartmentId, dept.Code, dept.Name, pos.Name, pos.Code))
            {
                errorMessage = $"Chức danh '{pos.Name}' không phù hợp với '{dept.Name}'. Vui lòng chọn chức vụ thuộc chuyên môn của phòng ban.";
                return;
            }
        }

        if (!isEditMode && formCreateAccount)
        {
            if (string.IsNullOrWhiteSpace(formUserName))
            {
                errorMessage = "Vui lòng nhập tên đăng nhập.";
                return;
            }
            if (string.IsNullOrWhiteSpace(formPassword))
            {
                errorMessage = "Vui lòng nhập mật khẩu tạm.";
                return;
            }
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (isEditMode)
            {
                var req = new UpdateEmployeeRequest(
                    FullName: formFullName,
                    DepartmentId: formDepartmentId,
                    PositionId: formPositionId > 0 ? formPositionId : null,
                    DateOfBirth: formDateOfBirth,
                    Gender: formGender,
                    Phone: formPhone,
                    Email: formEmail,
                    Address: formAddress,
                    EducationLevel: formEducationLevel,
                    BaseSalary: formBaseSalary,
                    HireDate: formHireDate,
                    Status: formStatus,
                    PositionAllowance: formPositionAllowance,
                    OtherAllowance: formOtherAllowance,
                    InsuranceSalary: formInsuranceSalary,
                    DependentCount: formDependentCount,
                    BankName: formBankName,
                    BankAccountNumber: formBankAccountNumber,
                    SalaryChangeNote: formSalaryChangeNote,
                    ManagerId: formManagerId > 0 ? formManagerId : null);

                var res = await EmployeeApiClient.UpdateEmployeeAsync(editingEmployeeId, req);
                if (res?.Success == true)
                {
                    successMessage = $"Cập nhật hồ sơ nhân sự '{formFullName}' thành công!";
                    showFormModal = false;
                    await LoadDataAsync();
                }
                else
                {
                    errorMessage = res?.Error?.Message ?? "Không thể cập nhật hồ sơ.";
                }
            }
            else
            {
                var req = new CreateEmployeeRequest(
                    FullName: formFullName,
                    Code: string.IsNullOrWhiteSpace(formCode) ? null : formCode.Trim(),
                    DepartmentId: formDepartmentId,
                    PositionId: formPositionId > 0 ? formPositionId : null,
                    DateOfBirth: formDateOfBirth,
                    Gender: formGender,
                    Phone: formPhone,
                    Email: formEmail,
                    Address: formAddress,
                    EducationLevel: formEducationLevel,
                    BaseSalary: formBaseSalary,
                    HireDate: formHireDate,
                    CreateAccount: formCreateAccount,
                    UserName: formCreateAccount ? formUserName : null,
                    Password: formCreateAccount ? formPassword : null,
                    Role: formCreateAccount ? formRole : null,
                    PositionAllowance: formPositionAllowance,
                    OtherAllowance: formOtherAllowance,
                    InsuranceSalary: formInsuranceSalary,
                    DependentCount: formDependentCount,
                    BankName: formBankName,
                    BankAccountNumber: formBankAccountNumber,
                    ManagerId: formManagerId > 0 ? formManagerId : null);

                var res = await EmployeeApiClient.CreateEmployeeAsync(req);
                if (res?.Success == true)
                {
                    successMessage = $"Tiếp nhận nhân sự mới '{res.Data?.FullName}' (Mã: {res.Data?.Code}) thành công!";
                    showFormModal = false;
                    await LoadDataAsync();
                }
                else
                {
                    errorMessage = res?.Error?.Message ?? "Không thể tiếp nhận nhân sự mới.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Đã xảy ra lỗi: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OnFormDepartmentChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var deptId))
        {
            formDepartmentId = deptId;
            var dept = departments.FirstOrDefault(d => d.Id == deptId);
            var validPositions = positions.Where(p => DepartmentPositionPolicy.IsCompatible(deptId, p.DepartmentId, dept?.Code, dept?.Name, p.Name, p.Code)).ToList();
            if (!validPositions.Any(p => p.Id == formPositionId))
            {
                var nextPos = validPositions.FirstOrDefault();
                formPositionId = nextPos?.Id ?? 0;
                if (!isEditMode && nextPos != null && nextPos.DefaultPositionAllowance > 0)
                {
                    formPositionAllowance = nextPos.DefaultPositionAllowance;
                }
            }
        }
    }

    private void OnFormPositionChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var posId))
        {
            formPositionId = posId;
            if (!isEditMode)
            {
                var pos = positions.FirstOrDefault(p => p.Id == posId);
                if (pos != null && pos.DefaultPositionAllowance > 0)
                {
                    formPositionAllowance = pos.DefaultPositionAllowance;
                }
            }
        }
    }

