@page "/employees"
@page "/employee/directory"
@layout EmployeeLayout
@attribute [Authorize]
@inject IEmployeeApiClient EmployeeApiClient
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(canWrite ? "Quản trị & Tiếp nhận Nhân sự" : (canManageAny ? "Điều hành & Vận hành Nhân sự" : "Tra cứu Danh bạ Nhân sự")) - HRM System</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Hero Banner -->
    <div class="emp-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="emp-page-header-subtitle d-flex align-items-center gap-2">
                <i class="bi @(canWrite ? "bi-people-fill" : (canManageAny ? "bi-person-gear" : "bi-journal-text")) text-primary"></i>
                <span>@(canWrite 
                    ? "PHÂN HỆ QUẢN TRỊ & TIẾP NHẬN NHÂN SỰ" 
                    : (canManageAny ? "ĐIỀU HÀNH & VẬN HÀNH NHÂN SỰ" : "DANH BẠ LIÊN LẠC NỘI BỘ"))</span>
            </div>
            <h1 class="emp-page-header-title">
                @(canWrite 
                    ? "Quản trị & Tiếp nhận Nhân sự" 
                    : (canManageAny ? "Điều hành & Vận hành Nhân sự" : "Tra cứu Danh bạ Nhân viên"))
            </h1>
            <p class="emp-page-header-desc">
                @(canWrite 
                    ? "Tiếp nhận nhân sự mới (Onboarding), cập nhật hồ sơ cá nhân, quản lý danh mục phòng ban - chức danh và lịch sử nhân sự." 
                    : (canManageAny 
                        ? "Thực hiện điều chuyển công tác phòng ban và quy trình thôi việc (Offboarding) kèm thu hồi quyền truy cập." 
                        : "Tra cứu danh sách nhân sự, thông tin liên hệ và phòng ban công tác trong toàn công ty."))
            </p>
        </div>
        @if (canWrite)
        {
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button class="btn emp-btn-secondary" @onclick="OpenCatalogModal">
                    <i class="bi bi-diagram-3 me-1"></i> Danh mục Phòng ban &amp; Chức danh
                </button>
                <button class="btn emp-btn-primary" @onclick="OpenCreateModal">
                    <i class="bi bi-person-plus-fill me-1"></i> Thêm nhân sự mới
                </button>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46;">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@successMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- KPI Metric Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="@(canWrite ? "col-12 col-sm-6 col-xl-3" : "col-12 col-sm-6")">
            <div class="card emp-kpi-card p-3 h-100">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="emp-kpi-label">Tổng số nhân sự</span>
                    <span class="emp-badge emp-badge-neutral">Toàn công ty</span>
                </div>
                <div class="emp-kpi-value mt-1 tabular-nums">@employees.Count</div>
                <div class="small text-muted mt-1">Nhân sự trong danh bạ công ty</div>
            </div>
        </div>

        <div class="@(canWrite ? "col-12 col-sm-6 col-xl-3" : "col-12 col-sm-6")">
            <div class="card emp-kpi-card p-3 h-100" style="border-left: 4px solid var(--emp-primary) !important;">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="emp-kpi-label text-success fw-bold">Đang làm việc (Active)</span>
                    <span class="emp-badge emp-badge-success">Vận hành</span>
                </div>
                <div class="emp-kpi-value text-success mt-1 tabular-nums">@employees.Count(e => string.Equals(e.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase))</div>
                <div class="small text-muted mt-1">Nhân sự đang công tác thực tế</div>
            </div>
        </div>

        @if (canWrite)
        {
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card emp-kpi-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="emp-kpi-label">Đã thôi việc (Resigned)</span>
                        <span class="emp-badge emp-badge-danger">Offboard</span>
                    </div>
                    <div class="fs-3 fw-bold text-danger font-monospace mt-1 tabular-nums">@employees.Count(e => string.Equals(e.Status, "RESIGNED", StringComparison.OrdinalIgnoreCase))</div>
                    <div class="small text-muted mt-1">Đã khóa tài khoản &amp; thu hồi truy cập</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card emp-kpi-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="emp-kpi-label">Đã cấp tài khoản</span>
                        <span class="emp-badge emp-badge-neutral">Đăng nhập</span>
                    </div>
                    <div class="emp-kpi-value mt-1 tabular-nums">@employees.Count(e => e.HasAccount)</div>
                    <div class="small text-muted mt-1">Có tài khoản User trên hệ thống</div>
                </div>
            </div>
        }
    </div>

    <!-- Toolbar: Search & Filters -->
    <div class="card emp-card mb-4">
        <div class="card-body p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex flex-wrap align-items-center gap-3 flex-grow-1">
                <div style="min-width: 260px;" class="flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0 shadow-none"
                               placeholder="Tìm tên, mã NV, email hoặc SĐT..."
                               @bind="searchKeyword" @bind:event="oninput" />
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <select class="form-select form-select-sm fw-medium" @bind="selectedDepartmentId" style="width: auto; border-radius: 8px;">
                        <option value="0">Tất cả phòng ban</option>
                        @foreach (var dept in departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>

                    <select class="form-select form-select-sm fw-medium" @bind="selectedStatus" style="width: auto; border-radius: 8px;">
                        <option value="">Tất cả trạng thái</option>
                        <option value="ACTIVE">Đang làm việc (ACTIVE)</option>
                        <option value="RESIGNED">Đã thôi việc (RESIGNED)</option>
                    </select>

                    <button class="btn btn-sm emp-btn-secondary" @onclick="LoadDataAsync" disabled="@isLoading">
                        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Employee Table -->
    <div class="card emp-card">
        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center justify-content-center rounded-3 shadow-2xs" 
                     style="width: 40px; height: 40px; background: rgba(15, 118, 110, 0.1); color: var(--emp-primary); flex-shrink: 0;">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
                <div>
                    <strong class="text-dark fs-6 text-uppercase fw-bold" style="letter-spacing: 0.5px;">@(canWrite ? "Danh Sách Quản Trị Hồ Sơ Nhân Sự" : "Danh Bạ Liên Lạc Cán Bộ Nhân Viên")</strong>
                    <div class="text-muted small mt-0.5">
                        @(canWrite 
                            ? $"Hiển thị {pagedEmployees.Count} / {filteredEmployees.Count} hồ sơ nhân sự toàn công ty" 
                            : $"Hiển thị {pagedEmployees.Count} / {filteredEmployees.Count} nhân sự · Tra cứu nhanh số điện thoại và email nội bộ")
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="text-muted small mt-2">Đang tải hồ sơ nhân sự...</div>
                </div>
            }
            else if (filteredEmployees.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-person-x fs-1 text-muted d-block mb-2"></i>
                    <p class="mb-0">Không tìm thấy nhân viên nào phù hợp tiêu chí lọc.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table emp-table align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase">
                            <tr>
                                <th class="ps-4">Nhân sự</th>
                                <th>Chức vụ &amp; Phòng ban</th>
                                <th>Thông tin liên hệ</th>
                                <th>Trạng thái &amp; Tài khoản</th>
                                @if (canWrite)
                                {
                                    <th>Lương &amp; Phụ cấp</th>
                                }
                                <th class="pe-4 text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < pagedEmployees.Count; i++)
                            {
                                var emp = pagedEmployees[i];
                                var isBottomRow = i >= pagedEmployees.Count - 2 && pagedEmployees.Count > 3;
                                <tr class="emp-table-row">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-2xs @(canWrite ? "cursor-pointer" : "")"
                                                 style="width: 38px; height: 38px; background: linear-gradient(135deg, var(--emp-primary) 0%, var(--emp-primary-hover) 100%); font-size: 0.9rem; flex-shrink: 0;"
                                                 @onclick="() => { if (canWrite) OpenEditModal(emp); }"
                                                 title="@(canWrite ? "Bấm để xem và chỉnh sửa hồ sơ" : "")">
                                                @GetInitial(emp.FullName)
                                            </div>
                                            <div>
                                                @if (canWrite)
                                                {
                                                    <a href="javascript:void(0)" class="fw-bold text-dark text-decoration-none hover-primary text-nowrap d-inline-block"
                                                       @onclick="() => OpenEditModal(emp)"
                                                       title="Bấm để xem và chỉnh sửa hồ sơ">
                                                        @emp.FullName
                                                    </a>
                                                }
                                                else
                                                {
                                                    <div class="fw-bold text-dark text-nowrap">@emp.FullName</div>
                                                }
                                                <div class="small text-muted font-monospace text-nowrap mt-0.5">@emp.Code · @(GenderCatalog.ToDisplayName(emp.Gender))</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark text-nowrap" style="font-size: 0.88rem;">
                                            @(emp.PositionName ?? "Chưa phân chức vụ")
                                        </div>
                                        <div class="mt-1">
                                            <span class="emp-badge emp-badge-neutral py-0.5" style="font-size: 0.72rem;">
                                                @emp.DepartmentName
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-dark text-nowrap d-flex align-items-center gap-1.5">
                                            <i class="bi bi-envelope text-muted"></i>
                                            <span>@(emp.Email ?? "Chưa có")</span>
                                        </div>
                                        <div class="small text-muted font-monospace tabular-nums text-nowrap d-flex align-items-center gap-1.5 mt-0.5">
                                            <i class="bi bi-telephone text-muted"></i>
                                            <span>@(emp.Phone ?? "Chưa có")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            @if (string.Equals(emp.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="emp-badge emp-badge-success py-0.5">
                                                    <span class="emp-status-dot"></span> Đang làm việc
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="emp-badge emp-badge-danger py-0.5">
                                                    <span class="emp-status-dot"></span> Đã thôi việc
                                                </span>
                                            }
                                        </div>
                                        <div class="mt-1">
                                            @if (emp.HasAccount)
                                            {
                                                <span class="small text-muted text-nowrap d-inline-flex align-items-center gap-1" style="font-size: 0.73rem;">
                                                    <i class="bi bi-person-check-fill text-success"></i> Đã có tài khoản
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="small text-secondary text-nowrap d-inline-flex align-items-center gap-1" style="font-size: 0.73rem;">
                                                    <i class="bi bi-person-dash text-muted"></i> Chưa cấp User
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    @if (canWrite)
                                    {
                                        <td>
                                            <div class="font-monospace fw-bold tabular-nums text-nowrap" style="color: var(--emp-primary); font-size: 0.92rem;">
                                                @FormatVnd(emp.BaseSalary)
                                            </div>
                                            <div class="small text-muted" style="font-size: 0.72rem;">
                                                CV: @FormatVnd(emp.PositionAllowance) · Khác: @FormatVnd(emp.OtherAllowance)
                                            </div>
                                        </td>
                                    }
                                    <td class="pe-4 text-end">
                                        <div class="emp-actions-group justify-content-end position-relative">
                                            <button class="emp-action-btn emp-action-btn-secondary"
                                                    title="Xem Lịch sử Lương & Timeline Sự kiện"
                                                    @onclick="() => OpenTimelineModal(emp)">
                                                <i class="bi bi-clock-history"></i> Timeline
                                            </button>

                                            @if (canWrite)
                                            {
                                                <button class="emp-action-btn emp-action-btn-edit"
                                                        title="Xem và chỉnh sửa hồ sơ"
                                                        @onclick="() => { CloseActionMenu(); OpenEditModal(emp); }">
                                                    <i class="bi bi-pencil-square"></i> Sửa
                                                </button>
                                            }

                                            @if ((canTransfer || canPromote || canOffboard) && string.Equals(emp.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="position-relative d-inline-block">
                                                    <button class="emp-action-btn emp-action-btn-more @(activeActionMenuId == emp.Id ? "active" : "")"
                                                            title="Thao tác khác"
                                                            @onclick="() => ToggleActionMenu(emp.Id)">
                                                        <i class="bi bi-three-dots"></i>
                                                    </button>

                                                    @if (activeActionMenuId == emp.Id)
                                                    {
                                                        <div class="emp-action-dropdown-backdrop" @onclick="CloseActionMenu"></div>
                                                        <div class="emp-action-dropdown-menu @(isBottomRow ? "dropup" : "dropdown") shadow-lg">
                                                            @if (canPromote)
                                                            {
                                                                <button type="button" class="emp-action-dropdown-item text-primary"
                                                                        @onclick="() => { CloseActionMenu(); OpenPromoteModal(emp); }">
                                                                    <i class="bi bi-award text-primary"></i>
                                                                    <span>Bổ nhiệm / Thăng chức</span>
                                                                </button>
                                                            }
                                                            @if (canTransfer)
                                                            {
                                                                @if (canPromote)
                                                                {
                                                                    <div class="emp-action-dropdown-divider"></div>
                                                                }
                                                                <button type="button" class="emp-action-dropdown-item"
                                                                        @onclick="() => { CloseActionMenu(); OpenTransferModal(emp); }">
                                                                    <i class="bi bi-arrow-left-right text-info"></i>
                                                                    <span>Điều chuyển phòng ban</span>
                                                                </button>
                                                            }
                                                            @if (canOffboard)
                                                            {
                                                                @if (canTransfer || canPromote)
                                                                {
                                                                    <div class="emp-action-dropdown-divider"></div>
                                                                }
                                                                <button type="button" class="emp-action-dropdown-item emp-action-dropdown-item-danger"
                                                                        @onclick="() => { CloseActionMenu(); OpenOffboardModal(emp); }">
                                                                    <i class="bi bi-person-x text-danger"></i>
                                                                    <span>Thực hiện thôi việc</span>
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="small text-muted">
                            Trang <strong>@currentPage</strong> / <strong>@totalPages</strong> (Tổng số <strong>@filteredEmployees.Count</strong> nhân sự)
                        </div>

                        <nav aria-label="Employee list pagination">
                            <ul class="pagination pagination-sm mb-0 pagination-custom">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(1)">« Đầu</button>
                                </li>
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">‹ Trước</button>
                                </li>

                                @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                                {
                                    var pageNumber = p;
                                    <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                                    </li>
                                }

                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Sau ›</button>
                                </li>
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(totalPages)">Cuối »</button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Onboarding / Create / Edit Modal -->
    @if (showFormModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(3px); z-index: 1050;">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="modal-header border-bottom py-3 px-4" style="background: linear-gradient(135deg, #065f46 0%, #047857 100%); color: white; border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <h5 class="modal-title fw-bold">
                            @(isEditMode ? "✏️ Chỉnh sửa hồ sơ nhân sự" : "➕ Tiếp nhận nhân sự mới (Onboarding)")
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseFormModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12"><h6 class="fw-bold text-success border-bottom pb-2">1. Thông tin cá nhân &amp; Nhân thân</h6></div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" @bind="formFullName" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Mã nhân viên (bỏ trống để tự sinh)</label>
                                <input type="text" class="form-control font-monospace" placeholder="Tự sinh: NV0001..." @bind="formCode" disabled="@isEditMode" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Giới tính</label>
                                <select class="form-select" @bind="formGender">
                                    <option value="@GenderCatalog.Male">Nam</option>
                                    <option value="@GenderCatalog.Female">Nữ</option>
                                    <option value="@GenderCatalog.Other">Khác</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Ngày sinh</label>
                                <input type="date" class="form-control" @bind="formDateOfBirth" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Số người phụ thuộc (giảm trừ)</label>
                                <input type="number" min="0" class="form-control" @bind="formDependentCount" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Số điện thoại</label>
                                <input type="tel" class="form-control" placeholder="090..." @bind="formPhone" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Email liên hệ</label>
                                <input type="email" class="form-control" placeholder="email@company.vn" @bind="formEmail" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Trình độ học vấn</label>
                                <select class="form-select" @bind="formEducationLevel">
                                    <option value="@EducationLevelCatalog.Bachelor">Đại học</option>
                                    <option value="@EducationLevelCatalog.Master">Thạc sĩ</option>
                                    <option value="@EducationLevelCatalog.College">Cao đẳng</option>
                                    <option value="@EducationLevelCatalog.Intermediate">Trung cấp</option>
                                    <option value="@EducationLevelCatalog.Other">Khác</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Địa chỉ liên hệ</label>
                                <input type="text" class="form-control" placeholder="Số nhà, đường, phường..." @bind="formAddress" />
                            </div>

                            <div class="col-12 mt-4"><h6 class="fw-bold text-success border-bottom pb-2">2. Vị trí công tác &amp; Phòng ban</h6></div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Phòng ban công tác <span class="text-danger">*</span></label>
                                @if (!isEditMode || canTransfer)
                                {
                                    <select class="form-select" value="@formDepartmentId" @onchange="OnFormDepartmentChanged">
                                        <option value="0">-- Chọn phòng ban --</option>
                                        @foreach (var d in departments)
                                        {
                                            <option value="@d.Id">@d.Name (@d.Code)</option>
                                        }
                                    </select>
                                    @if (isEditMode && canTransfer)
                                    {
                                        <div class="form-text small text-success">✓ Bạn có quyền điều chuyển phòng ban.</div>
                                    }
                                }
                                else
                                {
                                    <select class="form-select bg-light text-muted" disabled value="@formDepartmentId">
                                        @foreach (var d in departments)
                                        {
                                            <option value="@d.Id">@d.Name (@d.Code)</option>
                                        }
                                    </select>
                                    <div class="form-text small text-muted">
                                        🔒 Khóa: Cần quyền <strong>"Điều chuyển phòng ban"</strong> để thay đổi đơn vị công tác.
                                    </div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Chức danh / Vị trí</label>
                                @{
                                    var currentDept = departments.FirstOrDefault(d => d.Id == formDepartmentId);
                                    var formPositions = formDepartmentId > 0
                                        ? positions.Where(p => DepartmentPositionPolicy.IsCompatible(formDepartmentId, p.DepartmentId, currentDept?.Code, currentDept?.Name, p.Name, p.Code)).ToList()
                                        : positions;
                                }
                                <select class="form-select" value="@formPositionId" @onchange="OnFormPositionChanged">
                                    <option value="0">-- Chưa chọn chức vụ --</option>
                                    @foreach (var p in formPositions)
                                    {
                                        <option value="@p.Id">@p.Name (Phụ cấp: @FormatSalaryNumber(p.DefaultPositionAllowance) đ)</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Quản lý trực tiếp</label>
                                <select class="form-select" @bind="formManagerId">
                                    <option value="0">-- Chưa có quản lý --</option>
                                    @foreach (var manager in managerOptions.Where(e => e.Id != editingEmployeeId && e.Status == "ACTIVE"))
                                    {
                                        <option value="@manager.Id">@manager.Code — @manager.FullName</option>
                                    }
                                </select>
                                <div class="form-text">Quản lý cần quyền duyệt đơn nghỉ phép để xử lý đơn.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Ngày tuyển dụng / Vào làm (hire_date) <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" @bind="formHireDate" />
                            </div>

                            @if (isEditMode)
                            {
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Trạng thái hồ sơ</label>
                                    <div class="p-2 border rounded bg-light d-flex align-items-center justify-content-between">
                                        @if (string.Equals(formStatus, "ACTIVE", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                                ● Đang làm việc (ACTIVE)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1">
                                                ✕ Đã thôi việc (RESIGNED)
                                            </span>
                                        }
                                        <small class="text-muted fst-italic">Muốn thôi việc, dùng nút "Thôi việc"</small>
                                    </div>
                                </div>
                            }

                            <div class="col-12 mt-4"><h6 class="fw-bold text-success border-bottom pb-2">3. Chế độ Lương, Phụ cấp &amp; Ngân hàng</h6></div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Lương cơ bản hợp đồng <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-cash-stack text-success"></i></span>
                                    <input type="text" class="form-control text-end fw-bold font-monospace"
                                           value="@formBaseSalaryDisplay"
                                           @oninput="OnBaseSalaryInput"
                                           @onblur="OnBaseSalaryBlur" />
                                    <span class="input-group-text bg-light text-muted font-monospace">VNĐ</span>
                                </div>
                                <div class="btn-group btn-group-sm mt-1">
                                    <button type="button" class="btn btn-outline-secondary py-0 px-2 font-monospace" @onclick="() => AdjustBaseSalary(-500000)">-500k</button>
                                    <button type="button" class="btn btn-outline-secondary py-0 px-2 font-monospace" @onclick="() => AdjustBaseSalary(500000)">+500k</button>
                                    <button type="button" class="btn btn-outline-secondary py-0 px-2 font-monospace" @onclick="() => AdjustBaseSalary(1000000)">+1M</button>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Phụ cấp chức vụ</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-award text-primary"></i></span>
                                    <input type="number" min="0" step="50000" class="form-control text-end font-monospace" @bind="formPositionAllowance" />
                                    <span class="input-group-text bg-light text-muted font-monospace">VNĐ</span>
                                </div>
                                <div class="form-text small text-muted">Tự động gợi ý từ chức danh khi chọn mới.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Phụ cấp khác</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-plus-circle text-info"></i></span>
                                    <input type="number" min="0" step="50000" class="form-control text-end font-monospace" @bind="formOtherAllowance" />
                                    <span class="input-group-text bg-light text-muted font-monospace">VNĐ</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Lương đóng BHXH (để trống nếu bằng lương cơ bản)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-shield-check text-success"></i></span>
                                    <input type="number" min="0" step="50000" class="form-control text-end font-monospace" @bind="formInsuranceSalary" />
                                    <span class="input-group-text bg-light text-muted font-monospace">VNĐ</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Tên ngân hàng chi trả</label>
                                <input type="text" class="form-control" placeholder="Ví dụ: Vietcombank, Techcombank..." @bind="formBankName" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Số tài khoản ngân hàng</label>
                                <input type="text" class="form-control font-monospace" placeholder="Nhập số tài khoản..." @bind="formBankAccountNumber" />
                            </div>

                            @if (isEditMode)
                            {
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Ghi chú / Căn cứ thay đổi chế độ lương (nếu có)</label>
                                    <input type="text" class="form-control" placeholder="Ví dụ: Quyết định tăng lương định kỳ đợt 1 / 2026..." @bind="formSalaryChangeNote" />
                                    <div class="form-text small text-muted">Hệ thống sẽ tự động lưu vết lịch sử lương mới nếu bạn thay đổi bất kỳ chỉ số lương nào.</div>
                                </div>
                            }

                            @if (!isEditMode)
                            {
                                <div class="col-12 mt-4">
                                    <div class="card p-3 border-light bg-light" style="border-radius: 14px;">
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" id="createAccountSwitch" @bind="formCreateAccount">
                                            <label class="form-check-label fw-bold text-dark" for="createAccountSwitch">
                                                Cấp ngay tài khoản đăng nhập hệ thống cho nhân sự này
                                            </label>
                                        </div>

                                        @if (formCreateAccount)
                                        {
                                            <div class="row g-2 mt-2">
                                                <div class="col-md-4">
                                                    <label class="form-label small fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control form-control-sm" placeholder="username" @bind="formUserName" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label small fw-semibold">Mật khẩu tạm <span class="text-danger">*</span></label>
                                                    <input type="password" class="form-control form-control-sm" placeholder="Tối thiểu @PasswordPolicy.MinLength ký tự" @bind="formPassword" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label small fw-semibold">Vai trò hệ thống</label>
                                                    <select class="form-select form-select-sm" @bind="formRole">
                                                        @foreach (var role in availableRoles)
                                                        {
                                                            <option value="@role">@role</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseFormModal">
                            Hủy bỏ
                        </button>
                        <button type="button" class="btn btn-success rounded-pill px-4 fw-semibold" disabled="@isSubmitting" @onclick="SaveEmployeeAsync">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <span>@(isEditMode ? "Cập nhật hồ sơ" : "Lưu nhân sự")</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal Lịch sử Lương & Timeline Sự kiện Nhân sự -->
    @if (showTimelineModal && timelineEmployee != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1060;">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="modal-header border-bottom px-4 py-3 bg-light" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4">📜</span>
                            <div>
                                <h5 class="modal-title fw-bold text-dark mb-0">Hồ Sơ Diễn Biến Công Tác &amp; Lịch Sử Lương</h5>
                                <div class="small text-muted font-monospace">@timelineEmployee.FullName (@timelineEmployee.Code) · @timelineEmployee.DepartmentName</div>
                            </div>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseTimelineModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        <!-- Navigation Tabs -->
                        <ul class="nav nav-pills mb-4 gap-2">
                            <li class="nav-item">
                                <button class="nav-link rounded-pill @(timelineTab == "timeline" ? "active bg-primary" : "bg-light text-dark")"
                                        @onclick='() => timelineTab = "timeline"'>
                                    <i class="bi bi-clock-history me-1"></i> Dòng thời gian sự kiện nhân sự (@employeeTimeline.Count)
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link rounded-pill @(timelineTab == "salary" ? "active bg-primary" : "bg-light text-dark")"
                                        @onclick='() => timelineTab = "salary"'>
                                    <i class="bi bi-cash-stack me-1"></i> Lịch sử biến động lương &amp; đãi ngộ (@employeeSalaryHistory.Count)
                                </button>
                            </li>
                        </ul>

                        @if (isLoadingTimeline)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status"></div>
                                <div class="text-muted small mt-2">Đang tải dữ liệu lịch sử...</div>
                            </div>
                        }
                        else if (timelineTab == "timeline")
                        {
                            @if (employeeTimeline.Count == 0)
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                                    <p>Chưa có sự kiện nào được ghi nhận trong dòng thời gian nhân sự.</p>
                                </div>
                            }
                            else
                            {
                                <div class="timeline-container px-3">
                                    @foreach (var ev in employeeTimeline)
                                    {
                                        <div class="d-flex gap-3 mb-4 position-relative">
                                            <div class="timeline-badge rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm flex-shrink-0"
                                                 style="width: 42px; height: 42px; background: @GetTimelineColor(ev.EventType);">
                                                <i class="bi @GetTimelineIcon(ev.EventType)"></i>
                                            </div>
                                            <div class="card p-3 border rounded-3 flex-grow-1 shadow-2xs">
                                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
                                                    <strong class="text-dark fs-6">@ev.Title</strong>
                                                    <span class="small text-muted font-monospace tabular-nums">
                                                        @ev.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                    </span>
                                                </div>
                                                <div class="text-secondary small mb-2">@ev.Description</div>
                                                <div class="d-flex align-items-center gap-2 small text-muted border-top pt-2">
                                                    <i class="bi bi-person-badge"></i>
                                                    <span>Thực hiện bởi: <strong>@(ev.CreatedByName ?? "Hệ thống")</strong></span>
                                                    <span class="badge bg-secondary-subtle text-secondary font-monospace ms-auto">@ev.EventType</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            @if (employeeSalaryHistory.Count == 0)
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-wallet2 fs-1 d-block mb-2"></i>
                                    <p>Chưa có bản ghi lịch sử lương nào.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover align-middle mb-0">
                                        <thead class="table-light small text-uppercase">
                                            <tr>
                                                <th>Lương cơ bản</th>
                                                <th>Phụ cấp chức vụ</th>
                                                <th>Phụ cấp khác</th>
                                                <th>Lương đóng BHXH</th>
                                                <th>Ngày hiệu lực</th>
                                                <th>Ngày hết hạn</th>
                                                <th>Trạng thái</th>
                                                <th>Ghi chú</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var sp in employeeSalaryHistory)
                                            {
                                                <tr class="@(sp.IsCurrent ? "table-success-subtle fw-semibold" : "")">
                                                    <td class="font-monospace text-success">@FormatVnd(sp.BaseSalary)</td>
                                                    <td class="font-monospace">@FormatVnd(sp.PositionAllowance)</td>
                                                    <td class="font-monospace">@FormatVnd(sp.OtherAllowance)</td>
                                                    <td class="font-monospace text-muted">@FormatVnd(sp.InsuranceSalary ?? sp.BaseSalary)</td>
                                                    <td class="tabular-nums">@sp.EffectiveDate.ToString("dd/MM/yyyy")</td>
                                                    <td class="tabular-nums">@(sp.ExpiryDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                    <td>
                                                        @if (sp.IsCurrent)
                                                        {
                                                            <span class="badge bg-success">Hiện hành</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Lịch sử</span>
                                                        }
                                                    </td>
                                                    <td class="small text-secondary">@(sp.Note ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>

                    <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="CloseTimelineModal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal Quản lý Danh mục Phòng ban & Chức danh -->
    @if (showCatalogModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1060;">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="modal-header border-bottom px-4 py-3 bg-light" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4">🏢</span>
                            <div>
                                <h5 class="modal-title fw-bold text-dark mb-0">Quản Lý Danh Mục Động: Phòng Ban &amp; Chức Danh</h5>
                                <div class="small text-muted">Cấu hình danh mục tổ chức, phụ cấp chức vụ chuẩn và phân bổ chức danh theo phòng ban</div>
                            </div>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseCatalogModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        @if (!string.IsNullOrWhiteSpace(catalogMessage))
                        {
                            <div class="alert alert-info alert-dismissible fade show mb-3" role="alert">
                                <div>@catalogMessage</div>
                                <button type="button" class="btn-close" @onclick="() => catalogMessage = null"></button>
                            </div>
                        }

                        <ul class="nav nav-pills mb-4 gap-2">
                            <li class="nav-item">
                                <button class="nav-link rounded-pill @(catalogTab == "departments" ? "active bg-primary" : "bg-light text-dark")"
                                        @onclick='() => SwitchCatalogTab("departments")'>
                                    <i class="bi bi-building me-1"></i> Danh mục Phòng ban (@allDepartments.Count)
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link rounded-pill @(catalogTab == "positions" ? "active bg-primary" : "bg-light text-dark")"
                                        @onclick='() => SwitchCatalogTab("positions")'>
                                    <i class="bi bi-briefcase me-1"></i> Danh mục Chức danh / Vị trí (@allPositions.Count)
                                </button>
                            </li>
                        </ul>

                        @if (catalogTab == "departments")
                        {
                            <div class="row g-4">
                                <div class="col-lg-5">
                                    <div class="card p-3 border rounded-3 bg-light">
                                        <h6 class="fw-bold text-primary mb-3">@(editingDeptId == 0 ? "➕ Thêm mới phòng ban" : "✏️ Cập nhật phòng ban")</h6>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Mã phòng ban <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control font-monospace" placeholder="Ví dụ: HR, IT, MKT..." @bind="deptFormCode" />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Tên phòng ban <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" placeholder="Ví dụ: Phòng Nhân sự..." @bind="deptFormName" />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Mô tả chức năng</label>
                                            <textarea class="form-control" rows="2" placeholder="Mô tả nhiệm vụ..." @bind="deptFormDescription"></textarea>
                                        </div>
                                        @if (editingDeptId > 0)
                                        {
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" id="deptActiveSwitch" @bind="deptFormIsActive" />
                                                <label class="form-check-label small fw-semibold" for="deptActiveSwitch">Đang kích hoạt hoạt động</label>
                                            </div>
                                        }
                                        <div class="d-flex gap-2">
                                            @if (editingDeptId > 0)
                                            {
                                                <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="ResetDeptForm">Hủy</button>
                                            }
                                            <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="SaveDepartmentAsync">
                                                @(editingDeptId == 0 ? "Thêm phòng ban" : "Lưu thay đổi")
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-7">
                                    <div class="table-responsive border rounded-3">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light small text-uppercase">
                                                <tr>
                                                    <th>Mã</th>
                                                    <th>Tên phòng ban</th>
                                                    <th>Nhân sự</th>
                                                    <th>Trạng thái</th>
                                                    <th class="text-end">Sửa</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var d in allDepartments)
                                                {
                                                    <tr>
                                                        <td class="font-monospace fw-bold">@d.Code</td>
                                                        <td>
                                                            <div>@d.Name</div>
                                                            @if (!string.IsNullOrWhiteSpace(d.Description))
                                                            {
                                                                <small class="text-muted d-block">@d.Description</small>
                                                            }
                                                        </td>
                                                        <td><span class="badge bg-light text-dark border">@d.EmployeeCount NV</span></td>
                                                        <td>
                                                            @if (d.IsActive)
                                                            {
                                                                <span class="badge bg-success-subtle text-success">Hoạt động</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary-subtle text-secondary">Vô hiệu hóa</span>
                                                            }
                                                        </td>
                                                        <td class="text-end">
                                                            <button class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="() => EditDepartment(d)">
                                                                <i class="bi bi-pencil"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-4">
                                <div class="col-lg-5">
                                    <div class="card p-3 border rounded-3 bg-light">
                                        <h6 class="fw-bold text-primary mb-3">@(editingPosId == 0 ? "➕ Thêm chức danh mới" : "✏️ Cập nhật chức danh")</h6>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Mã chức danh <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control font-monospace" placeholder="Ví dụ: DEV, TEST, HR_MGR..." @bind="posFormCode" />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Tên chức danh <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" placeholder="Ví dụ: Kỹ sư phần mềm..." @bind="posFormName" />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Phòng ban chuyên môn (để trống nếu dùng chung)</label>
                                            <select class="form-select" @bind="posFormDepartmentId">
                                                <option value="0">-- Dùng chung toàn công ty --</option>
                                                @foreach (var d in allDepartments)
                                                {
                                                    <option value="@d.Id">@d.Name (@d.Code)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Phụ cấp chức vụ mặc định (VNĐ)</label>
                                            <input type="number" min="0" step="50000" class="form-control font-monospace" @bind="posFormAllowance" />
                                        </div>
                                        @if (editingPosId > 0)
                                        {
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" id="posActiveSwitch" @bind="posFormIsActive" />
                                                <label class="form-check-label small fw-semibold" for="posActiveSwitch">Đang kích hoạt hoạt động</label>
                                            </div>
                                        }
                                        <div class="d-flex gap-2">
                                            @if (editingPosId > 0)
                                            {
                                                <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="ResetPosForm">Hủy</button>
                                            }
                                            <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="SavePositionAsync">
                                                @(editingPosId == 0 ? "Thêm chức danh" : "Lưu thay đổi")
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-7">
                                    <div class="table-responsive border rounded-3">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light small text-uppercase">
                                                <tr>
                                                    <th>Mã</th>
                                                    <th>Tên chức danh</th>
                                                    <th>Phòng ban</th>
                                                    <th>Phụ cấp chuẩn</th>
                                                    <th>Trạng thái</th>
                                                    <th class="text-end">Sửa</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in allPositions)
                                                {
                                                    <tr>
                                                        <td class="font-monospace fw-bold">@p.Code</td>
                                                        <td>@p.Name</td>
                                                        <td>
                                                            @if (!string.IsNullOrWhiteSpace(p.DepartmentName))
                                                            {
                                                                <span class="badge bg-primary-subtle text-primary">@p.DepartmentName</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary-subtle text-secondary">Dùng chung</span>
                                                            }
                                                        </td>
                                                        <td class="font-monospace tabular-nums">@FormatVnd(p.DefaultPositionAllowance)</td>
                                                        <td>
                                                            @if (p.IsActive)
                                                            {
                                                                <span class="badge bg-success-subtle text-success">Hoạt động</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary-subtle text-secondary">Vô hiệu hóa</span>
                                                            }
                                                        </td>
                                                        <td class="text-end">
                                                            <button class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="() => EditPosition(p)">
                                                                <i class="bi bi-pencil"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="CloseCatalogModal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal Bổ nhiệm / Thăng chức (Promotion) -->
    @if (showPromoteModal && promotingEmployee != null)
    {
        var currentRank = PositionHierarchyPolicy.GetPositionRank(promotingEmployee.PositionName);
        var targetDept = departments.FirstOrDefault(d => d.Id == promotingEmployee.DepartmentId);
        var eligiblePositions = positions
            .Where(p => DepartmentPositionPolicy.IsCompatible(promotingEmployee.DepartmentId, p.DepartmentId, targetDept?.Code, targetDept?.Name, p.Name, p.Code))
            .Where(p => PositionHierarchyPolicy.GetPositionRank(p.Name, p.Code) > currentRank)
            .OrderBy(p => PositionHierarchyPolicy.GetPositionRank(p.Name, p.Code))
            .ToList();

        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1060;">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="modal-header border-bottom px-4 py-3 bg-light" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4">🎖️</span>
                            <div>
                                <h5 class="modal-title fw-bold text-dark mb-0">Quyết Định Bổ Nhiệm &amp; Thăng Chức</h5>
                                <div class="small text-muted">Nâng chức danh chuyên môn, điều chỉnh đãi ngộ và đồng bộ quyền hạn theo thẩm quyền cấp bậc</div>
                            </div>
                        </div>
                        <button type="button" class="btn-close" @onclick="ClosePromoteModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        @if (!string.IsNullOrWhiteSpace(promoteErrorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @promoteErrorMessage
                                <button type="button" class="btn-close" @onclick="() => promoteErrorMessage = null"></button>
                            </div>
                        }

                        <!-- Thông tin nhân sự hiện tại -->
                        <div class="card bg-light border-0 p-3 mb-3" style="border-radius: 14px;">
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                     style="width: 48px; height: 48px; background: linear-gradient(135deg, #059669 0%, #047857 100%); font-size: 1.2rem; flex-shrink: 0;">
                                    @GetInitial(promotingEmployee.FullName)
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold text-dark mb-1">@promotingEmployee.FullName <span class="badge bg-secondary-subtle text-secondary font-monospace ms-2">@promotingEmployee.Code</span></h6>
                                    <div class="small text-muted d-flex align-items-center gap-3 flex-wrap">
                                        <span>Phòng ban: <strong>@(promotingEmployee.DepartmentName ?? "Chưa phân bổ")</strong></span>
                                        <span>Chức danh hiện tại: <strong class="text-primary">@(promotingEmployee.PositionName ?? "Chưa phân chức vụ")</strong></span>
                                        <span class="badge bg-primary-subtle text-primary">@PositionHierarchyPolicy.GetRankDisplayName(currentRank)</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label small fw-semibold">Vị trí / Chức danh bổ nhiệm mới <span class="text-danger">*</span></label>
                                <select class="form-select" value="@promoteTargetPositionId" @onchange="OnPromotePositionChanged">
                                    <option value="0">-- Chọn vị trí thăng chức (Cấp bậc cao hơn) --</option>
                                    @foreach (var pos in eligiblePositions)
                                    {
                                        var pRank = PositionHierarchyPolicy.GetPositionRank(pos.Name, pos.Code);
                                        <option value="@pos.Id">@pos.Name (@PositionHierarchyPolicy.GetRankDisplayName(pRank)) - Phụ cấp chuẩn: @pos.DefaultPositionAllowance.ToString("N0") đ</option>
                                    }
                                </select>
                                @if (eligiblePositions.Count == 0)
                                {
                                    <div class="form-text small text-warning">
                                        ⚠️ Phòng ban này chưa có chức danh nào có cấp bậc cao hơn chức danh hiện tại của nhân sự. Vui lòng thêm chức danh mới trong Quản lý danh mục.
                                    </div>
                                }
                                else
                                {
                                    <div class="form-text small text-muted">
                                        Chỉ hiển thị các chức danh thuộc phòng ban <strong>@(promotingEmployee.DepartmentName)</strong> có cấp bậc cao hơn vị trí hiện tại.
                                    </div>
                                }
                            </div>

                            @if (promoteTargetPositionId > 0)
                            {
                                var selectedNewPos = positions.FirstOrDefault(p => p.Id == promoteTargetPositionId);
                                var newRank = PositionHierarchyPolicy.GetPositionRank(selectedNewPos?.Name, selectedNewPos?.Code);

                                <div class="col-12">
                                    <div class="p-3 border rounded-3 bg-primary-subtle border-primary-subtle d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <div>
                                            <span class="fw-bold text-primary">Thăng tiến cấp bậc:</span>
                                            <span class="badge bg-secondary ms-2 me-1">@PositionHierarchyPolicy.GetRankDisplayName(currentRank)</span>
                                            <i class="bi bi-arrow-right text-primary"></i>
                                            <span class="badge bg-success ms-1">@PositionHierarchyPolicy.GetRankDisplayName(newRank)</span>
                                        </div>
                                        @if (promotingEmployee.HasAccount)
                                        {
                                            <div class="small text-primary-emphasis">
                                                <i class="bi bi-shield-lock me-1"></i> Gợi ý Role tài khoản: <strong>@PositionHierarchyPolicy.SuggestRoleForPosition(selectedNewPos?.Name, targetDept?.Code)</strong>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Lương cơ bản mới sau bổ nhiệm</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control text-end fw-bold font-monospace"
                                               value="@promoteBaseSalaryDisplay"
                                               @oninput="OnPromoteBaseSalaryInput"
                                               @onblur="OnPromoteBaseSalaryBlur" />
                                        <span class="input-group-text bg-light text-muted font-monospace">VNĐ</span>
                                    </div>
                                    <div class="btn-group btn-group-sm mt-1">
                                        <button type="button" class="btn btn-outline-secondary py-0 px-2 font-monospace" @onclick="() => AdjustPromoteBaseSalary(-500000)">-500k</button>
                                        <button type="button" class="btn btn-outline-secondary py-0 px-2 font-monospace" @onclick="() => AdjustPromoteBaseSalary(500000)">+500k</button>
                                        <button type="button" class="btn btn-outline-secondary py-0 px-2 font-monospace" @onclick="() => AdjustPromoteBaseSalary(1000000)">+1M</button>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Phụ cấp chức vụ mới</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-award text-primary"></i></span>
                                        <input type="number" min="0" step="50000" class="form-control text-end font-monospace" @bind="promotePositionAllowance" />
                                        <span class="input-group-text bg-light text-muted font-monospace">VNĐ</span>
                                    </div>
                                    <div class="form-text small text-muted">Tự động lấy theo phụ cấp chuẩn của chức danh (@selectedNewPos?.DefaultPositionAllowance.ToString("N0") đ).</div>
                                </div>

                                @if (promotingEmployee.HasAccount)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">Đồng bộ Vai trò (Role) tài khoản</label>
                                        <select class="form-select" @bind="promoteNewRoleName">
                                            @foreach (var r in availableRoles)
                                            {
                                                <option value="@r">@r</option>
                                            }
                                        </select>
                                        <div class="form-text small text-muted">Tài khoản nhân sự sẽ tự động nâng lên vai trò này.</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">Tài khoản người dùng</label>
                                        <div class="form-control bg-light text-muted small">
                                            <i class="bi bi-info-circle me-1"></i> Nhân sự chưa có User. Có thể cấp tài khoản sau khi bổ nhiệm.
                                        </div>
                                    </div>
                                }

                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Ngày có hiệu lực</label>
                                    <input type="date" class="form-control" @bind="promoteEffectiveDate" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Căn cứ / Quyết định bổ nhiệm (Số QĐ, lý do khen thưởng &amp; thăng chức) <span class="text-danger">*</span></label>
                                    <textarea class="form-control" rows="2" placeholder="Ví dụ: Theo Quyết định số 18/QĐ-BGD thăng chức Trưởng nhóm Kỹ thuật..." @bind="promoteReason"></textarea>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="ClosePromoteModal">
                            Hủy bỏ
                        </button>
                        <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" disabled="@(isSubmittingPromote || promoteTargetPositionId <= 0)" @onclick="ExecutePromoteAsync">
                            @if (isSubmittingPromote)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Đang xử lý...</span>
                            }
                            else
                            {
                                <span>🎖️ Xác nhận bổ nhiệm</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal Điều chuyển công tác / Phòng ban -->
    @if (showTransferModal && transferringEmployee != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="modal-header border-bottom px-4 py-3 bg-light" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4">🔄</span>
                            <h5 class="modal-title fw-bold text-dark mb-0">Điều chuyển công tác / Phòng ban</h5>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseTransferModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="card bg-light border-0 p-3 mb-3" style="border-radius: 14px;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                     style="width: 44px; height: 44px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); font-size: 1.1rem; flex-shrink: 0;">
                                    @GetInitial(transferringEmployee.FullName)
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">@transferringEmployee.FullName</h6>
                                    <div class="small text-muted font-monospace">@transferringEmployee.Code · Hiện tại: <strong>@transferringEmployee.DepartmentName</strong></div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Phòng ban tiếp nhận mới <span class="text-danger">*</span></label>
                                <select class="form-select" value="@transferTargetDepartmentId" @onchange="OnTransferTargetDepartmentChanged">
                                    <option value="0">-- Chọn phòng ban tiếp nhận --</option>
                                    @foreach (var d in departments)
                                    {
                                        if (d.Id != transferringEmployee.DepartmentId)
                                        {
                                            <option value="@d.Id">@d.Name (@d.Code)</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold">Chức danh / Vị trí mới tại phòng ban đích <span class="text-danger">*</span></label>
                                @if (transferTargetDepartmentId <= 0)
                                {
                                    <select class="form-select bg-light text-muted" disabled>
                                        <option value="0">-- Vui lòng chọn phòng ban tiếp nhận trước --</option>
                                    </select>
                                    <div class="form-text small text-muted">Chức danh chuyên môn sẽ được lọc tự động theo phòng ban tiếp nhận.</div>
                                }
                                else
                                {
                                    var targetDept = departments.FirstOrDefault(d => d.Id == transferTargetDepartmentId);
                                    var filteredPositions = positions.Where(p => DepartmentPositionPolicy.IsCompatible(transferTargetDepartmentId, p.DepartmentId, targetDept?.Code, targetDept?.Name, p.Name, p.Code)).ToList();

                                    <select class="form-select" @bind="transferTargetPositionId">
                                        <option value="0">-- Chọn chức vụ phù hợp tại phòng ban mới (*) --</option>
                                        @foreach (var p in filteredPositions)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                    @if (filteredPositions.Count == 0)
                                    {
                                        <div class="form-text small text-warning">⚠️ Chưa có chức danh tương thích riêng cho phòng ban này trong hệ thống.</div>
                                    }
                                    else
                                    {
                                        <div class="form-text small text-success">✓ Hệ thống tự động lọc danh mục chức vụ phù hợp với @targetDept?.Name.</div>
                                    }
                                }
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold">Ngày có hiệu lực</label>
                                <input type="date" class="form-control" @bind="transferEffectiveDate" />
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold">Căn cứ / Lý do điều chuyển (Số quyết định...)</label>
                                <textarea class="form-control" rows="2" placeholder="Ví dụ: Theo Quyết định số 28/QĐ-NS điều động nhân sự dự án..." @bind="transferReason"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseTransferModal">
                            Hủy bỏ
                        </button>
                        <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" disabled="@isSubmittingTransfer" @onclick="ExecuteTransferAsync">
                            @if (isSubmittingTransfer)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Đang xử lý...</span>
                            }
                            else
                            {
                                <span>Xác nhận điều chuyển</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal Xác nhận Thôi việc (Offboarding) -->
    @if (showOffboardModal && offboardingEmployee != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="modal-header border-bottom px-4 py-3 bg-danger-subtle text-danger" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4">⚠️</span>
                            <h5 class="modal-title fw-bold mb-0">Xác nhận Thôi việc &amp; Thu hồi Quyền</h5>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseOffboardModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        <p class="text-secondary mb-3">
                            Bạn đang chuẩn bị thực hiện quyết định thôi việc cho nhân sự sau:
                        </p>

                        <div class="card bg-light border-0 p-3 mb-3" style="border-radius: 14px;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                     style="width: 44px; height: 44px; background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); font-size: 1.1rem; flex-shrink: 0;">
                                    @GetInitial(offboardingEmployee.FullName)
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">@offboardingEmployee.FullName</h6>
                                    <div class="small text-muted font-monospace">@offboardingEmployee.Code · Phòng: @offboardingEmployee.DepartmentName</div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning border-0 d-flex align-items-start gap-2 mb-0" style="border-radius: 12px; font-size: 0.9rem;">
                            <span class="fs-5">🔒</span>
                            <div>
                                <strong>Cảnh báo nghiệp vụ:</strong><br />
                                Hành động này sẽ chuyển trạng thái của nhân sự sang <strong>RESIGNED</strong> (Đã thôi việc).
                                @if (offboardingEmployee.HasAccount)
                                {
                                    <span> Đồng thời <strong>lập tức vô hiệu hóa tài khoản và thu hồi toàn bộ phiên đăng nhập</strong> của nhân sự này trên hệ thống.</span>
                                }
                                else
