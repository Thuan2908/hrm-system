    {
        catalogTab = tab;
        catalogMessage = null;
    }

    private async Task ReloadCatalogsAsync()
    {
        allDepartments = await EmployeeApiClient.GetDepartmentsAsync(includeInactive: true);
        allPositions = await EmployeeApiClient.GetPositionsAsync(includeInactive: true);
        departments = allDepartments.Where(d => d.IsActive).ToList();
        positions = allPositions.Where(p => p.IsActive).ToList();
