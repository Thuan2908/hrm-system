    private void CloseOffboardModal()
    {
        showOffboardModal = false;
        offboardingEmployee = null;
    }

    private async Task ExecuteOffboardAsync()
    {
        if (offboardingEmployee == null) return;

        isSubmittingOffboard = true;
        errorMessage = null;
        try
        {
            var ok = await EmployeeApiClient.OffboardEmployeeAsync(offboardingEmployee.Id);
            if (ok)
            {
                successMessage = offboardingEmployee.HasAccount
                    ? $"Đã hoàn tất thôi việc (Offboard) cho nhân sự '{offboardingEmployee.FullName}'. Toàn bộ tài khoản và quyền truy cập đã được thu hồi."
                    : $"Đã hoàn tất thôi việc (Offboard) cho nhân sự '{offboardingEmployee.FullName}'. Hồ sơ đã chuyển sang trạng thái Đã thôi việc (RESIGNED).";
                CloseOffboardModal();
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi thực hiện thôi việc: " + ex.Message;
        }
        finally
        {
            isSubmittingOffboard = false;
        }
    }

