    private void ResetDeptForm()
    {
        editingDeptId = 0;
        deptFormCode = string.Empty;
        deptFormName = string.Empty;
        deptFormDescription = string.Empty;
        deptFormIsActive = true;
    }

    private void EditDepartment(DepartmentDto dept)
    {
        editingDeptId = dept.Id;
        deptFormCode = dept.Code;
        deptFormName = dept.Name;
        deptFormDescription = dept.Description ?? string.Empty;
        deptFormIsActive = dept.IsActive;
    }

    private async Task SaveDepartmentAsync()
    {
        if (string.IsNullOrWhiteSpace(deptFormCode) || string.IsNullOrWhiteSpace(deptFormName))
        {
            catalogMessage = "Vui lòng nhập mã và tên phòng ban.";
            return;
        }

        try
        {
            if (editingDeptId == 0)
            {
                var req = new CreateDepartmentRequest(deptFormCode.Trim(), deptFormName.Trim(), deptFormDescription?.Trim());
                var res = await EmployeeApiClient.CreateDepartmentAsync(req);
                if (res?.Success == true)
                {
                    catalogMessage = $"Tạo phòng ban '{res.Data?.Name}' thành công!";
                    ResetDeptForm();
                    await ReloadCatalogsAsync();
                }
                else
                {
                    catalogMessage = res?.Error?.Message ?? "Không thể tạo phòng ban.";
                }
            }
            else
            {
                var req = new UpdateDepartmentRequest(deptFormCode.Trim(), deptFormName.Trim(), deptFormDescription?.Trim(), deptFormIsActive);
                var res = await EmployeeApiClient.UpdateDepartmentAsync(editingDeptId, req);
                if (res?.Success == true)
                {
                    catalogMessage = $"Cập nhật phòng ban '{res.Data?.Name}' thành công!";
                    ResetDeptForm();
                    await ReloadCatalogsAsync();
                }
                else
                {
                    catalogMessage = res?.Error?.Message ?? "Không thể cập nhật phòng ban.";
                }
            }
        }
        catch (Exception ex)
        {
            catalogMessage = "Lỗi: " + ex.Message;
        }
    }

    private void ResetPosForm()
    {
        editingPosId = 0;
        posFormCode = string.Empty;
        posFormName = string.Empty;
        posFormDepartmentId = 0;
        posFormAllowance = 0m;
        posFormIsActive = true;
    }

    private void EditPosition(PositionDto pos)
    {
        editingPosId = pos.Id;
        posFormCode = pos.Code ?? string.Empty;
        posFormName = pos.Name;
        posFormDepartmentId = pos.DepartmentId ?? 0;
        posFormAllowance = pos.DefaultPositionAllowance;
        posFormIsActive = pos.IsActive;
    }

    private async Task SavePositionAsync()
    {
        if (string.IsNullOrWhiteSpace(posFormCode) || string.IsNullOrWhiteSpace(posFormName))
        {
            catalogMessage = "Vui lòng nhập mã và tên chức danh.";
            return;
        }

        try
        {
            if (editingPosId == 0)
            {
                var req = new CreatePositionRequest(
                    Code: posFormCode.Trim(),
                    Name: posFormName.Trim(),
                    DepartmentId: posFormDepartmentId > 0 ? posFormDepartmentId : null,
                    DefaultPositionAllowance: posFormAllowance);

                var res = await EmployeeApiClient.CreatePositionAsync(req);
                if (res?.Success == true)
                {
                    catalogMessage = $"Tạo chức danh '{res.Data?.Name}' thành công!";
                    ResetPosForm();
                    await ReloadCatalogsAsync();
                }
                else
                {
                    catalogMessage = res?.Error?.Message ?? "Không thể tạo chức danh.";
                }
            }
            else
            {
                var req = new UpdatePositionRequest(
                    Code: posFormCode.Trim(),
                    Name: posFormName.Trim(),
                    DepartmentId: posFormDepartmentId > 0 ? posFormDepartmentId : null,
                    DefaultPositionAllowance: posFormAllowance,
                    IsActive: posFormIsActive);

                var res = await EmployeeApiClient.UpdatePositionAsync(editingPosId, req);
                if (res?.Success == true)
                {
                    catalogMessage = $"Cập nhật chức danh '{res.Data?.Name}' thành công!";
                    ResetPosForm();
                    await ReloadCatalogsAsync();
                }
                else
                {
                    catalogMessage = res?.Error?.Message ?? "Không thể cập nhật chức danh.";
                }
            }
        }
        catch (Exception ex)
        {
            catalogMessage = "Lỗi: " + ex.Message;
        }
    }

    private static readonly System.Globalization.CultureInfo viCulture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");

    private static string FormatSalaryNumber(decimal value) => value.ToString("#,##0", viCulture);

    private void OnBaseSalaryInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var digits = new string(raw.Where(char.IsDigit).ToArray());

        if (string.IsNullOrWhiteSpace(digits))
        {
            formBaseSalary = 0m;
            formBaseSalaryDisplay = string.Empty;
            return;
        }

        if (decimal.TryParse(digits, out var val))
        {
            if (val > 999_999_999_999m) val = 999_999_999_999m;
            formBaseSalary = val;
            formBaseSalaryDisplay = FormatSalaryNumber(val);
        }
    }

    private void OnBaseSalaryBlur()
    {
        if (string.IsNullOrWhiteSpace(formBaseSalaryDisplay) || formBaseSalary <= 0)
        {
            formBaseSalary = 0m;
            formBaseSalaryDisplay = "0";
        }
        else
        {
            formBaseSalaryDisplay = FormatSalaryNumber(formBaseSalary);
        }
    }

    private void AdjustBaseSalary(decimal delta)
    {
        var newVal = Math.Max(0, formBaseSalary + delta);
        if (newVal > 999_999_999_999m) newVal = 999_999_999_999m;
        formBaseSalary = newVal;
        formBaseSalaryDisplay = FormatSalaryNumber(newVal);
    }

    private static string FormatVnd(decimal amount) => amount.ToString("#,##0", viCulture) + " ₫";

