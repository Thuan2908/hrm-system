@page "/employee/payslips"
@page "/payslips"
@layout EmployeeLayout
@attribute [Authorize]
@inject IPayrollApiClient PayrollApiClient
@inject IJSRuntime JSRuntime
@inject BrowserSessionStore SessionStore

<PageTitle>Phiếu lương của tôi - Saigon Retail</PageTitle>

<div class="container-fluid px-0">
    <!-- Minimal Header (Hidden when printing) -->
    <div class="emp-page-header mb-4 d-print-none">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="emp-badge-tag">● MINH BẠCH THU NHẬP</span>
                </div>
                <h1 class="emp-page-title mb-1">Phiếu lương của tôi</h1>
                <p class="emp-page-desc mb-0">Tra cứu chi tiết thu nhập, ngày công và các khoản trích nộp bảo hiểm theo từng kỳ lương.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="emp-btn-secondary" @onclick="LoadDataAsync" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                </button>
            </div>
        </div>
    </div>

    <!-- View Mode Switch Tabs (Hidden when printing) -->
    <div class="card border-0 shadow-sm p-2 mb-4 d-print-none" style="border-radius: 12px; background-color: var(--emp-surface); border: 1px solid var(--emp-border) !important;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-inline-flex p-1 rounded-pill" style="background-color: var(--emp-surface-subtle); border: 1px solid var(--emp-border);">
                <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold @(!isYearlyView ? "text-white shadow-sm" : "btn-link text-secondary text-decoration-none")"
                        style="@(!isYearlyView ? "background-color: var(--emp-primary); border-color: var(--emp-primary);" : "")"
                        @onclick="() => SwitchView(false)">
                    <i class="bi bi-calendar3 me-1"></i> Phiếu lương theo tháng
                </button>
                <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold @(isYearlyView ? "text-white shadow-sm" : "btn-link text-secondary text-decoration-none")"
                        style="@(isYearlyView ? "background-color: var(--emp-primary); border-color: var(--emp-primary);" : "")"
                        @onclick="() => SwitchView(true)">
                    <i class="bi bi-bar-chart-line me-1"></i> Bảng kê thu nhập cả năm
                </button>
            </div>

            @if (isYearlyView)
            {
                <div class="d-flex align-items-center gap-2 flex-nowrap ms-auto">
                    <span class="small text-secondary fw-semibold text-nowrap">Chọn năm:</span>
                    <select class="form-select form-select-sm fw-bold rounded-pill bg-light border-0 shadow-none"
                            style="width: 130px; height: 36px; padding-left: 14px; padding-right: 32px !important; cursor: pointer; color: var(--emp-heading);"
                            value="@selectedYear" @onchange="OnYearChangedAsync">
                        <option value="2027">Năm 2027</option>
                        <option value="2026">Năm 2026</option>
                        <option value="2025">Năm 2025</option>
                        <option value="2024">Năm 2024</option>
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold shadow-sm text-nowrap d-inline-flex align-items-center gap-1"
                            style="height: 36px; color: var(--emp-primary); border-color: var(--emp-primary);"
                            @onclick="PrintPayslipAsync">
                        <i class="bi bi-printer me-1"></i>
                        <span>In bảng lương năm</span>
                    </button>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                    <span class="small text-secondary fw-semibold text-nowrap"><i class="bi bi-calendar-event me-1"></i>Kỳ lương:</span>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-secondary" title="Tháng trước" @onclick="() => ChangeMonthAsync(-1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" title="Tháng sau" @onclick="() => ChangeMonthAsync(1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                    <select class="form-select form-select-sm fw-bold rounded-pill bg-light border-0 shadow-none text-primary"
                            style="width: 120px; height: 36px; padding-left: 14px; cursor: pointer;"
                            value="@selectedMonth" @onchange="OnMonthChangedAsync">
                        @for (short m = 1; m <= 12; m++)
                        {
                            <option value="@m">Tháng @m</option>
                        }
                    </select>
                    <select class="form-select form-select-sm fw-bold rounded-pill bg-light border-0 shadow-none text-secondary"
                            style="width: 110px; height: 36px; padding-left: 14px; cursor: pointer;"
                            value="@selectedYear" @onchange="OnPeriodYearChangedAsync">
                        <option value="2027">Năm 2027</option>
                        <option value="2026">Năm 2026</option>
                        <option value="2025">Năm 2025</option>
                        <option value="2024">Năm 2024</option>
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold shadow-sm text-nowrap"
                            style="height: 36px;"
                            @onclick="SetCurrentPeriodAsync">
                        <i class="bi bi-clock-history me-1"></i> Hiện tại
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold shadow-sm text-nowrap d-inline-flex align-items-center gap-1"
                            style="height: 36px; color: var(--emp-primary); border-color: var(--emp-primary);"
                            @onclick="PrintPayslipAsync">
                        <i class="bi bi-printer me-1"></i> In phiếu
                    </button>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4 d-print-none" role="alert" style="border-radius: 12px; background: var(--emp-danger-bg); color: var(--emp-danger);">
            <span style="font-size: 1.25rem;">⚠</span>
            <div>@errorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!isYearlyView)
    {
        @if (isLoading && selectedPayslip is null)
        {
            <div class="py-5 text-center text-muted">
                <div class="spinner-border mb-3" style="color: var(--emp-primary);" role="status"></div>
                <p>Đang tải thông tin bảng lương...</p>
            </div>
        }
        else
        {
            <!-- Period Highlight Summary Card (Hidden when printing) -->
            @if (selectedPayslip is not null)
            {
                <div class="card border-0 shadow-sm mb-4 d-print-none" style="border-radius: 14px; background: var(--emp-surface); border: 1px solid var(--emp-border) !important; border-left: 5px solid var(--emp-primary) !important;">
                    <div class="card-body p-4">
                        <div class="row g-4 align-items-center">
                            <div class="col-12 col-md-4">
                                <span class="emp-kpi-label d-block mb-1">KỲ LƯƠNG ĐANG XEM</span>
                                <h4 class="fw-bold mb-1" style="color: var(--emp-heading);">Tháng @selectedPayslip.MonthPeriod/@selectedPayslip.YearPeriod</h4>
                                @if (selectedPayslip.Id > 0)
                                {
                                    <span class="emp-badge-success">
                                        ✓ Đã chốt sổ / Đã điều chỉnh
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning px-2 py-1 rounded-pill small">
                                        ● Dự tính thời gian thực (Realtime)
                                    </span>
                                }
                            </div>
                            <div class="col-6 col-md-4 text-md-center">
                                <span class="emp-kpi-label d-block mb-1">NGÀY CÔNG THỰC TẾ</span>
                                <span class="fs-3 fw-bold tabular-nums" style="color: var(--emp-heading);">@selectedPayslip.ActualDays.ToString("0.#")</span>
                                <small class="text-muted d-block">/ @selectedPayslip.StandardWorkingDays.ToString("0.#") ngày chuẩn</small>
                            </div>
                            <div class="col-6 col-md-4 text-md-end">
                                <span class="emp-kpi-label d-block mb-1">THỰC LĨNH (NET)</span>
                                <span class="fs-2 fw-bold font-monospace tabular-nums" style="color: var(--emp-primary);">@FormatVnd(selectedPayslip.NetSalary)</span>
                                <small class="text-muted d-block">Thu nhập chuyển khoản thực nhận</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="row g-4">
                <!-- Left Column: Period List (Hidden when printing) -->
                <div class="col-12 col-lg-4 d-print-none">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 14px;">
                        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                            <strong style="color: var(--emp-heading); font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.05em;">DANH SÁCH 12 THÁNG (@selectedYear)</strong>
                            <span class="badge bg-light text-muted border">@payslips.Count kỳ</span>
                        </div>
                        <div class="list-group list-group-flush p-2" style="max-height: 600px; overflow-y: auto;">
                            @for (short m = 12; m >= 1; m--)
                            {
                                var monthItem = m;
                                var isCurrent = selectedMonth == monthItem;
                                var matched = payslips.FirstOrDefault(p => p.MonthPeriod == monthItem);
                                var days = matched?.ActualDays ?? 22m;
                                var net = matched?.NetSalary ?? (selectedPayslip?.MonthPeriod == monthItem ? selectedPayslip.NetSalary : 0m);

                                <button type="button"
                                        class="list-group-item list-group-item-action p-3 rounded-3 mb-2 border-0 d-flex justify-content-between align-items-center"
                                        style="@(isCurrent ? "background: var(--emp-primary-subtle); color: var(--emp-primary); font-weight: 700; border: 1px solid var(--emp-primary-light) !important;" : "")"
                                        @onclick="() => SelectMonthAsync(monthItem)">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold fs-6">Tháng @monthItem/@selectedYear</span>
                                            @if (matched != null && matched.Id > 0)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success" style="font-size: 7pt;">Đã chốt</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-secondary border" style="font-size: 7pt;">Xem trước</span>
                                            }
                                        </div>
                                        <div class="small text-muted">@days.ToString("0.#") công thực tế</div>
                                    </div>
                                    <div class="text-end">
                                        @if (net > 0)
                                        {
                                            <div class="fw-bold font-monospace tabular-nums" style="color: var(--emp-primary);">@FormatVnd(net)</div>
                                        }
                                        else
                                        {
                                            <div class="text-muted small">Bấm xem →</div>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right Column: Payslip Detailed Breakdown -->
                <div class="col-12 col-lg-8">
                    @if (isLoadingDetail)
                    {
                        <div class="card border-0 shadow-sm p-5 text-center text-muted" style="border-radius: 16px;">
                            <div class="spinner-border text-success mb-3" role="status"></div>
                            <p>Đang tải chi tiết phiếu lương...</p>
                        </div>
                    }
                    else if (selectedPayslip is not null)
                    {
                    <div id="printable-payslip" class="card border-0 shadow-sm" style="border-radius: 16px;">
                        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center d-print-none">
                            <div>
                                <strong class="text-dark fs-5">BẢNG KÊ CHI TIẾT THU NHẬP</strong>
                                <small class="text-muted d-block">Kỳ lương: Tháng @selectedPayslip.MonthPeriod năm @selectedPayslip.YearPeriod</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold shadow-sm"
                                        @onclick="PrintPayslipAsync">
                                    <i class="bi bi-printer me-1"></i> In phiếu lương
                                </button>
                                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill font-monospace">
                                    ID: #@selectedPayslip.Id
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-4 payslip-body">
                            <!-- Print Header (Visible ONLY on Print/PDF) -->
                            <div class="d-none d-print-block pb-3 mb-3 border-bottom payslip-print-header">
                                <!-- Top 2-Column Corporate Header -->
                                <div class="d-flex justify-content-between align-items-start mb-3" style="font-size: 8.5pt; line-height: 1.35;">
                                    <div style="width: 55%;">
                                        <div class="fw-bold text-uppercase" style="font-size: 9.5pt; color: #0f172a;">CÔNG TY CỔ PHẦN SAIGON RETAIL</div>
                                        <div class="text-secondary">Phòng Quản trị Nhân sự &amp; Tiền lương</div>
                                        <div class="text-secondary">Địa chỉ: 123 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. HCM</div>
                                    </div>
                                    <div class="text-end" style="width: 45%;">
                                        <div class="fw-bold text-uppercase" style="font-size: 9pt; color: #0f172a;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                                        <div class="fw-semibold fst-italic" style="font-size: 8pt;">Độc lập - Tự do - Hạnh phúc</div>
                                        <div class="text-muted mt-1" style="font-size: 7.5pt;">Mẫu số: 01/PL-HRM (Kèm theo QĐ Lương)</div>
                                    </div>
                                </div>

                                <!-- Centered Document Title -->
                                <div class="text-center my-3">
                                    <h2 class="fw-bold text-uppercase text-dark mb-1" style="font-size: 13pt; letter-spacing: 0.5px;">
                                        PHIẾU LƯƠNG NHÂN VIÊN CHI TIẾT
                                    </h2>
                                    <div class="fst-italic text-secondary" style="font-size: 8.5pt;">
                                        (Kỳ chi trả: Tháng @selectedPayslip.MonthPeriod năm @selectedPayslip.YearPeriod)
                                    </div>
                                </div>

                                <!-- Employee Information Box (2-column key-value) -->
                                <div class="p-2 rounded mb-2" style="background-color: #f8fafc; border: 1px solid #e2e8f0; font-size: 8.5pt;">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <span>Họ và tên người lao động:</span>
                                            <strong class="text-dark ms-1">@(employeeFullName ?? "Nhân viên")</strong>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span>Mã số hồ sơ nhân sự:</span>
                                            <strong class="text-dark ms-1">#@selectedPayslip.EmployeeId.ToString("D5")</strong>
                                        </div>
                                        <div class="col-6">
                                            <span>Ngày công thực tế ghi nhận:</span>
                                            <strong class="text-dark ms-1">@selectedPayslip.ActualDays.ToString("0.#") ngày</strong>
                                            <span class="text-muted small"> (chuẩn 22 ngày)</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span>Mã phiếu / Thời điểm in:</span>
                                            <strong class="text-dark ms-1">#PL-@selectedPayslip.Id.ToString("D5")</strong>
                                            <span class="text-muted small"> (@DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Structured Table of Earnings and Deductions -->
                            <div class="table-responsive mb-3">
                                <table class="table table-bordered align-middle mb-0" style="border-color: #cbd5e1;">
                                    <thead class="table-light small text-secondary">
                                        <tr>
                                            <th class="text-center" style="width: 8%;">STT</th>
                                            <th style="width: 48%;">KHOẢN MỤC THU NHẬP &amp; KHẤU TRỪ</th>
                                            <th class="text-center" style="width: 20%;">CĂN CỨ TÍNH TOÁN</th>
                                            <th class="text-end" style="width: 24%;">SỐ TIỀN (VNĐ)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- SECTION A: THU NHẬP -->
                                        <tr style="background-color: #f8fafc;">
                                            <td colspan="4" class="fw-bold text-success py-2">
                                                A. CÁC KHOẢN THU NHẬP (GROSS SALARY &amp; THƯỞNG)
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center">1</td>
                                            <td>
                                                <div class="fw-semibold">Số ngày công làm việc thực tế ghi nhận</div>
                                                <small class="text-muted">Căn cứ: Điểm danh Chấm công + Đơn nghỉ phép có lương (hoặc Điều chỉnh bởi Phòng Nhân sự)</small>
                                            </td>
                                            <td class="text-center">
                                                <span class="fw-bold text-primary">@selectedPayslip.ActualDays.ToString("0.#") ngày</span>
                                                <span class="text-muted small"> / @selectedPayslip.StandardWorkingDays.ToString("0.#") ngày chuẩn</span>
                                            </td>
                                            <td class="text-end font-monospace fw-bold">@selectedPayslip.ActualDays.ToString("0.#") công</td>
                                        </tr>
                                        <tr>
                                            <td class="text-center">2</td>
                                            <td>
                                                <div class="fw-semibold">Lương vị trí theo tỷ lệ ngày công thực tế</div>
                                                <small class="text-muted">Công thức: (@FormatVnd(selectedPayslip.SnapshotBaseSalary + selectedPayslip.SnapshotPositionAllowance) / @selectedPayslip.StandardWorkingDays.ToString("0.#")) × @selectedPayslip.ActualDays.ToString("0.#") công</small>
                                            </td>
                                            <td class="text-center text-muted small">Tỷ lệ công thực tế</td>
                                            <td class="text-end font-monospace fw-semibold text-dark">
                                                @FormatVnd(Math.Round((selectedPayslip.SnapshotBaseSalary + selectedPayslip.SnapshotPositionAllowance) / (selectedPayslip.StandardWorkingDays > 0 ? selectedPayslip.StandardWorkingDays : 22m) * selectedPayslip.ActualDays, 0))
                                            </td>
                                        </tr>
                                        @if (selectedPayslip.SnapshotOtherAllowance > 0)
                                        {
                                            <tr>
                                                <td class="text-center">3</td>
                                                <td>
                                                    <div class="fw-semibold">Phụ cấp ăn trưa / Hỗ trợ cố định</div>
                                                    <small class="text-muted">Khoản phụ cấp không trừ theo ngày công</small>
                                                </td>
                                                <td class="text-center text-muted small">Khoản cố định</td>
                                                <td class="text-end font-monospace text-dark">@FormatVnd(selectedPayslip.SnapshotOtherAllowance)</td>
                                            </tr>
                                        }
                                        @if (selectedPayslip.BonusAmount > 0)
                                        {
                                            <tr>
                                                <td class="text-center">@(selectedPayslip.SnapshotOtherAllowance > 0 ? "4" : "3")</td>
                                                <td>
                                                    <div class="fw-semibold text-success">Thưởng hiệu quả công việc / Dự án (+)</div>
                                                    <small class="text-muted">Khen thưởng theo hiệu suất hoặc KPI tháng</small>
                                                </td>
                                                <td class="text-center text-success small">Khen thưởng kỳ này</td>
                                                <td class="text-end font-monospace text-success fw-bold">+@FormatVnd(selectedPayslip.BonusAmount)</td>
                                            </tr>
                                        }
                                        <tr class="fw-bold" style="background-color: #f0fdf4;">
                                            <td colspan="3" class="text-dark">TỔNG THU NHẬP (GROSS + THƯỞNG):</td>
                                            <td class="text-end text-success font-monospace">@FormatVnd(selectedPayslip.GrossSalary + selectedPayslip.BonusAmount)</td>
                                        </tr>

                                        <!-- SECTION B: KHẤU TRỪ -->
                                        <tr style="background-color: #f8fafc;">
                                            <td colspan="4" class="fw-bold text-danger py-2">
                                                B. CÁC KHOẢN TRÍCH NỘP &amp; NGHĨA VỤ THUẾ THEO LUẬT
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center">1</td>
                                            <td>
                                                <div class="fw-semibold">Bảo hiểm Bắt buộc (BHXH, BHYT, BHTN: 10.5%)</div>
                                                <small class="text-muted">8% BHXH + 1.5% BHYT + 1% BHTN (áp trần 46.800.000đ theo mức lương cơ sở)</small>
                                            </td>
                                            <td class="text-center text-muted small">10.5% lương đóng BHXH</td>
                                            <td class="text-end font-monospace text-danger">-@FormatVnd(selectedPayslip.BhxhDeduct)</td>
                                        </tr>
                                        <tr>
                                            <td class="text-center">2</td>
                                            <td>
                                                <div class="fw-semibold text-secondary">Giảm trừ gia cảnh bản thân (Luật thuế TNCN)</div>
                                                <small class="text-muted">Mức giảm trừ cá nhân cố định theo quy định</small>
                                            </td>
                                            <td class="text-center text-secondary small">Cố định / tháng</td>
                                            <td class="text-end font-monospace text-secondary">-11.000.000 ₫</td>
                                        </tr>
                                        <tr class="small" style="background-color: #fafafa;">
                                            <td class="text-center text-muted">ℹ</td>
                                            <td colspan="2" class="text-muted fst-italic">
                                                Thu nhập tính thuế TNCN = (Gross + Thưởng) - BHXH - Giảm trừ gia cảnh (11tr)
                                            </td>
                                            <td class="text-end font-monospace fw-semibold text-dark">
                                                @FormatVnd(Math.Max(0m, selectedPayslip.GrossSalary + selectedPayslip.BonusAmount - selectedPayslip.BhxhDeduct - 11_000_000m))
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center">3</td>
                                            <td>
                                                <div class="fw-semibold text-danger">Thuế Thu nhập Cá nhân tạm trích (TNCN)</div>
                                                <small class="text-muted">Áp dụng Biểu thuế lũy tiến từng phần 5 bậc mới</small>
                                            </td>
                                            <td class="text-center text-muted small">Biểu 5 bậc mới</td>
                                            <td class="text-end font-monospace text-danger fw-semibold">-@FormatVnd(selectedPayslip.TaxDeduct)</td>
                                        </tr>
                                        @if (selectedPayslip.Deductions > 0)
                                        {
                                            <tr>
                                                <td class="text-center">4</td>
                                                <td>
                                                    <div class="fw-semibold text-danger">Khoản phạt vi phạm nội quy / Tạm ứng (-)</div>
                                                    <small class="text-muted">Khấu trừ trực tiếp vào lương sau thuế</small>
                                                </td>
                                                <td class="text-center text-danger small">Khấu trừ nội bộ</td>
                                                <td class="text-end font-monospace text-danger">-@FormatVnd(selectedPayslip.Deductions)</td>
                                            </tr>
                                        }
                                        <tr class="fw-bold" style="background-color: #fef2f2;">
                                            <td colspan="3" class="text-dark">TỔNG CÁC KHOẢN TRÍCH NỘP &amp; KHẤU TRỪ:</td>
                                            <td class="text-end text-danger font-monospace">-@FormatVnd(selectedPayslip.BhxhDeduct + selectedPayslip.TaxDeduct + selectedPayslip.Deductions)</td>
                                        </tr>

                                        <!-- SECTION C: NET PAY -->
                                        <tr style="background-color: #ecfdf5; border-top: 2px solid #10b981;">
                                            <td colspan="3" class="py-3">
                                                <div class="fw-bold text-success text-uppercase" style="font-size: 1rem;">
