@code {
    private IReadOnlyList<PayslipSummaryDto> payslips = [];
    private PayslipDetailDto? selectedPayslip;
    private YearlyPayrollSummaryDto? yearlySummary;
    private bool isYearlyView = false;
    private short selectedMonth = (short)DateTime.Today.Month;
    private short selectedYear = (short)DateTime.Today.Year;
    private bool isLoading = true;
    private bool isLoadingDetail = false;
    private bool isLoadingYearly = false;
    private string? errorMessage;
    private string? employeeFullName;

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionStore.GetAsync();
        employeeFullName = session?.User.FullName ?? session?.User.UserName;
        await LoadDataAsync();
    }

    private async Task SwitchView(bool yearly)
    {
        isYearlyView = yearly;
        if (isYearlyView && yearlySummary == null)
        {
            await LoadYearlyPayslipsAsync();
        }
    }

    private async Task OnYearChangedAsync(ChangeEventArgs e)
    {
        if (short.TryParse(e.Value?.ToString(), out var year))
        {
            selectedYear = year;
            await LoadYearlyPayslipsAsync();
        }
    }

    private async Task OnPeriodYearChangedAsync(ChangeEventArgs e)
    {
        if (short.TryParse(e.Value?.ToString(), out var year))
        {
            selectedYear = year;
            await LoadDataAsync();
        }
    }

    private async Task OnMonthChangedAsync(ChangeEventArgs e)
    {
        if (short.TryParse(e.Value?.ToString(), out var month) && month is >= 1 and <= 12)
        {
            selectedMonth = month;
            await LoadPeriodPayslipAsync();
        }
    }

    private async Task ChangeMonthAsync(int delta)
    {
        var newMonth = selectedMonth + delta;
        if (newMonth < 1)
        {
            selectedMonth = 12;
            selectedYear--;
        }
        else if (newMonth > 12)
        {
            selectedMonth = 1;
            selectedYear++;
        }
        else
        {
            selectedMonth = (short)newMonth;
        }

        await LoadDataAsync();
    }

    private async Task SetCurrentPeriodAsync()
    {
        selectedMonth = (short)DateTime.Today.Month;
        selectedYear = (short)DateTime.Today.Year;
        await LoadDataAsync();
    }

    private async Task SelectMonthAsync(short month)
    {
        selectedMonth = month;
        await LoadPeriodPayslipAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            // Tải danh sách các kỳ lương của năm đang chọn
            payslips = await PayrollApiClient.GetMyPayslipsAsync(selectedYear);
            // Tải chi tiết chuẩn công thức cho tháng và năm đang chọn
            await LoadPeriodPayslipAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Không thể tải danh sách phiếu lương: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPeriodPayslipAsync()
    {
        isLoadingDetail = true;
        try
        {
            selectedPayslip = await PayrollApiClient.GetPayslipByPeriodAsync(selectedMonth, selectedYear);
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải phiếu lương Tháng {selectedMonth}/{selectedYear}: " + ex.Message;
        }
        finally
        {
            isLoadingDetail = false;
        }
    }

    private async Task LoadYearlyPayslipsAsync()
    {
        isLoadingYearly = true;
        errorMessage = null;
        try
        {
            yearlySummary = await PayrollApiClient.GetMyYearlyPayslipsAsync(selectedYear);
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi tải bảng kê thu nhập năm: " + ex.Message;
        }
        finally
        {
            isLoadingYearly = false;
        }
    }

    private async Task PrintPayslipAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private static string FormatVnd(decimal amount) =>
        amount.ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")) + " ₫";
}
