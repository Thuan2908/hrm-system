@page "/employee/payslips"
@page "/payslips"
@layout EmployeeLayout
@attribute [Authorize]
@inject IPayrollApiClient PayrollApiClient
@inject IJSRuntime JSRuntime
@inject BrowserSessionStore SessionStore

<PageTitle>Phiếu lương của tôi - Saigon Retail</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Hero Banner (Hidden when printing) -->
    <div class="card border-0 shadow-sm mb-4 d-print-none" style="background: linear-gradient(135deg, #052e22 0%, #065f46 50%, #047857 100%); color: white; border-radius: 18px; box-shadow: 0 12px 30px rgba(5, 46, 34, 0.25) !important;">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge text-white mb-2 px-3 py-1" style="background-color: #10b981; font-size: 0.85rem; border-radius: 20px; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);">
                    ● MINH BẠCH THU NHẬP
                </span>
                <h1 class="h3 fw-bold mb-1 text-white">Phiếu lương của tôi</h1>
                <p class="mb-0 text-white-50">Tra cứu chi tiết thu nhập, ngày công và các khoản trích nộp bảo hiểm theo từng kỳ lương.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-light rounded-pill px-4 py-2" @onclick="LoadDataAsync" disabled="@isLoading">
                    ↻ Làm mới
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4 d-print-none" role="alert" style="border-radius: 12px;">
            <span style="font-size: 1.25rem;">⚠</span>
            <div>@errorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (isLoading && payslips.Count == 0)
    {
        <div class="py-5 text-center text-muted">
            <div class="spinner-border text-success mb-3" role="status"></div>
            <p>Đang tải thông tin bảng lương...</p>
        </div>
    }
    else if (payslips.Count == 0)
    {
        <div class="card border-0 shadow-sm p-5 text-center text-muted" style="border-radius: 16px;">
            <div class="display-5 text-secondary mb-3">📄</div>
            <h5 class="fw-bold text-dark">Chưa có phiếu lương nào</h5>
            <p class="mb-0">Phiếu lương sẽ được phát hành sau khi phòng Nhân sự &amp; Kế toán hoàn tất chốt bảng công hàng tháng.</p>
        </div>
    }
    else
    {
        <!-- Latest Period Highlight Card (Hidden when printing) -->
        @if (selectedPayslip is not null)
        {
            <div class="card border-0 shadow-sm mb-4 d-print-none" style="border-radius: 16px; background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%); border-left: 6px solid #10b981 !important;">
                <div class="card-body p-4">
                    <div class="row g-4 align-items-center">
                        <div class="col-12 col-md-4">
                            <span class="text-uppercase small text-muted fw-bold d-block mb-1">KỲ LƯƠNG ĐANG XEM</span>
                            <h4 class="fw-bold text-dark mb-1">Tháng @selectedPayslip.MonthPeriod/@selectedPayslip.YearPeriod</h4>
                            <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill">
                                ✓ Đã quyết toán
                            </span>
                        </div>
                        <div class="col-6 col-md-4 text-md-center">
                            <span class="text-uppercase small text-muted fw-bold d-block mb-1">NGÀY CÔNG THỰC TẾ</span>
                            <span class="fs-3 fw-bold text-dark">@selectedPayslip.ActualDays</span>
                            <small class="text-muted d-block">ngày làm việc ghi nhận</small>
                        </div>
                        <div class="col-6 col-md-4 text-md-end">
                            <span class="text-uppercase small text-muted fw-bold d-block mb-1">THỰC LĨNH (NET)</span>
                            <span class="fs-2 fw-bold text-success font-monospace">@FormatVnd(selectedPayslip.NetSalary)</span>
                            <small class="text-muted d-block">Đã thanh toán chuyển khoản</small>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <!-- Left Column: Period List (Hidden when printing) -->
            <div class="col-12 col-lg-4 d-print-none">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                    <div class="card-header bg-white border-bottom border-light py-3 px-4">
                        <strong class="text-dark">DANH SÁCH KỲ LƯƠNG</strong>
                    </div>
                    <div class="list-group list-group-flush p-2">
                        @foreach (var item in payslips)
                        {
                            var isCurrent = selectedPayslip?.Id == item.Id;
                            <button type="button"
                                    class="list-group-item list-group-item-action p-3 rounded-3 mb-2 border-0 d-flex justify-content-between align-items-center @(isCurrent ? "bg-success-subtle text-success fw-bold border border-success-subtle" : "")"
                                    @onclick="() => SelectPayslipAsync(item.Id)">
                                <div>
                                    <div class="fw-bold fs-6">Tháng @item.MonthPeriod/@item.YearPeriod</div>
                                    <div class="small text-muted">@item.ActualDays ngày công</div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-success font-monospace">@FormatVnd(item.NetSalary)</div>
                                    <small class="text-muted">Chi tiết →</small>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Payslip Detailed Breakdown -->
            <div class="col-12 col-lg-8">
                @if (isLoadingDetail)
                {
                    <div class="card border-0 shadow-sm p-5 text-center text-muted" style="border-radius: 16px;">
                        <div class="spinner-border text-success mb-3" role="status"></div>
                        <p>Đang tải chi tiết phiếu lương...</p>
                    </div>
                }
                else if (selectedPayslip is not null)
                {
                    <div id="printable-payslip" class="card border-0 shadow-sm" style="border-radius: 16px;">
                        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="text-dark fs-5">BẢNG KÊ CHI TIẾT THU NHẬP</strong>
                                <small class="text-muted d-block">Kỳ lương: Tháng @selectedPayslip.MonthPeriod năm @selectedPayslip.YearPeriod</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold shadow-sm d-print-none"
                                        @onclick="PrintPayslipAsync">
                                    🖨️ In phiếu lương
                                </button>
                                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill font-monospace d-print-none">
                                    ID: #@selectedPayslip.Id
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-4 payslip-body">
                            <!-- Print Header (Visible only on Print/PDF) -->
                            <div class="d-none d-print-block text-center pb-2 mb-3 border-bottom payslip-print-header">
                                <div class="fw-bold text-uppercase fs-6">CÔNG TY CỔ PHẦN SAIGON RETAIL</div>
                                <div class="small text-muted" style="font-size: 8.5pt;">Hệ thống Quản trị Nhân sự &amp; Tiền lương</div>
                                <h3 class="fw-bold mt-2 mb-1 text-dark" style="font-size: 15pt;">PHIẾU LƯƠNG NHÂN VIÊN</h3>
                                <div class="text-secondary fw-semibold small">Kỳ lương: Tháng @selectedPayslip.MonthPeriod năm @selectedPayslip.YearPeriod</div>
                                <div class="mt-2 small text-secondary d-flex justify-content-between px-2" style="font-size: 9pt;">
                                    <span>Họ và tên: <strong class="text-dark">@(employeeFullName ?? "Nhân viên")</strong></span>
                                    <span>Mã phiếu: <strong class="text-dark">#@selectedPayslip.Id</strong></span>
                                    <span>Ngày in: <strong class="text-dark">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</strong></span>
                                </div>
                            </div>

                            <!-- Section A: Thu nhập -->
                            <div class="mb-3 payslip-section">
                                <h6 class="fw-bold text-success mb-2 border-bottom pb-1" style="font-size: 10pt;">
                                    A. CÁC KHOẢN THU NHẬP (GROSS)
                                </h6>
                                <table class="table table-sm table-borderless align-middle mb-0">
                                    <tbody>
                                        <tr>
                                            <td class="text-muted py-1">1. Số ngày công thực tế ghi nhận</td>
                                            <td class="text-end fw-bold text-dark py-1">@selectedPayslip.ActualDays ngày</td>
                                        </tr>
                                        <tr class="border-top">
                                            <td class="fw-bold text-dark pt-1 pb-1">TỔNG THU NHẬP GỘP (GROSS):</td>
                                            <td class="text-end fw-bold text-success pt-1 pb-1 font-monospace">
                                                @FormatVnd(selectedPayslip.GrossSalary)
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Section B: Khấu trừ -->
                            <div class="mb-3 payslip-section">
                                <h6 class="fw-bold text-danger mb-2 border-bottom pb-1" style="font-size: 10pt;">
                                    B. CÁC KHOẢN TRÍCH NỘP &amp; KHẤU TRỪ THEO LUẬT
                                </h6>
                                <table class="table table-sm table-borderless align-middle mb-0">
                                    <tbody>
                                        <tr>
                                            <td class="text-muted py-1">1. Bảo hiểm Xã hội, Y tế, Thất nghiệp (BHXH)</td>
                                            <td class="text-end text-danger py-1"> - @FormatVnd(selectedPayslip.BhxhDeduct)</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted py-1">2. Thuế Thu nhập Cá nhân (TNCN)</td>
                                            <td class="text-end text-danger py-1"> - @FormatVnd(selectedPayslip.TaxDeduct)</td>
                                        </tr>
                                        <tr class="border-top">
                                            <td class="fw-bold text-dark pt-1 pb-1">TỔNG CÁC KHOẢN KHẤU TRỪ:</td>
                                            <td class="text-end fw-bold text-danger pt-1 pb-1 font-monospace">
                                                - @FormatVnd(selectedPayslip.BhxhDeduct + selectedPayslip.TaxDeduct)
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Section C: Thực lĩnh Net -->
                            <div class="p-3 rounded-3 d-flex justify-content-between align-items-center mb-3 payslip-net-box"
                                 style="background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border: 1px solid #10b981;">
                                <div>
                                    <small class="text-success text-uppercase fw-bold d-block" style="font-size: 8.5pt;">THỰC LĨNH CHUYỂN KHOẢN (NET)</small>
                                    <span class="text-muted small" style="font-size: 8pt;">Đã bao gồm phụ cấp và trừ nghĩa vụ bảo hiểm &amp; thuế</span>
                                </div>
                                <div class="text-end">
                                    <span class="fs-3 fw-bold text-success font-monospace">@FormatVnd(selectedPayslip.NetSalary)</span>
                                </div>
                            </div>

                            <!-- Print Signatures (Visible only on Print/PDF) -->
                            <div class="d-none d-print-flex justify-content-between mt-3 pt-2 text-center payslip-signatures">
                                <div style="width: 30%;">
                                    <div class="fw-bold" style="font-size: 9.5pt;">Người lập biểu</div>
                                    <div class="text-muted fst-italic" style="font-size: 8pt;">(Ký, ghi rõ họ tên)</div>
                                    <div style="height: 48px;"></div>
                                </div>
                                <div style="width: 30%;">
                                    <div class="fw-bold" style="font-size: 9.5pt;">Kế toán trưởng</div>
                                    <div class="text-muted fst-italic" style="font-size: 8pt;">(Ký, ghi rõ họ tên)</div>
                                    <div style="height: 48px;"></div>
                                </div>
                                <div style="width: 30%;">
                                    <div class="fw-bold" style="font-size: 9.5pt;">Người nhận (Nhân viên)</div>
                                    <div class="text-muted fst-italic" style="font-size: 8pt;">(Ký, ghi rõ họ tên)</div>
                                    <div style="height: 48px;"></div>
                                    <div class="fw-semibold text-dark" style="font-size: 9pt;">@(employeeFullName ?? "")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<PayslipSummaryDto> payslips = [];
    private PayslipDetailDto? selectedPayslip;
    private bool isLoading = true;
    private bool isLoadingDetail = false;
    private string? errorMessage;
    private string? employeeFullName;

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionStore.GetAsync();
        employeeFullName = session?.User.FullName ?? session?.User.UserName;
        await LoadDataAsync();
    }

    private async Task PrintPayslipAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            payslips = await PayrollApiClient.GetMyPayslipsAsync();
            if (payslips.Count > 0)
            {
                await SelectPayslipAsync(payslips[0].Id);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Không thể tải danh sách phiếu lương: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectPayslipAsync(long id)
    {
        isLoadingDetail = true;
        try
        {
            selectedPayslip = await PayrollApiClient.GetPayslipDetailAsync(id);
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi lấy chi tiết phiếu lương: " + ex.Message;
        }
        finally
        {
            isLoadingDetail = false;
        }
    }

    private static string FormatVnd(decimal amount) =>
        amount.ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")) + " ₫";
}
