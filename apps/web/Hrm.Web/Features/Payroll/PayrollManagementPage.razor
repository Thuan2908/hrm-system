@page "/employee/payroll-management"
@page "/payroll/management"
@layout EmployeeLayout
@attribute [Authorize]
@inject IPayrollManagementApiClient PayrollManagementApiClient

<PageTitle>Quản lý &amp; Chốt bảng lương - Saigon Retail</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Hero Banner -->
    <div class="emp-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="emp-page-header-subtitle d-flex align-items-center gap-2">
                <i class="bi bi-cash-coin text-primary"></i>
                <span>QUẢN LÝ TIỀN LƯƠNG &amp; ĐÃI NGỘ</span>
            </div>
            <h1 class="emp-page-header-title">Quản lý &amp; Chốt bảng lương toàn doanh nghiệp</h1>
            <p class="emp-page-header-desc">Tính toán ngày công thực tế (Chấm công + Nghỉ phép hưởng lương), trần BHXH 10.5%, biểu thuế TNCN 5 bậc mới và điều chỉnh linh hoạt.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a class="btn emp-btn-secondary" href="employee/payslips">
                <i class="bi bi-wallet2 me-1"></i> Phiếu lương của tôi
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46;">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@successMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Toolbar: Month/Year selector & Run payroll button -->
    <div class="card emp-card mb-4">
        <div class="card-body p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="fw-semibold text-secondary small me-1"><i class="bi bi-calendar3 me-1"></i>Kỳ lương:</span>
                
                <div class="btn-group btn-group-sm me-1" role="group">
                    <button type="button" class="btn btn-outline-secondary" title="Tháng trước" @onclick="() => ChangeMonth(-1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" title="Tháng sau" @onclick="() => ChangeMonth(1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <select class="form-select form-select-sm fw-bold text-primary" value="@selectedMonth" @onchange="OnMonthChangedAsync" style="width: 120px; border-radius: 8px;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">Tháng @m</option>
                        }
                    </select>
                    <select class="form-select form-select-sm fw-bold text-secondary" value="@selectedYear" @onchange="OnYearChangedAsync" style="width: 100px; border-radius: 8px;">
                        <option value="2027">2027</option>
                        <option value="2026">2026</option>
                        <option value="2025">2025</option>
                        <option value="2024">2024</option>
                    </select>
                </div>

                <button class="btn btn-sm btn-outline-primary" @onclick="SetCurrentPeriodAsync" title="Chuyển về kỳ lương hiện tại">
                    <i class="bi bi-clock-history me-1"></i> Hiện tại
                </button>

                <button class="btn btn-sm emp-btn-secondary" @onclick="LoadPayrollRecordsAsync" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise me-1"></i> Tải lại
                </button>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn emp-btn-primary"
                        disabled="@isCalculating"
                        @onclick="RunPayrollCalculationAsync">
                    @if (isCalculating)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Đang tính toán lương...</span>
                    }
                    else
                    {
                        <span><i class="bi bi-play-circle-fill me-1"></i> Chạy tính lương Tháng @selectedMonth/@selectedYear</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- KPI Summary Row for Selected Period -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card emp-kpi-card p-3 h-100">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="emp-kpi-label">Số nhân sự chốt lương</span>
                    <span class="emp-badge emp-badge-neutral">Kỳ @selectedMonth/@selectedYear</span>
                </div>
                <div class="emp-kpi-value mt-1 tabular-nums">@payrollRecords.Count</div>
                <div class="small text-muted mt-1">Nhân viên có dữ liệu kỳ này</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card emp-kpi-card p-3 h-100">
                <div class="emp-kpi-label">Tổng quỹ lương GROSS</div>
                <div class="emp-kpi-value mt-1 tabular-nums">@FormatVnd(payrollRecords.Sum(r => r.GrossSalary))</div>
                <div class="small text-muted mt-1">Thưởng: <span class="text-success fw-bold">+@FormatVnd(payrollRecords.Sum(r => r.BonusAmount))</span></div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card emp-kpi-card p-3 h-100">
                <div class="emp-kpi-label">Tổng trích nộp (BHXH + Thuế)</div>
                <div class="fs-4 fw-bold text-danger font-monospace mt-1 tabular-nums">-@FormatVnd(payrollRecords.Sum(r => r.BhxhDeduct + r.TaxDeduct))</div>
                <div class="small text-muted mt-1">Phạt/Khấu trừ: <span class="text-danger fw-bold">-@FormatVnd(payrollRecords.Sum(r => r.Deductions))</span></div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card emp-kpi-card p-3 h-100" style="border-left: 4px solid var(--emp-primary) !important;">
                <div class="emp-kpi-label text-success fw-bold">Tổng chi trả thực lĩnh (NET)</div>
                <div class="fs-4 fw-bold text-success font-monospace mt-1 tabular-nums">@FormatVnd(payrollRecords.Sum(r => r.NetSalary))</div>
                <div class="small text-muted mt-1">Tổng thực nhận chuyển khoản cho nhân viên</div>
            </div>
        </div>
    </div>

    <!-- Payroll Records Table with Pagination -->
    <div class="card emp-card">
        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-table text-primary fs-5"></i>
                <div>
                    <strong class="text-dark fs-6 text-uppercase fw-bold" style="letter-spacing: 0.5px;">Bảng Lương Chi Tiết Toàn Doanh Nghiệp</strong>
                    <div class="text-muted small">Kỳ lương Tháng @selectedMonth năm @selectedYear · @payrollRecords.Count nhân sự</div>
                </div>
            </div>
            <span class="emp-badge emp-badge-success">
                <i class="bi bi-check-circle me-1"></i> Biểu thuế 5 bậc &amp; Chuẩn công thực tế
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table emp-table align-middle mb-0">
                    <thead class="table-light text-secondary small">
                        <tr>
                            <th class="ps-4">NHÂN VIÊN</th>
                            <th>PHÒNG BAN</th>
                            <th>CÔNG THỰC TẾ</th>
                            <th>LƯƠNG GROSS</th>
                            <th>THƯỞNG (+)</th>
                            <th>KHẤU TRỪ (-)</th>
                            <th>BHXH (10.5%)</th>
                            <th>THUẾ TNCN</th>
                            <th>NET THỰC LĨNH</th>
                            <th class="pe-4 text-center">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (payrollRecords.Count == 0 && !isLoading)
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder2-open fs-1 text-muted d-block mb-2"></i>
                                    <div>Chưa có dữ liệu bảng lương cho Tháng @selectedMonth/@selectedYear.</div>
                                    <div class="small text-muted mt-1">Bấm nút <strong>"Chạy tính lương"</strong> ở trên để tổng hợp công và tính lương cho kỳ này.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in pagedPayrollRecords)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <strong class="text-dark">@item.FullName</strong>
                                        <div class="small text-muted font-monospace">@item.EmployeeCode</div>
                                    </td>
                                    <td><span class="emp-badge emp-badge-neutral">@item.DepartmentName</span></td>
                                    <td>
                                        <span class="emp-badge @(item.ActualDays >= item.StandardWorkingDays ? "emp-badge-success" : "emp-badge-info") tabular-nums">
                                            @item.ActualDays.ToString("0.#") / @item.StandardWorkingDays.ToString("0.#") công
                                        </span>
                                    </td>
                                    <td class="font-monospace tabular-nums">@FormatVnd(item.GrossSalary)</td>
                                    <td class="font-monospace tabular-nums @(item.BonusAmount > 0 ? "text-success fw-bold" : "text-muted")">
                                        @(item.BonusAmount > 0 ? "+" + FormatVnd(item.BonusAmount) : "0")
                                    </td>
                                    <td class="font-monospace tabular-nums @(item.Deductions > 0 ? "text-danger fw-bold" : "text-muted")">
                                        @(item.Deductions > 0 ? "-" + FormatVnd(item.Deductions) : "0")
                                    </td>
                                    <td class="font-monospace text-danger tabular-nums">-@FormatVnd(item.BhxhDeduct)</td>
                                    <td class="font-monospace text-danger tabular-nums">-@FormatVnd(item.TaxDeduct)</td>
                                    <td class="font-monospace tabular-nums">
                                        <strong class="text-success fs-6">@FormatVnd(item.NetSalary)</strong>
                                    </td>
                                    <td class="pe-4 text-center">
                                        <button class="btn btn-sm btn-outline-primary"
                                                title="Điều chỉnh Ngày công, Thưởng hoặc Khấu trừ"
                                                @onclick="() => OpenAdjustModal(item)">
                                            <i class="bi bi-sliders me-1"></i> Điều chỉnh
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer -->
        @if (payrollRecords.Count > 0)
        {
            <div class="card-footer bg-white border-top border-light py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Hiển thị <strong class="text-dark">@(((currentPage - 1) * pageSize) + 1)</strong>
                    đến <strong class="text-dark">@(Math.Min(currentPage * pageSize, payrollRecords.Count))</strong>
                    trong tổng số <strong class="text-dark">@payrollRecords.Count</strong> nhân sự
                </div>

                <div class="d-flex align-items-center gap-2 flex-nowrap">
                    <span class="small text-muted me-1 emp-page-size-label text-nowrap">Số dòng:</span>
                    <select class="form-select form-select-sm emp-page-size-select" value="@pageSize" @onchange="OnPageSizeChanged">
                        <option value="5">5 / trang</option>
                        <option value="10">10 / trang</option>
                        <option value="20">20 / trang</option>
                        <option value="50">50 / trang</option>
                    </select>

                    <ul class="pagination pagination-sm mb-0 ms-2 pagination-custom">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(1)" title="Trang đầu">«</button>
                        </li>
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(currentPage - 1)" title="Trang trước">‹</button>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            var pageNum = i;
                            if (pageNum == 1 || pageNum == totalPages || (pageNum >= currentPage - 1 && pageNum <= currentPage + 1))
                            {
                                <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                    <button class="page-link" @onclick="() => SetPage(pageNum)">@pageNum</button>
                                </li>
                            }
                            else if (pageNum == currentPage - 2 || pageNum == currentPage + 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(currentPage + 1)" title="Trang kế">›</button>
                        </li>
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(totalPages)" title="Trang cuối">»</button>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Điều Chỉnh Ngày Công, Thưởng & Khấu Trừ -->
@if (editingRecord is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center" style="border-top-left-radius: 16px; border-top-right-radius: 16px;">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h5 class="modal-title fw-bold text-dark mb-0">
                                <i class="bi bi-sliders text-primary me-2"></i>Điều chỉnh Ngày công &amp; Thu nhập
                            </h5>
                            <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1 rounded-pill small">
                                Kỳ Tháng @editingRecord.MonthPeriod/@editingRecord.YearPeriod
                            </span>
                        </div>
                        <div class="small text-muted">@editingRecord.FullName (@editingRecord.EmployeeCode) - @editingRecord.DepartmentName</div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseAdjustModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info border-0 py-2 px-3 small d-flex align-items-center gap-2 mb-3" style="border-radius: 8px;">
                        <i class="bi bi-info-circle-fill text-primary"></i>
                        <span>Dữ liệu điều chỉnh sẽ tự động tính lại Lương Gross, Thuế TNCN (5 bậc mới) và cập nhật đồng bộ sang <strong>Phiếu lương của tôi</strong> của nhân viên này.</span>
                    </div>

                    <div class="p-3 mb-3 bg-light rounded-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary small">Lương cơ bản + Phụ cấp vị trí:</span>
                            <span class="fw-semibold">@FormatVnd(editingRecord.SnapshotBaseSalary + editingRecord.SnapshotPositionAllowance)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary small">Công chuẩn kỳ này:</span>
                            <span class="fw-semibold font-monospace">@editingRecord.StandardWorkingDays.ToString("0.#") ngày</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary small">Trích BHXH bắt buộc (10.5%):</span>
                            <span class="text-danger fw-semibold">-@FormatVnd(editingRecord.BhxhDeduct)</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Số ngày công thực tế (Actual Days):</label>
                        <div class="input-group">
                            <input type="number" class="form-control" @bind="inputActualDays" min="0" max="31" step="0.5" />
                            <span class="input-group-text">ngày</span>
                        </div>
                        <div class="form-text text-muted">
                            Nếu nghỉ không lương, số công sẽ giảm và lương Gross được tính theo tỷ lệ: (Lương vị trí / 22) * Số ngày công.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Tiền thưởng hiệu quả / Dự án (+ VNĐ):</label>
                        <input type="number" class="form-control" @bind="inputBonus" min="0" step="100000" placeholder="0" />
                        <div class="form-text text-muted">Khoản thưởng được cộng vào thu nhập và tính vào thuế TNCN.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Khấu trừ vi phạm / Tạm ứng (- VNĐ):</label>
                        <input type="number" class="form-control" @bind="inputDeductions" min="0" step="50000" placeholder="0" />
                        <div class="form-text text-muted">Khoản phạt hoặc khấu trừ trực tiếp sau thuế.</div>
                    </div>

                    <!-- Live Preview Box -->
                    <div class="p-3 rounded-3" style="background-color: #ecfdf5; border: 1px dashed #10b981;">
                        <div class="small fw-bold text-success text-uppercase mb-2">Ước tính Lương Thực Lĩnh (NET) mới:</div>
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Lương Gross theo ngày công (@inputActualDays.ToString("0.#") ngày):</span>
                            <span class="fw-semibold text-dark">@FormatVnd(PreviewGrossSalary)</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Thuế TNCN (Biểu 5 bậc mới):</span>
                            <span class="fw-semibold text-danger">-@FormatVnd(PreviewTax)</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold pt-2 border-top border-success-subtle">
                            <span class="text-success">Thực nhận chuyển khoản (NET):</span>
                            <span class="text-success fs-5 font-monospace">@FormatVnd(PreviewNetSalary)</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light px-4" @onclick="CloseAdjustModal">Hủy bỏ</button>
                    <button type="button" class="btn emp-btn-primary px-4" disabled="@isSavingAdjust" @onclick="SaveAdjustAsync">
                        @if (isSavingAdjust)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check2-circle me-1"></i> Lưu điều chỉnh</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<PayrollManagementItemDto> payrollRecords = [];
    private bool isLoading = true;
    private bool isCalculating = false;
    private string? successMessage;
    private string? errorMessage;

    private short selectedMonth = (short)DateTime.Today.Month;
    private short selectedYear = (short)DateTime.Today.Year;

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)payrollRecords.Count / pageSize));
    private IEnumerable<PayrollManagementItemDto> pagedPayrollRecords => payrollRecords.Skip((currentPage - 1) * pageSize).Take(pageSize);

    // Modal state
    private PayrollManagementItemDto? editingRecord;
    private decimal inputActualDays = 22m;
    private decimal inputBonus = 0m;
    private decimal inputDeductions = 0m;
    private bool isSavingAdjust = false;

    // Preview properties
    private decimal PreviewGrossSalary
    {
        get
        {
            if (editingRecord is null) return 0m;
            var std = editingRecord.StandardWorkingDays > 0 ? editingRecord.StandardWorkingDays : 22m;
            var prorated = Math.Round((editingRecord.SnapshotBaseSalary + editingRecord.SnapshotPositionAllowance) / std * inputActualDays, 0);
            return prorated + editingRecord.SnapshotOtherAllowance;
        }
    }

    private decimal PreviewTax
    {
        get
        {
            if (editingRecord is null) return 0m;
            var totalIncome = PreviewGrossSalary + inputBonus;
            var taxable = Math.Max(0m, totalIncome - 11_000_000m - editingRecord.BhxhDeduct);
            return CalculateProgressive5Tax(taxable);
        }
    }

    private decimal PreviewNetSalary
    {
        get
        {
            if (editingRecord is null) return 0m;
            var totalIncome = PreviewGrossSalary + inputBonus;
            return Math.Max(0m, totalIncome - inputDeductions - editingRecord.BhxhDeduct - PreviewTax);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPayrollRecordsAsync();
    }

    private async Task ChangeMonth(int delta)
    {
        var newMonth = selectedMonth + delta;
        if (newMonth < 1)
        {
            selectedMonth = 12;
            selectedYear--;
        }
        else if (newMonth > 12)
        {
            selectedMonth = 1;
            selectedYear++;
        }
        else
        {
            selectedMonth = (short)newMonth;
        }

        await LoadPayrollRecordsAsync();
    }

    private async Task OnMonthChangedAsync(ChangeEventArgs e)
    {
        if (short.TryParse(e.Value?.ToString(), out var m) && m is >= 1 and <= 12)
        {
            selectedMonth = m;
            await LoadPayrollRecordsAsync();
        }
    }

    private async Task OnYearChangedAsync(ChangeEventArgs e)
    {
        if (short.TryParse(e.Value?.ToString(), out var y) && y >= 2020)
        {
            selectedYear = y;
            await LoadPayrollRecordsAsync();
        }
    }

    private async Task SetCurrentPeriodAsync()
    {
        selectedMonth = (short)DateTime.Today.Month;
        selectedYear = (short)DateTime.Today.Year;
        await LoadPayrollRecordsAsync();
    }

    private async Task LoadPayrollRecordsAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            payrollRecords = await PayrollManagementApiClient.GetAllPayslipsAsync(selectedMonth, selectedYear);
            if (currentPage > totalPages)
            {
                currentPage = 1;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi tải danh sách bảng lương: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RunPayrollCalculationAsync()
    {
        isCalculating = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var count = await PayrollManagementApiClient.CalculatePayrollAsync(selectedMonth, selectedYear);
            successMessage = $"✓ Tính toán thành công! Đã chốt và cập nhật bảng lương cho {count} nhân sự trong Tháng {selectedMonth}/{selectedYear}. Ngày công thực tế, Thưởng và Khấu trừ điều chỉnh đã được áp dụng chuẩn xác.";
            await LoadPayrollRecordsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Không thể chạy tính lương: " + ex.Message;
        }
        finally
        {
            isCalculating = false;
        }
    }

    private void OpenAdjustModal(PayrollManagementItemDto item)
    {
        editingRecord = item;
        inputActualDays = item.ActualDays;
        inputBonus = item.BonusAmount;
        inputDeductions = item.Deductions;
    }

    private void CloseAdjustModal()
    {
        editingRecord = null;
    }

    private async Task SaveAdjustAsync()
    {
        if (editingRecord is null) return;
        isSavingAdjust = true;
        errorMessage = null;
        try
        {
            var updated = await PayrollManagementApiClient.AdjustPayrollRecordAsync(editingRecord.Id, inputActualDays, inputBonus, inputDeductions);
            if (updated is not null)
            {
                successMessage = $"✓ Đã cập nhật thành công cho {updated.FullName}: {updated.ActualDays:0.#} công. Lương Net thực nhận mới: {FormatVnd(updated.NetSalary)}.";
                CloseAdjustModal();
                await LoadPayrollRecordsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi lưu điều chỉnh: " + ex.Message;
        }
        finally
        {
            isSavingAdjust = false;
        }
    }

    private void SetPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            pageSize = size;
            currentPage = 1;
        }
    }

    private static decimal CalculateProgressive5Tax(decimal taxableIncome)
    {
        if (taxableIncome <= 0m) return 0m;
        if (taxableIncome <= 10_000_000m) return Math.Round(taxableIncome * 0.05m, 0);
        if (taxableIncome <= 30_000_000m) return Math.Round(taxableIncome * 0.10m - 500_000m, 0);
        if (taxableIncome <= 60_000_000m) return Math.Round(taxableIncome * 0.20m - 3_500_000m, 0);
        if (taxableIncome <= 100_000_000m) return Math.Round(taxableIncome * 0.30m - 9_500_000m, 0);
        return Math.Round(taxableIncome * 0.35m - 14_500_000m, 0);
    }

    private static string FormatVnd(decimal amount) =>
        amount == 0 ? "0 VNĐ" : $"{amount:#,##0} VNĐ";
}
