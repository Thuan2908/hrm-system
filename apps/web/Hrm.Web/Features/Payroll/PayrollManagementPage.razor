@page "/employee/payroll-management"
@page "/payroll/management"
@layout EmployeeLayout
@attribute [Authorize]
@inject IPayrollManagementApiClient PayrollManagementApiClient

<PageTitle>Quản lý &amp; Chốt bảng lương - Saigon Retail</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Hero Banner -->
    <div class="emp-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="emp-page-header-subtitle d-flex align-items-center gap-2">
                <i class="bi bi-cash-coin text-primary"></i>
                <span>QUẢN LÝ TIỀN LƯƠNG &amp; ĐÃI NGỘ</span>
            </div>
            <h1 class="emp-page-header-title">Quản lý &amp; Chốt bảng lương toàn doanh nghiệp</h1>
            <p class="emp-page-header-desc">Tính toán tự động ngày công thực tế, đóng BHXH bắt buộc 10.5%, thuế TNCN và chốt lương thực lĩnh.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a class="btn emp-btn-secondary" href="employee/payslips">
                <i class="bi bi-wallet2 me-1"></i> Phiếu lương của tôi
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46;">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@successMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px;">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Toolbar: Month/Year selector & Run payroll button -->
    <div class="card emp-card mb-4">
        <div class="card-body p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 fw-semibold text-secondary small">Kỳ tính lương:</label>
                    <select class="form-select form-select-sm fw-medium" @bind="selectedMonth" style="width: auto; border-radius: 8px;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">Tháng @m</option>
                        }
                    </select>
                    <select class="form-select form-select-sm fw-medium" @bind="selectedYear" style="width: auto; border-radius: 8px;">
                        <option value="2026">2026</option>
                        <option value="2025">2025</option>
                    </select>
                </div>

                <button class="btn btn-sm emp-btn-secondary" @onclick="LoadPayrollRecordsAsync" disabled="@isLoading">
                    <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                </button>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn emp-btn-primary"
                        disabled="@isCalculating"
                        @onclick="RunPayrollCalculationAsync">
                    @if (isCalculating)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Đang tính toán lương...</span>
                    }
                    else
                    {
                        <span><i class="bi bi-play-circle-fill me-1"></i> Chạy tính lương Tháng @selectedMonth/@selectedYear</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- KPI Summary Row for Selected Period -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card emp-kpi-card p-3 h-100">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="emp-kpi-label">Số nhân sự chốt lương</span>
                    <span class="emp-badge emp-badge-neutral">Kỳ @selectedMonth/@selectedYear</span>
                </div>
                <div class="emp-kpi-value mt-1 tabular-nums">@payrollRecords.Count</div>
                <div class="small text-muted mt-1">Nhân viên có dữ liệu kỳ này</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card emp-kpi-card p-3 h-100">
                <div class="emp-kpi-label">Tổng quỹ lương GROSS</div>
                <div class="emp-kpi-value mt-1 tabular-nums">@FormatVnd(payrollRecords.Sum(r => r.GrossSalary))</div>
                <div class="small text-muted mt-1">Bao gồm lương cơ bản &amp; phụ cấp</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card emp-kpi-card p-3 h-100">
                <div class="emp-kpi-label">Tổng trích nộp (BHXH + Thuế)</div>
                <div class="fs-3 fw-bold text-danger font-monospace mt-1 tabular-nums">-@FormatVnd(payrollRecords.Sum(r => r.BhxhDeduct + r.TaxDeduct))</div>
                <div class="small text-muted mt-1">BHXH 10.5% + Thuế thu nhập cá nhân</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card emp-kpi-card p-3 h-100" style="border-left: 4px solid var(--emp-primary) !important;">
                <div class="emp-kpi-label text-success fw-bold">Tổng chi trả thực lĩnh (NET)</div>
                <div class="fs-3 fw-bold text-success font-monospace mt-1 tabular-nums">@FormatVnd(payrollRecords.Sum(r => r.NetSalary))</div>
                <div class="small text-muted mt-1">Tổng thực nhận chuyển khoản cho nhân viên</div>
            </div>
        </div>
    </div>

    <!-- Payroll Records Table with Pagination -->
    <div class="card emp-card">
        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-table text-primary fs-5"></i>
                <div>
                    <strong class="text-dark fs-6 text-uppercase fw-bold" style="letter-spacing: 0.5px;">Bảng Lương Chi Tiết Toàn Doanh Nghiệp</strong>
                    <div class="text-muted small">Kỳ lương Tháng @selectedMonth năm @selectedYear · @payrollRecords.Count nhân sự</div>
                </div>
            </div>
            <span class="emp-badge emp-badge-success">
                <i class="bi bi-check-circle me-1"></i> Dữ liệu chuẩn
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table emp-table align-middle mb-0">
                    <thead class="table-light text-secondary small">
                        <tr>
                            <th class="ps-4">NHÂN VIÊN</th>
                            <th>PHÒNG BAN</th>
                            <th>KÝ LƯƠNG</th>
                            <th>CÔNG THỰC TẾ</th>
                            <th>LƯƠNG GROSS</th>
                            <th>BHXH (10.5%)</th>
                            <th>THUẾ TNCN</th>
                            <th class="pe-4 text-end">NET THỰC LĨNH</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (payrollRecords.Count == 0 && !isLoading)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder2-open fs-1 text-muted d-block mb-2"></i>
                                    <div>Chưa có dữ liệu bảng lương cho Tháng @selectedMonth/@selectedYear.</div>
                                    <div class="small text-muted mt-1">Bấm nút <strong>"Chạy tính lương"</strong> ở trên để tổng hợp công và tính lương cho kỳ này.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in pagedPayrollRecords)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <strong class="text-dark">@item.FullName</strong>
                                        <div class="small text-muted font-monospace">@item.EmployeeCode</div>
                                    </td>
                                    <td><span class="emp-badge emp-badge-neutral">@item.DepartmentName</span></td>
                                    <td><span class="emp-badge emp-badge-neutral tabular-nums">@item.MonthPeriod/@item.YearPeriod</span></td>
                                    <td><span class="emp-badge emp-badge-info tabular-nums">@item.ActualDays.ToString("0.#") ngày</span></td>
                                    <td class="font-monospace tabular-nums">@FormatVnd(item.GrossSalary)</td>
                                    <td class="font-monospace text-danger tabular-nums">-@FormatVnd(item.BhxhDeduct)</td>
                                    <td class="font-monospace text-danger tabular-nums">-@FormatVnd(item.TaxDeduct)</td>
                                    <td class="pe-4 text-end font-monospace tabular-nums">
                                        <strong class="text-success fs-6">@FormatVnd(item.NetSalary)</strong>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer -->
        @if (payrollRecords.Count > 0)
        {
            <div class="card-footer bg-white border-top border-light py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Hiển thị <strong class="text-dark">@(((currentPage - 1) * pageSize) + 1)</strong>
                    đến <strong class="text-dark">@(Math.Min(currentPage * pageSize, payrollRecords.Count))</strong>
                    trong tổng số <strong class="text-dark">@payrollRecords.Count</strong> nhân sự
                </div>

                <div class="d-flex align-items-center gap-2 flex-nowrap">
                    <span class="small text-muted me-1 emp-page-size-label text-nowrap">Số dòng:</span>
                    <select class="form-select form-select-sm emp-page-size-select" value="@pageSize" @onchange="OnPageSizeChanged">
                        <option value="5">5 / trang</option>
                        <option value="10">10 / trang</option>
                        <option value="20">20 / trang</option>
                        <option value="50">50 / trang</option>
                    </select>

                    <ul class="pagination pagination-sm mb-0 ms-2 pagination-custom">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(1)" title="Trang đầu">«</button>
                        </li>
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(currentPage - 1)" title="Trang trước">‹</button>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            var pageNum = i;
                            if (pageNum == 1 || pageNum == totalPages || (pageNum >= currentPage - 1 && pageNum <= currentPage + 1))
                            {
                                <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                    <button class="page-link" @onclick="() => SetPage(pageNum)">@pageNum</button>
                                </li>
                            }
                            else if (pageNum == currentPage - 2 || pageNum == currentPage + 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(currentPage + 1)" title="Trang kế">›</button>
                        </li>
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(totalPages)" title="Trang cuối">»</button>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<PayrollManagementItemDto> payrollRecords = [];
    private bool isLoading = true;
    private bool isCalculating = false;
    private string? successMessage;
    private string? errorMessage;

    private short selectedMonth = (short)DateTime.Today.Month;
    private short selectedYear = (short)DateTime.Today.Year;

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)payrollRecords.Count / pageSize));
    private IEnumerable<PayrollManagementItemDto> pagedPayrollRecords => payrollRecords.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadPayrollRecordsAsync();
    }

    private async Task LoadPayrollRecordsAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            payrollRecords = await PayrollManagementApiClient.GetAllPayslipsAsync(selectedMonth, selectedYear);
            if (currentPage > totalPages)
            {
                currentPage = 1;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi tải danh sách bảng lương: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RunPayrollCalculationAsync()
    {
        isCalculating = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var count = await PayrollManagementApiClient.CalculatePayrollAsync(selectedMonth, selectedYear);
            successMessage = $"✓ Tính toán thành công! Đã chốt và cập nhật bảng lương cho {count} nhân sự trong Tháng {selectedMonth}/{selectedYear}.";
            await LoadPayrollRecordsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Không thể chạy tính lương: " + ex.Message;
        }
        finally
        {
            isCalculating = false;
        }
    }

    private void SetPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            pageSize = size;
            currentPage = 1;
        }
    }

    private static string FormatVnd(decimal amount) =>
        amount == 0 ? "0 VNĐ" : $"{amount:#,##0} VNĐ";
}
