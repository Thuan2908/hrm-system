@page "/employee/attendance-management"
@page "/attendance-management"
@layout EmployeeLayout
@attribute [Authorize]
@inject IAttendanceApiClient AttendanceApiClient
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Theo dõi chấm công bộ phận - Saigon Retail</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Banner -->
    <div class="emp-page-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="emp-badge-tag">● GIÁM SÁT &amp; THEO DÕI CHẤM CÔNG BỘ PHẬN</span>
                </div>
                <h1 class="emp-page-title mb-1">Theo dõi điểm danh nhân sự</h1>
                <p class="emp-page-desc mb-0">Theo dõi thời gian vào ca, ra ca và tình hình làm việc thực tế của nhân viên toàn đơn vị hôm nay.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-success rounded-pill px-3 py-2 fw-medium d-flex align-items-center gap-2 shadow-sm"
                        @onclick="LoadTeamDataAsync" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Đang tải...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-clockwise fs-6"></i>
                        <span>Làm mới dữ liệu</span>
                    }
                </button>
                <div class="text-md-end p-2 px-3 rounded-3" style="background: var(--emp-surface-subtle); border: 1px solid var(--emp-border);">
                    <div class="text-uppercase small fw-bold" style="color: var(--emp-primary); font-size: 0.75rem;">@currentDateStr</div>
                    <div class="fw-bold font-monospace tabular-nums" style="color: var(--emp-heading); font-size: 1.1rem;">@currentTimeStr</div>
                </div>
            </div>
        </div>
    </div>

    @if (!hasPermission)
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4" style="border-radius: 16px;">
            <div class="text-danger mb-3" style="font-size: 3rem;"><i class="bi bi-shield-x"></i></div>
            <h4 class="fw-bold text-dark">Bạn không có quyền truy cập trang này</h4>
            <p class="text-muted">Chức năng này yêu cầu quyền <strong>Xem &amp; Theo dõi chấm công bộ phận</strong> (<code>attendance.team.read</code>).</p>
            <div class="mt-3">
                <a href="employee/attendance" class="btn btn-primary rounded-pill px-4">Về trang Chấm công cá nhân</a>
            </div>
        </div>
    }
    else
    {
        <!-- Summary Metric Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px; background: var(--emp-surface);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center"
                             style="width: 48px; height: 48px; background: rgba(59, 130, 246, 0.1); color: #2563EB;">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-medium">Tổng nhân sự</div>
                            <div class="fs-4 fw-bold text-dark font-monospace">@teamRecords.Count</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px; background: var(--emp-surface);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center"
                             style="width: 48px; height: 48px; background: rgba(234, 179, 8, 0.15); color: #CA8A04;">
                            <i class="bi bi-person-workspace fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-medium">Đang làm việc</div>
                            <div class="fs-4 fw-bold text-warning font-monospace">@workingCount</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px; background: var(--emp-surface);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center"
                             style="width: 48px; height: 48px; background: rgba(34, 197, 94, 0.1); color: #16A34A;">
                            <i class="bi bi-check-circle-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-medium">Đã hoàn thành</div>
                            <div class="fs-4 fw-bold text-success font-monospace">@completedCount</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 14px; background: var(--emp-surface);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center"
                             style="width: 48px; height: 48px; background: rgba(148, 163, 184, 0.15); color: #64748B;">
                            <i class="bi bi-dash-circle fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-medium">Chưa vào ca</div>
                            <div class="fs-4 fw-bold text-secondary font-monospace">@notCheckedInCount</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter & Search Card -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0"
                                   placeholder="Tìm kiếm họ tên, mã nhân viên..."
                                   @bind="searchKeyword" @bind:event="oninput" @bind:after="OnFilterChanged" />
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <select class="form-select" @bind="selectedDepartment" @bind:after="OnFilterChanged">
                            <option value="">Tất cả phòng ban</option>
                            @foreach (var dept in departments)
                            {
                                <option value="@dept">@dept</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <select class="form-select" @bind="selectedStatus" @bind:after="OnFilterChanged">
                            <option value="">Tất cả trạng thái</option>
                            <option value="WORKING">Đang làm việc</option>
                            <option value="COMPLETED">Đã hoàn thành ca</option>
                            <option value="NOT_CHECKED_IN">Chưa vào ca</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2 text-md-end">
                        <div class="text-muted small">
                            Khớp: <strong class="text-dark">@filteredRecords.Count</strong> / @teamRecords.Count
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Attendance List Table Card -->
        <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-table text-primary"></i>
                    <strong class="text-dark">DANH SÁCH ĐIỂM DANH HÔM NAY</strong>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted">Hiển thị mỗi trang:</span>
                    <select class="form-select form-select-sm" style="width: auto;" value="@pageSize" @onchange="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>

            <div class="card-body p-0">
                @if (isLoading)
                {
                    <div class="py-5 text-center text-muted">
                        <div class="spinner-border text-success mb-3" role="status"></div>
                        <p class="mb-0">Đang tải danh sách điểm danh bộ phận...</p>
                    </div>
                }
                else if (filteredRecords.Count == 0)
                {
                    <div class="py-5 text-center text-muted">
                        <i class="bi bi-inbox fs-1 text-secondary mb-2 d-block"></i>
                        <p class="mb-0">Không tìm thấy dữ liệu điểm danh phù hợp với bộ lọc.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small">
                                <tr>
                                    <th class="ps-4">NHÂN VIÊN</th>
                                    <th>PHÒNG BAN</th>
                                    <th>GIỜ VÀO CA</th>
                                    <th>GIỜ RA CA</th>
                                    <th>THỜI GIAN LÀM VIỆC</th>
                                    <th class="pe-4">TRẠNG THÁI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var emp in pagedRecords)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                                     style="width: 36px; height: 36px; background: var(--emp-primary); font-size: 0.85rem;">
                                                    @GetInitial(emp.FullName)
                                                </div>
                                                <div>
                                                    <strong class="text-dark">@emp.FullName</strong>
                                                    <div class="small text-muted font-monospace">@emp.EmployeeCode</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2.5 py-1">@emp.DepartmentName</span>
                                        </td>
                                        <td>
                                            <span class="font-monospace @(emp.CheckInTime.HasValue ? "text-success fw-bold" : "text-muted")">
                                                @(emp.CheckInTime.HasValue ? emp.CheckInTime.Value.ToLocalTime().ToString("HH:mm:ss") : "--:--:--")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="font-monospace @(emp.CheckOutTime.HasValue ? "text-primary fw-bold" : "text-muted")">
                                                @(emp.CheckOutTime.HasValue ? emp.CheckOutTime.Value.ToLocalTime().ToString("HH:mm:ss") : "--:--:--")
                                            </span>
                                        </td>
                                        <td>
                                            @if (emp.ActualHours.HasValue)
                                            {
                                                <strong class="text-dark font-monospace">@($"{emp.ActualHours.Value:F2}h")</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted">--</span>
                                            }
                                        </td>
                                        <td class="pe-4">
                                            @if (emp.CheckOutTime.HasValue)
                                            {
                                                <span class="badge bg-success text-white rounded-pill px-3 py-1.5 fw-medium">
                                                    ✓ Đã hoàn thành
                                                </span>
                                            }
                                            else if (emp.CheckInTime.HasValue)
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1.5 fw-medium">
                                                    <span class="spinner-grow spinner-grow-sm me-1" style="width: 6px; height: 6px;" role="status"></span>
                                                    Đang làm việc
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1.5 fw-medium">
                                                    Chưa vào ca
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Footer -->
                    <div class="card-footer bg-white border-top border-light py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                        <div class="small text-muted">
                            Hiển thị <strong class="text-dark">@(((currentPage - 1) * pageSize) + 1)</strong>
                            đến <strong class="text-dark">@(Math.Min(currentPage * pageSize, filteredRecords.Count))</strong>
                            trong tổng số <strong class="text-dark">@filteredRecords.Count</strong> kết quả
                        </div>
                        @if (totalPages > 1)
                        {
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => SetPage(1)">«</button>
                                </li>
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => SetPage(currentPage - 1)">‹</button>
                                </li>
                                @for (int p = 1; p <= totalPages; p++)
                                {
                                    var pageNum = p;
                                    if (pageNum == 1 || pageNum == totalPages || (pageNum >= currentPage - 1 && pageNum <= currentPage + 1))
                                    {
                                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                            <button class="page-link" @onclick="() => SetPage(pageNum)">@pageNum</button>
                                        </li>
                                    }
                                    else if (pageNum == currentPage - 2 || pageNum == currentPage + 2)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                }
                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => SetPage(currentPage + 1)">›</button>
                                </li>
                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => SetPage(totalPages)">»</button>
                                </li>
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<TeamAttendanceItemDto> teamRecords = [];
    private List<TeamAttendanceItemDto> filteredRecords = [];
    private bool isLoading = true;
    private bool hasPermission = false;

    private string searchKeyword = string.Empty;
    private string selectedDepartment = string.Empty;
    private string selectedStatus = string.Empty;

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)filteredRecords.Count / pageSize));
    private IEnumerable<TeamAttendanceItemDto> pagedRecords => filteredRecords.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private IEnumerable<string> departments => teamRecords.Select(r => r.DepartmentName).Distinct().OrderBy(d => d);

    private int workingCount => teamRecords.Count(r => r.CheckInTime.HasValue && !r.CheckOutTime.HasValue);
    private int completedCount => teamRecords.Count(r => r.CheckOutTime.HasValue);
    private int notCheckedInCount => teamRecords.Count(r => !r.CheckInTime.HasValue);

    private System.Threading.Timer? clockTimer;
    private string currentDateStr = DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"));
    private string currentTimeStr = DateTime.Now.ToString("HH:mm:ss");

    protected override async Task OnInitializedAsync()
    {
        clockTimer = new System.Threading.Timer(_ =>
        {
            var now = DateTime.Now;
            currentDateStr = now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"));
            currentTimeStr = now.ToString("HH:mm:ss");
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        hasPermission = user.IsInRole("ADMIN") ||
                        user.HasClaim("permission", PermissionCodes.AttendanceTeamRead) ||
                        user.HasClaim("permission", "ATT_APPROVE");

        if (hasPermission)
        {
            await LoadTeamDataAsync();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadTeamDataAsync()
    {
        isLoading = true;
        try
        {
            teamRecords = await AttendanceApiClient.GetTeamSummaryAsync();
            ApplyFilters();
        }
        catch
        {
            teamRecords = [];
            filteredRecords = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnFilterChanged()
    {
        currentPage = 1;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = teamRecords.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            var kw = searchKeyword.Trim();
            query = query.Where(r => (r.FullName != null && r.FullName.Contains(kw, StringComparison.OrdinalIgnoreCase))
                                  || (r.EmployeeCode != null && r.EmployeeCode.Contains(kw, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrWhiteSpace(selectedDepartment))
        {
            query = query.Where(r => string.Equals(r.DepartmentName, selectedDepartment, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(selectedStatus))
        {
            query = selectedStatus switch
            {
                "WORKING" => query.Where(r => r.CheckInTime.HasValue && !r.CheckOutTime.HasValue),
                "COMPLETED" => query.Where(r => r.CheckOutTime.HasValue),
                "NOT_CHECKED_IN" => query.Where(r => !r.CheckInTime.HasValue),
                _ => query
            };
        }

        filteredRecords = query.ToList();
    }

    private void SetPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            pageSize = size;
            currentPage = 1;
        }
    }

    private static string GetInitial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "U" : name.Trim()[0].ToString().ToUpperInvariant();

    public void Dispose()
    {
        clockTimer?.Dispose();
    }
}
