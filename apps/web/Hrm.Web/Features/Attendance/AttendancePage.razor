@page "/employee/attendance"
@page "/attendance"
@page "/dashboard"
@layout EmployeeLayout
@attribute [Authorize]
@inject IAttendanceApiClient AttendanceApiClient
@implements IDisposable

<PageTitle>Điểm danh &amp; Chấm công - Saigon Retail</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Hero Banner -->
    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #052e22 0%, #065f46 50%, #047857 100%); color: white; border-radius: 18px; box-shadow: 0 12px 30px rgba(5, 46, 34, 0.25) !important;">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge text-white mb-2 px-3 py-1" style="background-color: #10b981; font-size: 0.85rem; border-radius: 20px; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);">
                    ● HỆ THỐNG ĐIỂM DANH THỜI GIAN THỰC
                </span>
                <h1 class="h3 fw-bold mb-1 text-white">Chấm công hàng ngày</h1>
                <p class="mb-0 text-white-50">Ghi nhận giờ vào và giờ ra ca làm việc chính xác, minh bạch và tức thì.</p>
            </div>
            <div class="text-md-end p-3 px-4 rounded-4" style="background: rgba(0, 0, 0, 0.28); border: 1px solid rgba(52, 211, 153, 0.25);">
                <div class="text-uppercase small" style="color: #6ee7b7; letter-spacing: 1px;">@currentDateStr</div>
                <div class="display-6 fw-bold text-white font-monospace">@currentTimeStr</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 14px; background-color: #ecfdf5; color: #065f46;">
            <span style="font-size: 1.25rem;">✓</span>
            <div>@successMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 14px;">
            <span style="font-size: 1.25rem;">⚠</span>
            <div>@errorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Main Attendance Action Card & Details Row -->
    <div class="row g-4 mb-4">
        <!-- Col 1: Action Check-in / Check-out Hub -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 18px;">
                <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-5">📋</span>
                        <span class="fw-bold text-dark" style="letter-spacing: 0.3px;">ĐIỂM DANH &amp; VÀO CA</span>
                    </div>
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm text-success" role="status"></span>
                    }
                    else if (todayStatus is not null)
                    {
                        @if (!todayStatus.HasCheckedIn)
                        {
                            <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;">
                                <span class="me-1">⚪</span> Chưa vào ca
                            </span>
                        }
                        else if (todayStatus.HasCheckedIn && !todayStatus.HasCheckedOut)
                        {
                            <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background-color: #ecfdf5; color: #059669; border: 1px solid #a7f3d0;">
                                <span class="spinner-grow spinner-grow-sm me-1 text-success" style="width: 8px; height: 8px;" role="status"></span> Đang trong ca làm việc
                            </span>
                        }
                        else
                        {
                            <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background-color: #f0fdf4; color: #16a34a; border: 1px solid #86efac;">
                                ✓ Đã hoàn thành ca
                            </span>
                        }
                    }
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    @if (isLoading && todayStatus is null)
                    {
                        <div class="py-5 text-center text-muted">
                            <div class="spinner-border text-success mb-3" role="status"></div>
                            <p>Đang tải trạng thái chấm công...</p>
                        </div>
                    }
                    else if (todayStatus is not null)
                    {
                        <!-- Action Area -->
                        <div class="my-auto py-2">
                            @if (!todayStatus.HasCheckedIn)
                            {
                                <!-- CHƯA CHECK-IN: HIỆN NÚT CHECK-IN -->
                                <div class="d-flex flex-column align-items-center">
                                    <div class="mb-3 text-center">
                                        <span class="badge bg-light text-secondary border px-3 py-1.5 rounded-pill small">
                                            Ca tiêu chuẩn: 08:00 - 17:30 (8.0 giờ)
                                        </span>
                                    </div>
                                    <button class="btn btn-attendance-action btn-checkin shadow-lg"
                                            disabled="@isSubmitting"
                                            @onclick="DoCheckInAsync">
                                        @if (isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Đang ghi nhận giờ vào ca...</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center gap-3">
                                                <div class="btn-action-icon bg-white text-emerald">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                                        <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m.5-5v1h1a.5.5 0 0 1 0 1h-1v1a.5.5 0 0 1-1 0v-1h-1a.5.5 0 0 1 0-1h1v-1a.5.5 0 0 1 1 0m-2-6a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
                                                        <path d="M8.256 14a4.5 4.5 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.711 10 8 10q.39 0 .74.025c.226-.341.496-.65.804-.918Q8.844 9.002 8 9c-5 0-6 3-6 4s1 1 1 1z"/>
                                                    </svg>
                                                </div>
                                                <div class="text-start">
                                                    <div class="btn-action-title">ĐIỂM DANH VÀO CA</div>
                                                    <div class="btn-action-subtitle">Ghi nhận giờ bắt đầu làm việc hôm nay</div>
                                                </div>
                                            </div>
                                        }
                                    </button>
                                </div>
                            }
                            else if (todayStatus.HasCheckedIn && !todayStatus.HasCheckedOut)
                            {
                                <!-- ĐÃ CHECK-IN: HIỆN NÚT CHECK-OUT -->
                                <div class="d-flex flex-column align-items-center">
                                    <div class="alert alert-success border-0 py-2 px-3 rounded-pill small mb-3 text-center" style="background-color: #ecfdf5; color: #047857;">
                                        ● Bạn đã vào ca lúc <strong>@FormatTime(todayStatus.CheckInTime)</strong>. Chúc bạn làm việc hiệu quả!
                                    </div>
                                    <button class="btn btn-attendance-action btn-checkout shadow-lg"
                                            disabled="@isSubmitting"
                                            @onclick="DoCheckOutAsync">
                                        @if (isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Đang ghi nhận giờ tan ca...</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center gap-3">
                                                <div class="btn-action-icon bg-white text-rose">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                                        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z"/>
                                                        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                                                    </svg>
                                                </div>
                                                <div class="text-start">
                                                    <div class="btn-action-title">ĐIỂM DANH TAN CA</div>
                                                    <div class="btn-action-subtitle">Kết thúc ca làm &amp; chốt giờ công</div>
                                                </div>
                                            </div>
                                        }
                                    </button>
                                </div>
                            }
                            else
                            {
                                <!-- ĐÃ CHECK-OUT: HIỆN THÔNG BÁO HOÀN THÀNH SANG TRỌNG -->
                                <div class="p-4 rounded-4 text-center my-2 border border-success border-opacity-25" style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);">
                                    <div class="fs-1 mb-2">🎉</div>
                                    <h5 class="fw-bold text-success mb-1">Ca làm việc hôm nay đã hoàn tất!</h5>
                                    <p class="text-muted small mb-3">
                                        Bạn đã ghi nhận đủ cả giờ vào và giờ ra. Dữ liệu công đã sẵn sàng để tính lương.
                                    </p>
                                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-white border border-success border-opacity-25 text-success small fw-semibold">
                                        <span>✓ Tổng giờ tính công: @(todayStatus.ActualHours.HasValue ? $"{todayStatus.ActualHours.Value:F2}h" : "--")</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Notes input -->
                        @if (!todayStatus.HasCheckedIn || (!todayStatus.HasCheckedOut && todayStatus.HasCheckedIn))
                        {
                            <div class="mt-3 w-100" style="max-width: 440px; margin: 0 auto;">
                                <div class="input-group shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0;">
                                    <span class="input-group-text bg-white border-0 text-muted ps-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                        </svg>
                                    </span>
                                    <input type="text" class="form-control border-0 py-2" placeholder="Ghi chú ca làm (tùy chọn: làm từ xa, lý do ra muộn/sớm...)" @bind="inputNotes" style="font-size: 0.875rem;" />
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Col 2: Today Metrics & Details -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 18px;">
                <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-5">📊</span>
                        <span class="fw-bold text-dark" style="letter-spacing: 0.3px;">CHI TIẾT CA HÔM NAY</span>
                    </div>
                    <span class="badge bg-light text-secondary border px-3 py-1.5 rounded-pill small">
                        📅 @DateTime.Today.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between gap-3">
                    <!-- Metric 1: Check-in Time -->
                    <div class="attendance-metric-card metric-checkin p-3 rounded-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="metric-icon-box bg-emerald-light text-emerald">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
                                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
                                </svg>
                            </div>
                            <div>
                                <span class="metric-label d-block">GIỜ VÀO (CHECK-IN)</span>
                                <span class="metric-value font-monospace @(todayStatus?.CheckInTime is not null ? "text-dark" : "text-muted opacity-50")">
                                    @(todayStatus?.CheckInTime is not null ? FormatTime(todayStatus.CheckInTime) : "--:--:--")
                                </span>
                            </div>
                        </div>
                        @if (todayStatus?.CheckInTime is not null)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold small">
                                ✓ Đã vào ca
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1.5 small">
                                Chưa vào ca
                            </span>
                        }
                    </div>

                    <!-- Metric 2: Check-out Time -->
                    <div class="attendance-metric-card metric-checkout p-3 rounded-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="metric-icon-box bg-rose-light text-rose">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
                                    <path d="M5 8a.5.5 0 0 1 .5-.5h4.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H5.5A.5.5 0 0 1 5 8"/>
                                </svg>
                            </div>
                            <div>
                                <span class="metric-label d-block">GIỜ RA (CHECK-OUT)</span>
                                <span class="metric-value font-monospace @(todayStatus?.CheckOutTime is not null ? "text-dark" : "text-muted opacity-50")">
                                    @(todayStatus?.CheckOutTime is not null ? FormatTime(todayStatus.CheckOutTime) : "--:--:--")
                                </span>
                            </div>
                        </div>
                        @if (todayStatus?.CheckOutTime is not null)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1.5 fw-semibold small">
                                ✓ Đã tan ca
                            </span>
                        }
                        else if (todayStatus?.CheckInTime is not null)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1.5 fw-semibold small">
                                ● Đang làm việc
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1.5 small">
                                Chưa có dữ liệu
                            </span>
                        }
                    </div>

                    <!-- Metric 3: Actual Hours -->
                    <div class="attendance-metric-card metric-total p-3 rounded-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="metric-icon-box bg-sky-light text-sky">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1.5a1.5 1.5 0 0 1-.5 1.125L9.5 8l4 3.375a1.5 1.5 0 0 1 .5 1.125V15a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-2.5a1.5 1.5 0 0 1 .5-1.125L6.5 8l-4-3.375A1.5 1.5 0 0 1 2 3.5zm2 1.5v1a.5.5 0 0 0 .168.375L8 7.086l3.832-3.211A.5.5 0 0 0 12 3.5v-1z"/>
                                </svg>
                            </div>
                            <div>
                                <span class="metric-label d-block">TỔNG THỜI GIAN LÀM</span>
                                <span class="metric-value font-monospace text-primary fw-bold">
                                    @(todayStatus?.ActualHours is not null ? $"{todayStatus.ActualHours.Value:F2} giờ" : "--")
                                </span>
                            </div>
                        </div>
                        @if (todayStatus?.ActualHours is not null)
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1.5 fw-semibold small">
                                Chuẩn công
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-light text-muted border rounded-pill px-3 py-1.5 small">
                                Chờ tính toán
                            </span>
                        }
                    </div>

                    <!-- Helpful Worktip Banner -->
                    <div class="p-3 rounded-4 bg-light border d-flex align-items-center gap-2 small text-secondary">
                        <span class="fs-5">💡</span>
                        <div>
                            @if (todayStatus?.HasCheckedIn == true && !todayStatus.HasCheckedOut)
                            {
                                <span>Ca làm đang diễn ra. Bạn nhớ bấm <strong>Điểm danh tan ca</strong> khi hết giờ làm việc nhé!</span>
                            }
                            else if (todayStatus?.HasCheckedOut == true)
                            {
                                <span>Tuyệt vời! Dữ liệu chấm công hôm nay đã được hệ thống ghi nhận và lưu trữ an toàn.</span>
                            }
                            else
                            {
                                <span>Ca làm việc tiêu chuẩn kéo dài <strong>8.0 giờ</strong>. Điểm danh đúng giờ để đảm bảo quyền lợi chuyên cần!</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance History Table with Pagination -->
    <div class="card border-0 shadow-sm" style="border-radius: 18px;">
        <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">🗓️</span>
                <strong class="text-dark fs-6" style="letter-spacing: 0.3px;">LỊCH SỬ CHẤM CÔNG CỦA BẠN</strong>
                <span class="badge bg-success-subtle text-success border border-success-subtle ms-2">@historyRecords.Count ngày đã ghi nhận</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="d-flex align-items-center gap-1 small text-muted">
                    <span>Xem:</span>
                    <select class="form-select form-select-sm" style="width: auto; border-radius: 8px;" value="@selectedHistoryDays" @onchange="OnHistoryDaysChanged">
                        <option value="14">14 ngày gần nhất</option>
                        <option value="30">30 ngày gần nhất</option>
                        <option value="60">60 ngày gần nhất</option>
                    </select>
                </div>
                <button class="btn btn-sm btn-outline-success rounded-pill px-3" @onclick="LoadDataAsync" disabled="@isLoading">
                    ↻ Làm mới
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small">
                        <tr>
                            <th class="ps-4">NGÀY LÀM VIỆC</th>
                            <th>GIỜ VÀO</th>
                            <th>GIỜ RA</th>
                            <th>SỐ GIỜ THỰC TẾ</th>
                            <th>TRẠNG THÁI</th>
                            <th class="pe-4">GHI CHÚ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (historyRecords.Count == 0 && !isLoading)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="fs-3 mb-2">📁</div>
                                    <div>Chưa có dữ liệu lịch sử chấm công trong @selectedHistoryDays ngày qua.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var rec in pagedHistoryRecords)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-muted">📅</span>
                                            <span>@rec.WorkDate.ToString("dd/MM/yyyy")</span>
                                            <span class="badge bg-light text-secondary border small fw-normal">
                                                @rec.WorkDate.ToString("ddd", new System.Globalization.CultureInfo("vi-VN"))
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace px-2.5 py-1.5" style="border-radius: 8px;">
                                            @FormatTime(rec.CheckInTime)
                                        </span>
                                    </td>
                                    <td>
                                        @if (rec.CheckOutTime is not null)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle font-monospace px-2.5 py-1.5" style="border-radius: 8px;">
                                                @FormatTime(rec.CheckOutTime)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted font-monospace">--:--:--</span>
                                        }
                                    </td>
                                    <td>
                                        <strong class="fs-6 text-dark font-monospace">@(rec.ActualHours.HasValue ? $"{rec.ActualHours.Value:F2}h" : "--")</strong>
                                    </td>
                                    <td>
                                        @if (rec.CheckOutTime is not null)
                                        {
                                            <span class="badge bg-success text-white rounded-pill px-3 py-1">Hoàn thành</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-1">Đang làm việc</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-muted small">
                                        @(string.IsNullOrWhiteSpace(rec.Notes) ? "-" : rec.Notes)
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer for History Table -->
        @if (historyRecords.Count > 0)
        {
            <div class="card-footer bg-white border-top border-light py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Hiển thị <strong class="text-dark">@(((historyCurrentPage - 1) * historyPageSize) + 1)</strong>
                    đến <strong class="text-dark">@(Math.Min(historyCurrentPage * historyPageSize, historyRecords.Count))</strong>
                    trong tổng số <strong class="text-dark">@historyRecords.Count</strong> ngày làm việc
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted me-1">Số dòng:</span>
                    <select class="form-select form-select-sm" style="width: auto; border-radius: 8px;" value="@historyPageSize" @onchange="OnHistoryPageSizeChanged">
                        <option value="5">5 / trang</option>
                        <option value="10">10 / trang</option>
                        <option value="15">15 / trang</option>
                        <option value="30">30 / trang</option>
                    </select>

                    <ul class="pagination pagination-sm mb-0 ms-2 pagination-custom">
                        <li class="page-item @(historyCurrentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetHistoryPage(1)" title="Trang đầu">«</button>
                        </li>
                        <li class="page-item @(historyCurrentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetHistoryPage(historyCurrentPage - 1)" title="Trang trước">‹</button>
                        </li>

                        @for (int i = 1; i <= historyTotalPages; i++)
                        {
                            var pageNum = i;
                            if (pageNum == 1 || pageNum == historyTotalPages || (pageNum >= historyCurrentPage - 1 && pageNum <= historyCurrentPage + 1))
                            {
                                <li class="page-item @(historyCurrentPage == pageNum ? "active" : "")">
                                    <button class="page-link" @onclick="() => SetHistoryPage(pageNum)">@pageNum</button>
                                </li>
                            }
                            else if (pageNum == historyCurrentPage - 2 || pageNum == historyCurrentPage + 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        <li class="page-item @(historyCurrentPage >= historyTotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetHistoryPage(historyCurrentPage + 1)" title="Trang kế">›</button>
                        </li>
                        <li class="page-item @(historyCurrentPage >= historyTotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetHistoryPage(historyTotalPages)" title="Trang cuối">»</button>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>

    <!-- Team Attendance Monitor for Managers & HR -->
    <AuthorizeView>
        <Authorized Context="authCtx">
            @if (authCtx.User.IsInRole("ADMIN") || authCtx.User.HasClaim("permission", PermissionCodes.AttendanceTeamApprove) || authCtx.User.HasClaim("permission", "ATT_APPROVE"))
            {
                <div class="card border-0 shadow-sm mt-4" style="border-radius: 18px;">
                    <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                        <div>
                            <strong class="text-dark fs-5">📋 THEO DÕI ĐIỂM DANH TOÀN CÔNG TY HÔM NAY</strong>
                            <div class="text-muted small">Dành cho Trưởng bộ phận và Cán bộ Nhân sự (HR) · @teamRecords.Count nhân sự</div>
                        </div>
                        <button class="btn btn-sm btn-outline-success rounded-pill px-3" @onclick="LoadTeamDataAsync" disabled="@isLoadingTeam">
                            ↻ Cập nhật
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-secondary small">
                                    <tr>
                                        <th class="ps-4">NHÂN VIÊN</th>
                                        <th>PHÒNG BAN</th>
                                        <th>GIỜ VÀO</th>
                                        <th>GIỜ RA</th>
                                        <th>GIỜ THỰC TẾ</th>
                                        <th class="pe-4">TRẠNG THÁI</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (teamRecords.Count == 0 && !isLoadingTeam)
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu nhân viên.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var emp in pagedTeamRecords)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <strong>@emp.FullName</strong>
                                                    <div class="small text-muted font-monospace">@emp.EmployeeCode</div>
                                                </td>
                                                <td><span class="badge bg-light text-dark border">@emp.DepartmentName</span></td>
                                                <td>
                                                    <span class="font-monospace">@(emp.CheckInTime.HasValue ? emp.CheckInTime.Value.ToLocalTime().ToString("HH:mm:ss") : "--:--:--")</span>
                                                </td>
                                                <td>
                                                    <span class="font-monospace">@(emp.CheckOutTime.HasValue ? emp.CheckOutTime.Value.ToLocalTime().ToString("HH:mm:ss") : "--:--:--")</span>
                                                </td>
                                                <td>
                                                    <strong>@(emp.ActualHours.HasValue ? $"{emp.ActualHours.Value:F2}h" : "--")</strong>
                                                </td>
                                                <td class="pe-4">
                                                    @if (emp.CheckOutTime.HasValue)
                                                    {
                                                        <span class="badge bg-success text-white rounded-pill px-2.5 py-1">Đã hoàn thành</span>
                                                    }
                                                    else if (emp.CheckInTime.HasValue)
                                                    {
                                                        <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1">Đang làm việc</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1">Chưa vào ca</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Team Attendance Pagination Footer -->
                    @if (teamRecords.Count > 0)
                    {
                        <div class="card-footer bg-white border-top border-light py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                            <div class="small text-muted">
                                Hiển thị <strong class="text-dark">@(((teamCurrentPage - 1) * teamPageSize) + 1)</strong>
                                đến <strong class="text-dark">@(Math.Min(teamCurrentPage * teamPageSize, teamRecords.Count))</strong>
                                trong tổng số <strong class="text-dark">@teamRecords.Count</strong> nhân sự
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <ul class="pagination pagination-sm mb-0 pagination-custom">
                                    <li class="page-item @(teamCurrentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => SetTeamPage(1)">«</button>
                                    </li>
                                    <li class="page-item @(teamCurrentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => SetTeamPage(teamCurrentPage - 1)">‹</button>
                                    </li>
                                    @for (int p = 1; p <= teamTotalPages; p++)
                                    {
                                        var pageNum = p;
                                        if (pageNum == 1 || pageNum == teamTotalPages || (pageNum >= teamCurrentPage - 1 && pageNum <= teamCurrentPage + 1))
                                        {
                                            <li class="page-item @(teamCurrentPage == pageNum ? "active" : "")">
                                                <button class="page-link" @onclick="() => SetTeamPage(pageNum)">@pageNum</button>
                                            </li>
                                        }
                                        else if (pageNum == teamCurrentPage - 2 || pageNum == teamCurrentPage + 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }
                                    }
                                    <li class="page-item @(teamCurrentPage >= teamTotalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => SetTeamPage(teamCurrentPage + 1)">›</button>
                                    </li>
                                    <li class="page-item @(teamCurrentPage >= teamTotalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => SetTeamPage(teamTotalPages)">»</button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

