@code {
    private AttendanceTodayResponse? todayStatus;
    private IReadOnlyList<AttendanceRecordDto> historyRecords = [];
    private IReadOnlyList<TeamAttendanceItemDto> teamRecords = [];
    private bool isLoading = true;
    private bool isLoadingTeam = false;
    private bool isSubmitting = false;
    private string? successMessage;
    private string? errorMessage;
    private string? inputNotes;

    private int selectedHistoryDays = 14;
    private int historyCurrentPage = 1;
    private int historyPageSize = 5;
    private int historyTotalPages => Math.Max(1, (int)Math.Ceiling((double)historyRecords.Count / historyPageSize));
    private IEnumerable<AttendanceRecordDto> pagedHistoryRecords => historyRecords.Skip((historyCurrentPage - 1) * historyPageSize).Take(historyPageSize);

    private int teamCurrentPage = 1;
    private int teamPageSize = 5;
    private int teamTotalPages => Math.Max(1, (int)Math.Ceiling((double)teamRecords.Count / teamPageSize));
    private IEnumerable<TeamAttendanceItemDto> pagedTeamRecords => teamRecords.Skip((teamCurrentPage - 1) * teamPageSize).Take(teamPageSize);

    private System.Threading.Timer? clockTimer;
    private string currentDateStr = DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"));
    private string currentTimeStr = DateTime.Now.ToString("HH:mm:ss");

    protected override async Task OnInitializedAsync()
    {
        clockTimer = new System.Threading.Timer(_ =>
        {
            var now = DateTime.Now;
            currentDateStr = now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"));
            currentTimeStr = now.ToString("HH:mm:ss");
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

        await LoadDataAsync();
        _ = LoadTeamDataAsync();
    }

    private async Task LoadTeamDataAsync()
    {
        isLoadingTeam = true;
        try
        {
            teamRecords = await AttendanceApiClient.GetTeamSummaryAsync();
        }
        catch
        {
            teamRecords = [];
        }
        finally
        {
            isLoadingTeam = false;
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            todayStatus = await AttendanceApiClient.GetTodayStatusAsync();
            historyRecords = await AttendanceApiClient.GetHistoryAsync(selectedHistoryDays);
            if (historyCurrentPage > historyTotalPages)
            {
                historyCurrentPage = 1;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Không thể tải dữ liệu chấm công: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnHistoryDaysChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var days) && days > 0)
        {
            selectedHistoryDays = days;
            historyCurrentPage = 1;
            await LoadDataAsync();
        }
    }

    private void SetHistoryPage(int page)
    {
        if (page >= 1 && page <= historyTotalPages)
        {
            historyCurrentPage = page;
        }
    }

    private void OnHistoryPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            historyPageSize = size;
            historyCurrentPage = 1;
        }
    }

    private void SetTeamPage(int page)
    {
        if (page >= 1 && page <= teamTotalPages)
        {
            teamCurrentPage = page;
        }
    }

    private async Task DoCheckInAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var res = await AttendanceApiClient.CheckInAsync(inputNotes);
            inputNotes = null;
            successMessage = res?.Message ?? "Điểm danh vào ca thành công!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DoCheckOutAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var res = await AttendanceApiClient.CheckOutAsync(inputNotes);
            inputNotes = null;
            successMessage = res?.Message ?? "Điểm danh ra ca thành công!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static string FormatTime(DateTimeOffset? dto)
    {
        if (dto is null) return "--:--:--";
        var local = dto.Value.ToLocalTime();
        return local.ToString("HH:mm:ss");
    }

    public void Dispose()
    {
        clockTimer?.Dispose();
    }
}
