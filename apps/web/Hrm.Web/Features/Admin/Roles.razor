@page "/admin/roles"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMIN")]
@inject AdminApiClient AdminApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Vai trò và quyền</PageTitle>

<div class="d-flex justify-content-between align-items-center gap-3 mb-2">
    <h1 class="h3 mb-0">Vai trò và quyền</h1>
    <button class="btn btn-primary" @onclick="ToggleCreateForm">
        <span class="me-1">+</span> Thêm vai trò
    </button>
</div>
<p class="text-secondary">Backend luôn là authority cuối cùng. Mọi thay đổi permission đều được ghi audit.</p>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(hasError ? "alert-danger" : "alert-success")">@message</div>
}

@if (showCreateForm)
{
    <section class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Tạo vai trò mới</h2>
                <button type="button" class="btn-close" aria-label="Đóng" @onclick="CancelCreate"></button>
            </div>
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label" for="role-name">Tên vai trò <span class="text-danger">*</span></label>
                    <input id="role-name" class="form-control" placeholder="Ví dụ: Quản lý cửa hàng" @bind="newRoleName" />
                </div>
                <div class="col-md-7">
                    <label class="form-label" for="role-description">Mô tả</label>
                    <input id="role-description" class="form-control" maxlength="250" placeholder="Mô tả trách nhiệm của vai trò" @bind="newRoleDescription" />
                </div>
            </div>
            <hr />
            <div class="fw-semibold mb-2">Quyền ban đầu theo phân hệ</div>
            <div class="row g-2">
                @foreach (var cat in PermissionCodes.Catalog.GroupBy(d => d.Category))
                {
                    <div class="col-12 mt-2 mb-1">
                        <span class="badge bg-secondary-subtle text-dark border px-2 py-1">@cat.Key</span>
                    </div>
                    @foreach (var def in cat)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="p-2 border rounded bg-white h-100">
                                <label class="form-check d-flex align-items-start gap-2 mb-0">
                                    <input class="form-check-input mt-1" type="checkbox"
                                           checked="@newRolePermissions.Contains(def.Code)"
                                           @onchange="args => ToggleNewRolePermission(def.Code, args)" />
                                    <div>
                                        <div class="fw-semibold small text-dark">@def.Name</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@def.Description</div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="mt-3">
                <button class="btn btn-primary me-2" disabled="@isCreating" @onclick="CreateRoleAsync">
                    @(isCreating ? "Đang tạo..." : "Tạo vai trò")
                </button>
                <button class="btn btn-outline-secondary" disabled="@isCreating" @onclick="CancelCreate">Hủy</button>
            </div>
        </div>
    </section>
}

@if (roles.Count == 0)
{
    <p class="text-secondary">Đang tải vai trò...</p>
}
else
{
    <div class="row g-3">
        @foreach (var role in roles)
        {
            <div class="col-12">
                <section class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div><h2 class="h5 mb-1">@role.Name</h2><p class="text-secondary">@role.Description</p></div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => BeginEdit(role)">Chỉnh quyền</button>
                                @if (!role.Name.Equals("ADMIN", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@(deletingRoleId == role.Id)"
                                            @onclick="() => DeleteRoleAsync(role)">
                                        @(deletingRoleId == role.Id ? "Đang xóa..." : "Xóa")
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @foreach (var permission in role.Permissions)
                            {
                                <span class="badge bg-light text-dark border py-1 px-2" title="Mã kỹ thuật: @permission">
                                    <span class="text-success me-1">✓</span>@PermissionCodes.GetDisplayName(permission)
                                    <small class="text-muted ms-1">(@permission)</small>
                                </span>
                            }
                        </div>
                        @if (editingRoleId == role.Id)
                        {
                            <hr />
                            <div class="fw-semibold mb-2">Chỉnh sửa phân quyền vai trò</div>
                            <div class="row g-2">
                                @foreach (var cat in PermissionCodes.Catalog.GroupBy(d => d.Category))
                                {
                                    <div class="col-12 mt-2 mb-1">
                                        <span class="badge bg-secondary-subtle text-dark border px-2 py-1">@cat.Key</span>
                                    </div>
                                    @foreach (var def in cat)
                                    {
                                        <div class="col-md-6 col-xl-4">
                                            <div class="p-2 border rounded bg-white h-100">
                                                <label class="form-check d-flex align-items-start gap-2 mb-0">
                                                    <input class="form-check-input mt-1" type="checkbox"
                                                           checked="@selectedPermissions.Contains(def.Code)"
                                                           @onchange="args => TogglePermission(def.Code, args)" />
                                                    <div>
                                                        <div class="fw-semibold small text-dark">@def.Name</div>
                                                        <div class="text-muted" style="font-size: 0.75rem;">@def.Description</div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="mt-3"><button class="btn btn-primary me-2" @onclick="SaveAsync">Lưu quyền</button><button class="btn btn-outline-secondary" @onclick="CancelEdit">Hủy</button></div>
                        }
                    </div>
                </section>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyCollection<RoleDto> roles = [];
    private readonly HashSet<string> selectedPermissions = new(StringComparer.Ordinal);
    private readonly HashSet<string> newRolePermissions = new(StringComparer.Ordinal);
    private long? editingRoleId;
    private long? deletingRoleId;
    private bool showCreateForm;
    private bool isCreating;
    private string newRoleName = string.Empty;
    private string newRoleDescription = string.Empty;
    private string? message;
    private bool hasError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var response = await AdminApiClient.GetRolesAsync();
        roles = response?.Data ?? [];
        if (response?.Error is not null) { message = response.Error.Message; hasError = true; }
    }

    private void BeginEdit(RoleDto role)
    {
        editingRoleId = role.Id;
        selectedPermissions.Clear();
        foreach (var p in role.Permissions)
        {
            selectedPermissions.Add(PermissionCodes.Canonicalize(p));
        }
        message = null;
    }

    private void TogglePermission(string permission, ChangeEventArgs args)
    {
        if (args.Value is true) selectedPermissions.Add(permission);
        else selectedPermissions.Remove(permission);
    }

    private void CancelEdit() { editingRoleId = null; selectedPermissions.Clear(); }

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        message = null;
        if (!showCreateForm) ResetCreateForm();
    }

    private void ToggleNewRolePermission(string permission, ChangeEventArgs args)
    {
        if (args.Value is true) newRolePermissions.Add(permission);
        else newRolePermissions.Remove(permission);
    }

    private void CancelCreate()
    {
        showCreateForm = false;
        ResetCreateForm();
    }

    private void ResetCreateForm()
    {
        newRoleName = string.Empty;
        newRoleDescription = string.Empty;
        newRolePermissions.Clear();
    }

    private async Task CreateRoleAsync()
    {
        if (string.IsNullOrWhiteSpace(newRoleName))
        {
            hasError = true;
            message = "Vui lòng nhập tên vai trò.";
            return;
        }

        isCreating = true;
        try
        {
            var response = await AdminApiClient.CreateRoleAsync(new CreateRoleRequest(
                newRoleName, newRoleDescription, newRolePermissions.ToArray()));
            hasError = response?.Success != true;
            message = hasError
                ? response?.Error?.Message ?? "Không thể tạo vai trò."
                : $"Đã tạo vai trò {response?.Data?.Name}.";
            if (!hasError)
            {
                CancelCreate();
                await LoadAsync();
            }
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task DeleteRoleAsync(RoleDto role)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm", $"Bạn có chắc muốn xóa vai trò '{role.Name}'? Thao tác này không thể hoàn tác.");
        if (!confirmed) return;

        deletingRoleId = role.Id;
        message = null;
        try
        {
            var response = await AdminApiClient.DeleteRoleAsync(role.Id);
            hasError = response?.Success != true;
            message = hasError
                ? response?.Error?.Message ?? "Không thể xóa vai trò."
                : $"Đã xóa vai trò {role.Name}.";
            if (!hasError)
            {
                if (editingRoleId == role.Id) CancelEdit();
                await LoadAsync();
            }
        }
        finally
        {
            deletingRoleId = null;
        }
    }

    private async Task SaveAsync()
    {
        if (editingRoleId is null) return;
        var response = await AdminApiClient.SetRolePermissionsAsync(editingRoleId.Value, selectedPermissions.ToArray());
        hasError = response?.Success != true;
        message = hasError ? response?.Error?.Message ?? "Không thể cập nhật quyền." : "Đã cập nhật quyền và ghi audit.";
        if (!hasError) { CancelEdit(); await LoadAsync(); }
    }
}
