@page "/admin/audit"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMIN")]
@inject AdminApiClient AdminApiClient

<PageTitle>Nhật ký kiểm toán</PageTitle>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-journal-text text-primary"></i>
            <span>Nhật ký kiểm toán</span>
        </h1>
        <p class="text-secondary mb-0">Theo dõi toàn bộ lịch sử thao tác, thay đổi tài khoản, trạng thái và phân quyền hệ thống.</p>
    </div>
</div>

<section class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3 p-md-4">
        <!-- Bộ lọc tìm kiếm -->
        <div class="row g-2 mb-3">
            <div class="col-md-4 col-lg-3">
                <select class="form-select shadow-sm" @bind="selectedCategory" @bind:after="OnCategoryChangedAsync">
                    <option value="">Tất cả phân hệ</option>
                    <option value="admin.role">Phân quyền &amp; Vai trò</option>
                    <option value="admin.user">Tài khoản &amp; Bảo mật</option>
                    <option value="employee">Hồ sơ nhân viên</option>
                </select>
            </div>
            <div class="col-md-5 col-lg-6">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" style="pointer-events: none;"></i>
                    <input class="form-control shadow-sm" style="padding-left: 2.35rem;" 
                           placeholder="Lọc theo từ khóa hành động (vd: password, created, permissions)..." 
                           @bind="actionQuery" @bind:event="oninput" @onkeydown="HandleKeyDownAsync" />
                </div>
            </div>
            <div class="col-md-3 col-lg-3 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-1" @onclick="SearchAsync">
                    <i class="bi bi-filter"></i>
                    <span>Lọc</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(actionQuery) || !string.IsNullOrWhiteSpace(selectedCategory))
                {
                    <button class="btn btn-outline-secondary d-flex align-items-center gap-1" title="Đặt lại bộ lọc" @onclick="ResetFilterAsync">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                }
            </div>
        </div>

        @if (entries.Count == 0)
        {
            <div class="text-center py-5">
                <div class="avatar-lg bg-light rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                    <i class="bi bi-clipboard-x fs-2 text-muted"></i>
                </div>
                <h6 class="fw-semibold text-secondary">Không tìm thấy bản ghi kiểm toán nào</h6>
                <p class="text-muted small mb-0">Thử thay đổi từ khóa lọc hoặc thiết lập lại bộ lọc phân hệ.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-3 py-3" style="min-width: 140px;">
                                <i class="bi bi-clock me-1 text-muted"></i>Thời gian
                            </th>
                            <th style="min-width: 240px;">
                                <i class="bi bi-lightning-charge me-1 text-muted"></i>Hành động
                            </th>
                            <th style="min-width: 180px;">
                                <i class="bi bi-box me-1 text-muted"></i>Đối tượng
                            </th>
                            <th style="min-width: 170px;">
                                <i class="bi bi-person me-1 text-muted"></i>Người thực hiện
                            </th>
                            <th class="text-end pe-3" style="min-width: 110px;">
                                <i class="bi bi-gear me-1 text-muted"></i>Thao tác
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in entries)
                    {
                        var actionMeta = GetActionMeta(entry.Action);
                        var entityMeta = GetEntityMeta(entry.EntityType);
                        <tr>
                            <!-- Thời gian -->
                            <td class="ps-3">
                                <div class="fw-semibold font-monospace small">@entry.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</div>
                                <div class="text-muted small">@entry.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                            </td>

                            <!-- Hành động -->
                            <td>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="@actionMeta.BadgeClass d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill small fw-medium">
                                        <i class="bi @actionMeta.IconClass"></i>
                                        <span>@actionMeta.Label</span>
                                    </span>
                                </div>
                                <div class="text-muted font-monospace small" style="font-size: 0.75rem;">
                                    @entry.Action
                                </div>
                            </td>

                            <!-- Đối tượng tác động -->
                            <td>
                                <div class="d-inline-flex align-items-center gap-1 px-2 py-1 bg-light rounded text-dark small border">
                                    <i class="bi @entityMeta.IconClass @entityMeta.IconColor"></i>
                                    <span class="fw-medium">@entityMeta.Label:</span>
                                    <span class="font-monospace text-secondary">#@entry.EntityId</span>
                                </div>
                            </td>

                            <!-- Actor -->
                            <td>
                                @if (entry.ActorUserId.HasValue)
                                {
                                    <span class="d-inline-flex align-items-center gap-1 small text-dark">
                                        <i class="bi bi-person-circle text-primary"></i>
                                        <span>Quản trị viên <strong class="font-monospace">#@entry.ActorUserId</strong></span>
                                    </span>
                                }
                                else
                                {
                                    <span class="d-inline-flex align-items-center gap-1 small text-secondary">
                                        <i class="bi bi-cpu text-secondary"></i>
                                        <span>Hệ thống tự động</span>
                                    </span>
                                }
                            </td>

                            <!-- Thao tác -->
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                        @onclick="() => ViewDetail(entry)" title="Xem chi tiết thay đổi">
                                    <i class="bi bi-eye"></i>
                                    <span>Chi tiết</span>
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang chuẩn mẫu -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-3 border-top mt-3 gap-3">
                <div class="small text-muted">
                    Hiển thị <strong class="text-dark">@(((currentPage - 1) * pageSize) + 1)</strong>
                    đến <strong class="text-dark">@(Math.Min(currentPage * pageSize, total))</strong>
                    trong tổng số <strong class="text-dark">@total</strong> bản ghi
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="small text-muted me-1 emp-page-size-label text-nowrap">Số dòng:</span>
                    <select class="form-select form-select-sm emp-page-size-select" value="@pageSize" @onchange="OnPageSizeChangedAsync">
                        <option value="5">5 / trang</option>
                        <option value="10">10 / trang</option>
                        <option value="20">20 / trang</option>
                        <option value="50">50 / trang</option>
                    </select>

                    <ul class="pagination pagination-sm mb-0 ms-2 pagination-custom">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPageAsync(1)" title="Trang đầu">«</button>
                        </li>
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPageAsync(currentPage - 1)" title="Trang trước">‹</button>
                        </li>

                        @foreach (var p in GetSmartPages())
                        {
                            if (p.IsEllipsis)
                            {
                                <li class="page-item" title="Nhảy 5 trang (@(p.TargetPage))">
                                    <button class="page-link text-muted fw-bold" @onclick="() => SetPageAsync(p.TargetPage)">...</button>
                                </li>
                            }
                            else
                            {
                                <li class="page-item @(currentPage == p.PageNumber ? "active" : "")">
                                    <button class="page-link" @onclick="() => SetPageAsync(p.PageNumber)">@p.Text</button>
                                </li>
                            }
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPageAsync(currentPage + 1)" title="Trang kế">›</button>
                        </li>
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPageAsync(totalPages)" title="Trang cuối">»</button>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>
</section>

<!-- Modal chi tiết Audit Log -->
@if (selectedLog is not null)
{
    var modalAction = GetActionMeta(selectedLog.Action);
    var modalEntity = GetEntityMeta(selectedLog.EntityType);
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-primary"></i>
                        <span>Chi tiết bản ghi kiểm toán</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Thông tin tóm tắt -->
                    <div class="card bg-light border-0 mb-3">
                        <div class="card-body p-3">
                            <div class="row g-2 small">
                                <div class="col-sm-6">
                                    <span class="text-muted">Thời gian:</span>
                                    <div class="fw-semibold">
                                        <i class="bi bi-clock me-1 text-secondary"></i>
                                        @selectedLog.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted">Người thực hiện:</span>
                                    <div class="fw-semibold">
                                        @if (selectedLog.ActorUserId.HasValue)
                                        {
                                            <i class="bi bi-person-circle me-1 text-primary"></i>
                                            <span>Quản trị viên #@selectedLog.ActorUserId</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cpu me-1 text-secondary"></i>
                                            <span>Hệ thống tự động</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted">Hành động:</span>
                                    <div>
                                        <span class="@modalAction.BadgeClass d-inline-flex align-items-center gap-1 px-2 py-0.5 rounded-pill small fw-medium">
                                            <i class="bi @modalAction.IconClass"></i>
                                            @modalAction.Label
                                        </span>
                                        <div class="font-monospace text-muted mt-1" style="font-size: 0.75rem;">@selectedLog.Action</div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted">Đối tượng tác động:</span>
                                    <div>
                                        <i class="bi @modalEntity.IconClass @modalEntity.IconColor me-1"></i>
                                        <strong>@modalEntity.Label</strong> (ID: <code class="text-dark">@selectedLog.EntityId</code>)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- So sánh dữ liệu Before / After -->
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-file-earmark-arrow-down text-secondary"></i>
                                <h6 class="mb-0 fw-semibold text-secondary small text-uppercase">Dữ liệu trước thay đổi (Before)</h6>
                            </div>
                            <pre class="bg-dark text-light p-3 rounded-3 small font-monospace overflow-auto" 
                                 style="max-height: 280px; font-size: 0.8rem;"><code>@(FormatJson(selectedLog.BeforeJson))</code></pre>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-file-earmark-check text-success"></i>
                                <h6 class="mb-0 fw-semibold text-success small text-uppercase">Dữ liệu sau thay đổi (After)</h6>
                            </div>
                            <pre class="bg-dark text-light p-3 rounded-3 small font-monospace overflow-auto" 
                                 style="max-height: 280px; font-size: 0.8rem;"><code>@(FormatJson(selectedLog.AfterJson))</code></pre>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-secondary d-flex align-items-center gap-1" @onclick="CloseDetail">
                        <i class="bi bi-x-lg"></i>
                        <span>Đóng</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyCollection<AuditLogDto> entries = [];
    private string? actionQuery;
    private string selectedCategory = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private long total;
    private int totalPages => total == 0 ? 1 : (int)Math.Ceiling((double)total / pageSize);
    private AuditLogDto? selectedLog;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnCategoryChangedAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task ResetFilterAsync()
    {
        actionQuery = null;
        selectedCategory = "";
        currentPage = 1;
        await LoadAsync();
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            pageSize = size;
            currentPage = 1;
            await LoadAsync();
        }
    }

    private async Task SetPageAsync(int targetPage)
    {
        if (targetPage >= 1 && targetPage <= totalPages && targetPage != currentPage)
        {
            currentPage = targetPage;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        // Ưu tiên filter theo từ khóa, nếu rỗng thì theo danh mục phân hệ
        var filter = !string.IsNullOrWhiteSpace(actionQuery) 
            ? actionQuery.Trim() 
            : (!string.IsNullOrWhiteSpace(selectedCategory) ? selectedCategory : null);

        var response = await AdminApiClient.SearchAuditAsync(filter, currentPage, pageSize);
        entries = response?.Data?.Items ?? [];
        total = response?.Data?.Total ?? 0;
    }

    private void ViewDetail(AuditLogDto log)
    {
        selectedLog = log;
    }

    private void CloseDetail()
    {
        selectedLog = null;
    }

    private sealed record PageItem(int PageNumber, string Text, bool IsEllipsis = false, int TargetPage = 0);

    private IEnumerable<PageItem> GetSmartPages()
    {
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++)
                yield return new PageItem(i, i.ToString());
            yield break;
        }

        // Luôn có trang đầu tiên 1
        yield return new PageItem(1, "1");

        // Khi ở các trang đầu (<= 4): 1 2 3 4 5 ... Last
        if (currentPage <= 4)
        {
            for (int i = 2; i <= 5; i++)
                yield return new PageItem(i, i.ToString());

            yield return new PageItem(-1, "...", IsEllipsis: true, TargetPage: Math.Min(totalPages, currentPage + 5));
            yield return new PageItem(totalPages, totalPages.ToString());
        }
        // Khi ở các trang cuối (>= totalPages - 3): 1 ... Last-4 Last-3 Last-2 Last-1 Last
        else if (currentPage >= totalPages - 3)
        {
            yield return new PageItem(-1, "...", IsEllipsis: true, TargetPage: Math.Max(1, currentPage - 5));
            for (int i = totalPages - 4; i <= totalPages; i++)
                yield return new PageItem(i, i.ToString());
        }
        // Khi ở giữa: 1 ... Cur-1 Cur Cur+1 ... Last
        else
        {
            yield return new PageItem(-1, "...", IsEllipsis: true, TargetPage: Math.Max(1, currentPage - 5));
            yield return new PageItem(currentPage - 1, (currentPage - 1).ToString());
            yield return new PageItem(currentPage, currentPage.ToString());
            yield return new PageItem(currentPage + 1, (currentPage + 1).ToString());
            yield return new PageItem(-2, "...", IsEllipsis: true, TargetPage: Math.Min(totalPages, currentPage + 5));
            yield return new PageItem(totalPages, totalPages.ToString());
        }
    }

    private static string FormatJson(string? rawJson)
    {
        if (string.IsNullOrWhiteSpace(rawJson)) return "(Không có dữ liệu)";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(rawJson);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions 
            { 
                WriteIndented = true 
            });
        }
        catch
        {
            return rawJson;
        }
    }

    private static (string Label, string BadgeClass, string IconClass) GetActionMeta(string action)
    {
        return action switch
        {
            "admin.role.permissions.changed" => ("Đổi quyền vai trò", "bg-warning-subtle text-warning-emphasis border border-warning-subtle", "bi-shield-lock-fill text-warning"),
            "admin.user.password-reset" => ("Đặt lại mật khẩu", "bg-danger-subtle text-danger border border-danger-subtle", "bi-key-fill text-danger"),
            "admin.user.created" => ("Tạo tài khoản", "bg-success-subtle text-success border border-success-subtle", "bi-person-plus-fill text-success"),
            "admin.user.locked" => ("Khóa tài khoản", "bg-danger-subtle text-danger border border-danger-subtle", "bi-lock-fill text-danger"),
            "admin.user.unlocked" => ("Mở khóa tài khoản", "bg-info-subtle text-info border border-info-subtle", "bi-unlock-fill text-info"),
            "admin.user.status.changed" => ("Đổi trạng thái tài khoản", "bg-warning-subtle text-warning-emphasis border border-warning-subtle", "bi-arrow-repeat text-warning"),
            "employee.created" => ("Tạo mới nhân viên", "bg-success-subtle text-success border border-success-subtle", "bi-person-badge-fill text-success"),
            "employee.updated" => ("Cập nhật nhân viên", "bg-info-subtle text-info-emphasis border border-info-subtle", "bi-pencil-square text-info"),
            "employee.offboarded" => ("Thôi việc nhân viên", "bg-danger-subtle text-danger border border-danger-subtle", "bi-person-x-fill text-danger"),
            _ when action.Contains("created") => ("Thêm mới", "bg-success-subtle text-success border border-success-subtle", "bi-plus-circle-fill text-success"),
            _ when action.Contains("updated") => ("Cập nhật", "bg-info-subtle text-info-emphasis border border-info-subtle", "bi-pencil-square text-info"),
            _ when action.Contains("deleted") || action.Contains("removed") => ("Xóa", "bg-danger-subtle text-danger border border-danger-subtle", "bi-trash-fill text-danger"),
            _ when action.Contains("password") => ("Mật khẩu", "bg-danger-subtle text-danger border border-danger-subtle", "bi-key-fill text-danger"),
            _ when action.Contains("permission") || action.Contains("role") => ("Phân quyền", "bg-warning-subtle text-warning-emphasis border border-warning-subtle", "bi-shield-lock-fill text-warning"),
            _ => (action, "bg-light text-secondary border", "bi-activity text-secondary")
        };
    }

    private static (string Label, string IconClass, string IconColor) GetEntityMeta(string entityType)
    {
        return entityType?.ToLowerInvariant() switch
        {
            "role" => ("Vai trò", "bi-shield-fill", "text-warning"),
            "user" => ("Tài khoản", "bi-person-fill", "text-primary"),
            "employee" => ("Nhân sự", "bi-person-vcard-fill", "text-info"),
            "department" => ("Phòng ban", "bi-diagram-3-fill", "text-success"),
            _ => (entityType ?? "Đối tượng", "bi-box-seam-fill", "text-secondary")
        };
    }
}

