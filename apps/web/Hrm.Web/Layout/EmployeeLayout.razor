@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthApiClient AuthApiClient
@inject BrowserSessionStore SessionStore
@inject NavigationManager Navigation

<div class="emp-shell">
    <aside class="emp-sidebar">
        <a class="emp-brand" href="employee/attendance">
            <span class="emp-brand-mark">HR</span>
            <span><strong>HRM System</strong><small>EMPLOYEE PORTAL</small></span>
        </a>
        <p class="emp-nav-label">CỔNG NHÂN VIÊN</p>
        <nav class="emp-nav">
            <AuthorizeView>
                <Authorized Context="authContext">
                    @{
                        var groups = GetVisibleNavGroups(authContext.User);
                        var anyItems = false;
                    }
                    @foreach (var group in groups)
                    {
                        var items = group.ToList();
                        if (items.Count > 0)
                        {
                            anyItems = true;
                            if (!string.IsNullOrEmpty(group.Key))
                            {
                                <div class="emp-nav-section-title">@group.Key</div>
                            }
                            @foreach (var item in items)
                            {
                                <NavLink class="emp-nav-link" href="@item.Href" Match="@item.Match">
                                    <span class="emp-nav-icon"><i class="@item.Icon"></i></span>
                                    <span>@item.Title</span>
                                </NavLink>
                            }
                        }
                    }
                    @if (!anyItems)
                    {
                        <div class="px-3 py-2 text-muted small text-center" style="color: var(--emp-sidebar-text) !important;">
                            Chưa được phân quyền chức năng
                        </div>
                    }
                </Authorized>
            </AuthorizeView>
        </nav>
        <button class="emp-logout" @onclick="LogoutAsync">
            <span class="emp-nav-icon"><i class="bi bi-box-arrow-right"></i></span>
            <span>Đăng xuất</span>
        </button>
    </aside>
    <main class="emp-main">
        <header class="emp-topbar">
            <div>
                <span class="emp-topbar-kicker">HRM SYSTEM</span>
                <strong style="color: var(--emp-heading); font-size: 1rem;">Cổng thông tin &amp; Chấm công Nhân viên</strong>
            </div>
            <AuthorizeView>
                <Authorized Context="authContext">
                    <a class="emp-user text-decoration-none" href="employee/profile" title="Bấm vào đây để xem và chỉnh sửa thông tin cá nhân">
                        <span class="emp-avatar">@GetInitial(authContext.User.FindFirst("full_name")?.Value)</span>
                        <span>
                            <strong style="color: var(--emp-heading);">@authContext.User.FindFirst("full_name")?.Value</strong>
                            <small class="emp-badge-success">Nhân viên ✎</small>
                        </span>
                    </a>
                </Authorized>
            </AuthorizeView>
        </header>
        <article class="emp-content">
            @Body
        </article>
    </main>
</div>

@code {
    private System.Threading.Timer? statusScannerTimer;
    private bool isHandlingKickOut = false;
    private bool isCheckingStatus = false;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;

        // Cơ chế quét định kỳ: kiểm tra trạng thái tài khoản mỗi 45 giây
        statusScannerTimer = new System.Threading.Timer(async _ =>
        {
            await CheckStatusAsync();
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(45));
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await CheckStatusAsync();
    }

    private async Task CheckStatusAsync()
    {
        if (isHandlingKickOut || isCheckingStatus) return;
        isCheckingStatus = true;

        try
        {
            var status = await AuthApiClient.CheckAccountStatusAsync();
            if (!status.CanAccess && !isHandlingKickOut)
            {
                isHandlingKickOut = true;
                statusScannerTimer?.Dispose();
                await SessionStore.ClearAsync();
                try
                {
                    await AuthApiClient.LogoutAsync();
                }
                catch
                {
                    // Silent
                }

                await InvokeAsync(() =>
                {
                    Navigation.NavigateTo($"employee-login?reason={status.Reason}", forceLoad: true);
                });
            }
        }
        catch
        {
            // Silent
        }
        finally
        {
            isCheckingStatus = false;
        }
    }

    private async Task LogoutAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        statusScannerTimer?.Dispose();
        await AuthApiClient.LogoutAsync();
        Navigation.NavigateTo("employee-login", true);
    }

    private static string GetInitial(string? fullName) =>
        string.IsNullOrWhiteSpace(fullName) ? "E" : fullName.Trim()[0].ToString().ToUpperInvariant();

    public sealed record EmployeeNavItem(
        string Title,
        string Href,
        string Icon,
        string? RequiredPermission,
        string Category,
        NavLinkMatch Match = NavLinkMatch.Prefix);

    private static readonly IReadOnlyList<EmployeeNavItem> AvailableNavItems =
    [
        // Phân hệ Cá nhân (Self-Service)
        new("Chấm công", "employee/attendance", "bi bi-clock-history", PermissionCodes.AttendanceSelfWrite, "Nghiệp vụ cá nhân", NavLinkMatch.All),
        new("Đơn xin nghỉ phép", "employee/leave", "bi bi-calendar2-check", PermissionCodes.LeaveSelfCreate, "Nghiệp vụ cá nhân", NavLinkMatch.All),
        new("Phiếu lương của tôi", "employee/payslips", "bi bi-wallet2", PermissionCodes.PayrollSelfRead, "Nghiệp vụ cá nhân"),
        new("Hồ sơ của tôi", "employee/profile", "bi bi-person-badge", null, "Nghiệp vụ cá nhân"),

        // Quản lý & Phê duyệt (Management)
        new("Duyệt đơn nghỉ phép", "employee/leave/approvals", "bi bi-clipboard-check", PermissionCodes.LeaveApprove, "Quản lý & Duyệt"),
        new("Tính & Chốt bảng lương", "employee/payroll-management", "bi bi-calculator", PermissionCodes.PayrollRun, "Quản lý & Duyệt"),

        // Phân hệ Chuyên môn & Vận hành (khi Admin cấp quyền)
        new("Tra cứu Nhân sự", "employees", "bi bi-people", PermissionCodes.EmployeeRead, "Chuyên môn & Vận hành"),
        new("Báo cáo & Thống kê", "reports", "bi bi-bar-chart-line", PermissionCodes.ReportRead, "Chuyên môn & Vận hành"),
        new("Nhật ký kiểm toán", "employee/audit", "bi bi-shield-check", PermissionCodes.AuditRead, "Hệ thống")
    ];

    private static IEnumerable<IGrouping<string, EmployeeNavItem>> GetVisibleNavGroups(System.Security.Claims.ClaimsPrincipal user)
    {
        var isAdmin = user.IsInRole("ADMIN");
        var hasWrite = isAdmin || HasPermission(user, PermissionCodes.EmployeeWrite);
        var hasRead = isAdmin || hasWrite || HasPermission(user, PermissionCodes.EmployeeRead);

        var list = new List<EmployeeNavItem>();

        foreach (var item in AvailableNavItems)
        {
            if (item.Href == "employees")
            {
                if (hasWrite)
                {
                    list.Add(new("Quản lý & Thêm Nhân sự", "employees", "bi bi-people-fill", null, "Chuyên môn & Vận hành"));
                }
                else if (hasRead)
                {
                    list.Add(new("Tra cứu Danh bạ", "employees", "bi bi-journal-text", null, "Chuyên môn & Vận hành"));
                }
                continue;
            }

            if (string.IsNullOrEmpty(item.RequiredPermission) || isAdmin || HasPermission(user, item.RequiredPermission))
            {
                list.Add(item);
            }
        }

        return list.GroupBy(item => item.Category);
    }

    private static bool HasPermission(System.Security.Claims.ClaimsPrincipal user, string permission)
    {
        var aliases = PermissionCodes.ExpandWithAliases([permission]);
        return aliases.Any(p => user.HasClaim("permission", p));
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        statusScannerTimer?.Dispose();
    }
}
