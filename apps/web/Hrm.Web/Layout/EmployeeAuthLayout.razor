@inherits LayoutComponentBase

<main class="auth-shell">
    <section class="auth-brand-panel" style="background: radial-gradient(circle at 80% 15%, rgba(16, 185, 129, 0.4), transparent 40%), radial-gradient(circle at 10% 85%, rgba(5, 150, 105, 0.3), transparent 40%), linear-gradient(145deg, #041f17 0%, #062f23 50%, #02110c 100%);">
        <a class="auth-brand" href="attendance">
            <span class="auth-brand-mark" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">SR</span>
            <span><strong>Saigon Retail</strong><small class="d-block" style="font-size: 0.72rem; color: #34d399; font-weight: 600; letter-spacing: 0.05em;">EMPLOYEE PORTAL</small></span>
        </a>
        <div class="auth-brand-copy">
            <span class="eyebrow" style="color: #34d399;">CỔNG THÔNG TIN NHÂN VIÊN</span>
            <h1>Không gian làm việc số cho Nhân viên Saigon Retail.</h1>
            <p>Điểm danh chấm công thời gian thực, nộp đơn xin nghỉ phép, tra cứu phiếu lương và hồ sơ công việc — minh bạch, nhanh chóng và chuẩn xác.</p>
        </div>
        <div class="auth-feature-list">
            <span>✓ Điểm danh &amp; Chấm công trực tuyến (Check-in/out)</span>
            <span>✓ Tạo đơn xin nghỉ phép &amp; Theo dõi trạng thái duyệt</span>
            <span>✓ Tra cứu phiếu lương chi tiết từng kỳ minh bạch</span>
        </div>
    </section>
    <section class="auth-form-panel">
        <div class="auth-form-wrap">@Body</div>
        <p class="auth-footer">© 2026 Saigon Retail HRM • Cổng thông tin Cán bộ Nhân viên</p>
    </section>
</main>
