@inherits LayoutComponentBase
@inject IAuthApiClient AuthApiClient
@inject NavigationManager Navigation

<div class="admin-shell">
    <aside class="admin-sidebar">
        <a class="admin-brand" href="admin/dashboard"><span class="admin-brand-mark">SR</span><span><strong>Saigon Retail</strong><small>ADMIN CONSOLE</small></span></a>
        <p class="admin-nav-label">QUẢN TRỊ HỆ THỐNG</p>
        <nav class="admin-nav">
            <NavLink class="admin-nav-link" href="admin/dashboard"><span>⌂</span>Tổng quan</NavLink>
            <NavLink class="admin-nav-link" href="admin/users"><span>◎</span>Tài khoản</NavLink>
            <NavLink class="admin-nav-link" href="admin/roles"><span>◇</span>Vai trò &amp; quyền</NavLink>
            <NavLink class="admin-nav-link" href="admin/audit"><span>≡</span>Nhật ký kiểm toán</NavLink>
        </nav>
        <button class="admin-logout" @onclick="LogoutAsync"><span>↪</span>Đăng xuất</button>
    </aside>
    <main class="admin-main">
        <header class="admin-topbar">
            <div><span class="admin-topbar-kicker">SAIGON RETAIL</span><strong>Trung tâm quản trị</strong></div>
            <AuthorizeView>
                <Authorized Context="authContext">
                    <div class="admin-user"><span class="admin-avatar">@GetInitial(authContext.User.FindFirst("full_name")?.Value)</span><span><strong>@authContext.User.FindFirst("full_name")?.Value</strong><small>Administrator</small></span></div>
                </Authorized>
            </AuthorizeView>
        </header>
        <article class="admin-content">@Body</article>
    </main>
</div>

@code {
    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();
        Navigation.NavigateTo("admin_login", true);
    }

    private static string GetInitial(string? fullName) =>
        string.IsNullOrWhiteSpace(fullName) ? "A" : fullName.Trim()[0].ToString().ToUpperInvariant();
}
