@inherits LayoutComponentBase
@inject IAuthApiClient AuthApiClient
@inject NavigationManager Navigation

<div class="d-flex min-vh-100 bg-light">
    <aside class="bg-dark text-white p-3" style="width: 16rem">
        <a class="d-block text-white text-decoration-none fs-5 fw-semibold mb-4" href="admin/dashboard">Saigon Retail Admin</a>
        <nav class="nav nav-pills flex-column gap-1">
            <NavLink class="nav-link text-white" href="admin/dashboard">Tổng quan</NavLink>
            <NavLink class="nav-link text-white" href="admin/users">Tài khoản</NavLink>
            <NavLink class="nav-link text-white" href="admin/roles">Vai trò &amp; quyền</NavLink>
            <NavLink class="nav-link text-white" href="admin/audit">Nhật ký kiểm toán</NavLink>
        </nav>
        <button class="btn btn-outline-light w-100 mt-4" @onclick="LogoutAsync">Đăng xuất</button>
    </aside>
    <main class="flex-grow-1">
        <header class="bg-white border-bottom px-4 py-3">
            <AuthorizeView>
                <Authorized Context="authContext">
                    <span class="text-secondary">@authContext.User.FindFirst("full_name")?.Value</span>
                </Authorized>
            </AuthorizeView>
        </header>
        <article class="p-4">@Body</article>
    </main>
</div>

@code {
    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();
        Navigation.NavigateTo("login", true);
    }
}
