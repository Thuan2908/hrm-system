{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "InitializeAuthSupportSchema": false
  },
  "Security": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "AdminLockYears": 10,
    "ActiveSessionTimeoutMinutes": 3,
    "BcryptWorkFactor": 12
  },
  "FileStorage": {
    "BasePath": "",
    "MaxFileSizeBytes": 15728640,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".csv",
      ".png",
      ".jpg",
      ".jpeg",
      ".webp",
      ".gif",
      ".svg",
      ".zip",
      ".rar",
      ".txt"
    ]
  },
  "Jwt": {
    "Issuer": "SaigonRetail.Api",
    "Audience": "SaigonRetail.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OTEL_EXPORTER_OTLP_ENDPOINT": ""
